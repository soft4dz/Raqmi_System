<Window x:Class="RaqmiSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raqmi System"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="1024"
        Background="#F5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="28,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Raqmi System"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="Version serveur-client 1.0 alpha"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Socle"
                               FontWeight="SemiBold"
                               FontSize="18"
                               Margin="0,0,0,16" />
                    <TextBlock Text="Utilisateurs" Margin="0,8" />
                    <TextBlock Text="Unites hotelieres" Margin="0,8" />
                    <TextBlock Text="Recettes journalieres" Margin="0,8" />
                    <TextBlock Text="Tableau de bord" Margin="0,8" />
                    <TextBlock Text="Audit" Margin="0,8" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="28">
                <StackPanel>
                    <TextBlock Text="Nouvelle base technique"
                               FontWeight="SemiBold"
                               FontSize="26"
                               Margin="0,0,0,12" />
                    <TextBlock Text="Ce client WPF servira de point de depart pour les modules prioritaires de Raqmi System."
                               FontSize="16"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24" />
                    <TextBlock Text="Premier objectif : utilisateurs, unites, recettes journalieres et dashboard direction."
                               FontSize="16"
                               Foreground="#0F172A"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="RaqmiSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RaqmiSystem.Desktop.Views"
        Title="Raqmi System"
        Icon="Assets/RaqmiSystem.ico"
        Height="760"
        Width="1240"
        MinHeight="680"
        MinWidth="1100"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <!-- ============================ Raccourcis clavier ============================
         Ce produit se tient a la journee sur des ecrans de saisie : une reception, une
         comptabilite, un economat. Les touches ci-dessous evitent d'aller chercher a la
         souris des boutons qu'on actionne des dizaines de fois par jour. F1 les liste.

         Les commandes sont declarees ici, au niveau de la fenetre, et non dans chaque
         vue : les quatre raccourcis d'ecran sont resolus a l'execution par
         ShortcutRouter, qui trouve dans le module affiche le bouton correspondant.
         Aucune des 24 vues n'a eu a etre modifiee, et une vue future en herite sans
         rien declarer, du moment qu'elle suit la convention de nommage de la charte.

         Ctrl+Tab n'est volontairement pas pris : il appartient aux sous-onglets des
         vues qui en ont. Le changement de module passe par Ctrl+Page haut/bas.       -->
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="NavigationCommands.Search" />
        <KeyBinding Key="Home" Modifiers="Alt" Command="NavigationCommands.BrowseHome" />
        <KeyBinding Key="PageDown" Modifiers="Control" Command="NavigationCommands.NextPage" />
        <KeyBinding Key="PageUp" Modifiers="Control" Command="NavigationCommands.PreviousPage" />
        <KeyBinding Key="F5" Command="NavigationCommands.Refresh" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="F1" Command="ApplicationCommands.Help" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="NavigationCommands.Search" Executed="GoToModuleShortcut_Executed" />
        <CommandBinding Command="NavigationCommands.BrowseHome" Executed="GoHomeShortcut_Executed" />
        <CommandBinding Command="NavigationCommands.NextPage" Executed="NextModuleShortcut_Executed" />
        <CommandBinding Command="NavigationCommands.PreviousPage" Executed="PreviousModuleShortcut_Executed" />
        <CommandBinding Command="NavigationCommands.Refresh" Executed="RefreshShortcut_Executed" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindShortcut_Executed" />
        <CommandBinding Command="ApplicationCommands.New" Executed="NewShortcut_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveShortcut_Executed" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="ShortcutHelpShortcut_Executed" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Convertisseur partage (declare dans ClosingView.xaml.cs) : tout horodatage
             UTC renvoye par l'API est affiche en heure du poste (charte, regle 3.8). -->
        <views:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter" />

        <!-- Masquage des sections de modules sans resultat de recherche. -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Gabarit d'une section de la barre laterale (ModuleNavigationGroup).
             Declare ici et non dans le theme : ses boutons appellent un handler de
             cette fenetre, qu'un dictionnaire de ressources sans code-behind ne peut
             pas nommer. Partage par la liste defilante et par la section epinglee en
             pied de panneau, pour qu'elles ne divergent jamais. -->
        <DataTemplate x:Key="SidebarGroupTemplate">
            <!-- Une section sans resultat de recherche disparait entierement plutot
                 que de laisser un en-tete vide. -->
            <Expander Style="{StaticResource ModuleNavGroup}"
                      Header="{Binding}"
                      HeaderTemplate="{StaticResource ModuleNavGroupHeaderTemplate}"
                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Visibility="{Binding HasMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding VisibleModules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Meme handler que les cartes de l'accueil : un seul
                                 chemin de navigation, jamais desynchronise. -->
                            <Button Style="{StaticResource ModuleNavSubButton}"
                                    Tag="{Binding NavTag}"
                                    IsEnabled="{Binding IsClickable}"
                                    ToolTip="{Binding ToolTipText}"
                                    Click="ModuleTileNavigate_Click">
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== En-tete ============================== -->
        <Border Grid.Row="0" Background="{StaticResource StructureBrush}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/symbol-white-1024.png"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"
                           Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Raqmi System"
                                   Foreground="{StaticResource HeaderForegroundBrush}"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Un système. Toute votre entreprise."
                                   Foreground="{StaticResource HeaderMutedBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Visible uniquement une fois connecté : identité + déconnexion. -->
                <StackPanel x:Name="HeaderSessionPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0" />
                    <TextBlock x:Name="CurrentUserTextBlock"
                               Text="Non connecté"
                               Foreground="{StaticResource HeaderForegroundBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <!-- Bascule jour/nuit. Dans l'en-tete et non dans le parametrage :
                         c'est un geste d'ambiance, lie a l'heure et a l'eclairage du
                         lieu, pas un reglage qu'on va chercher une fois pour toutes.
                         L'icone montre la DESTINATION, pas l'etat courant : une lune
                         veut dire « passer en sombre ». -->
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource HeaderIconButton}"
                            Margin="0,0,10,0"
                            Click="ThemeToggleButton_Click">
                        <Grid>
                            <!-- Lune : deux cercles, celui du dessus evide le premier. -->
                            <Path x:Name="ThemeToggleMoonIcon"
                                  Width="16"
                                  Height="16"
                                  Stretch="None"
                                  Data="M13.2,9.9 A6,6 0 1 1 7.1,2.8 A4.8,4.8 0 0 0 13.2,9.9 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                            <!-- Soleil : un disque et huit rayons. -->
                            <Path x:Name="ThemeToggleSunIcon"
                                  Width="16"
                                  Height="16"
                                  Stretch="None"
                                  Visibility="Collapsed"
                                  Data="M8,5.2 A2.8,2.8 0 1 0 8.01,5.2 M8,1.3 V2.7 M8,13.3 V14.7 M1.3,8 H2.7 M13.3,8 H14.7 M3.3,3.3 L4.3,4.3 M11.7,11.7 L12.7,12.7 M12.7,3.3 L11.7,4.3 M4.3,11.7 L3.3,12.7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="ChangePasswordButton"
                            Content="Changer mon mot de passe"
                            Style="{StaticResource HeaderGhostButton}"
                            ToolTip="Choisir un nouveau mot de passe pour ce compte. Toutes les autres sessions ouvertes seront fermées."
                            Margin="0,0,10,0"
                            Click="ChangePasswordButton_Click" />
                    <Button x:Name="LogoutButton"
                            Content="Déconnexion"
                            Style="{StaticResource HeaderGhostButton}"
                            ToolTip="Fermer la session en cours"
                            Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- ====================== Écran de connexion ====================== -->
            <!-- Plein écran sur fond structure, filigrane de marque, carte élevée
                 avec animation d'apparition. Le code-behind bascule la visibilité
                 de LoginCardBorder (l'ensemble de la scène) et de MainContentGrid. -->
            <Border x:Name="LoginCardBorder"
                    Background="{StaticResource LoginBackdropBrush}">
                <Grid>
                    <!-- Filigrane : symbole Q/ق de la marque -->
                    <Image Source="Assets/symbol-white-1024.png"
                           Width="520"
                           Height="520"
                           Stretch="Uniform"
                           Opacity="0.05"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,-110,-130" />
                    <Image Source="Assets/symbol-white-1024.png"
                           Width="220"
                           Height="220"
                           Stretch="Uniform"
                           Opacity="0.04"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="-60,-50,0,0" />

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="36,32"
                            Width="392"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource StructureShadowColor}" Direction="270" ShadowDepth="10" BlurRadius="40" Opacity="0.35" />
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Apparition discrète (fondu + glissement) à chaque
                                         retour sur l'écran de connexion. -->
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="22"
                                                                     To="0"
                                                                     Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <Image Source="Assets/symbol-color-1024.png"
                                   Width="44"
                                   Height="44"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,20" />

                            <!-- Titre de la carte : taille de l'echelle typographique du theme
                                 (PageTitleText), seule la couleur de marque est surchargee. -->
                            <TextBlock Text="Connexion"
                                       Style="{StaticResource PageTitleText}"
                                       Foreground="{StaticResource StructureBrush}" />
                            <TextBlock Text="Accédez à votre espace Raqmi System"
                                       Style="{StaticResource SubtitleText}"
                                       Margin="0,4,0,26" />

                            <TextBlock Text="Utilisateur" Style="{StaticResource LabelText}" />
                            <TextBox x:Name="UserNameTextBox"
                                     TabIndex="0"
                                     Tag="Nom d'utilisateur"
                                     Margin="0,0,0,16" />

                            <TextBlock Text="Mot de passe" Style="{StaticResource LabelText}" />
                            <PasswordBox x:Name="PasswordBox"
                                         TabIndex="1"
                                         Margin="0,0,0,14" />

                            <!-- Le mot de passe mémorisé est chiffré via DPAPI Windows
                                 (session utilisateur), jamais stocké en clair. -->
                            <CheckBox x:Name="RememberMeCheckBox"
                                      Content="Mémoriser mes identifiants"
                                      TabIndex="2"
                                      Margin="0,0,0,20"
                                      ToolTip="Pré-remplit l'utilisateur et le mot de passe au prochain démarrage sur ce poste (stockage chiffré, lié à votre session Windows)" />

                            <!-- IsDefault : la touche Entrée déclenche la connexion. -->
                            <Button x:Name="LoginButton"
                                    Content="Se connecter"
                                    Style="{StaticResource PrimaryButton}"
                                    IsDefault="True"
                                    TabIndex="3"
                                    ToolTip="Ouvrir la session (Entrée)"
                                    Click="LoginButton_Click" />

                            <ProgressBar x:Name="LoginBusyProgressBar"
                                         Height="3"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"
                                         Margin="0,16,0,0" />

                            <!-- Message d'état / d'erreur stylisé (Tag piloté par le
                                 code-behind : "Error" ou "Info"). -->
                            <Border x:Name="LoginStatusBorder"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Padding="12,9"
                                    Margin="0,14,0,0"
                                    Visibility="Collapsed">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             VerticalAlignment="Top"
                                             Margin="0,5,9,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                 Value="Error">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock x:Name="LoginStatusTextBlock"
                                               Grid.Column="1"
                                               Text=""
                                               FontSize="12.5"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                 Value="Error">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,26,0,16" />

                            <TextBlock Text="URL de l'API"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="ApiBaseUrlTextBox"
                                     TabIndex="4"
                                     FontSize="11"
                                     MinHeight="30"
                                     Padding="8,0"
                                     Tag="https://serveur:port"
                                     ToolTip="Adresse du serveur Raqmi System" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===================== Application connectée ===================== -->
            <Grid x:Name="MainContentGrid" Margin="24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Largeurs pilotees par SyncSidebarToTab : sur l'accueil, la barre
                         laterale est repliee a zero et l'ecran est plein - le sommaire
                         des modules EST l'accueil, une barre laterale y ferait doublon
                         et volerait la largeur des cartes. -->
                    <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                    <ColumnDefinition x:Name="SidebarGapColumn" Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========================= Panneau latéral ========================= -->
                <!-- Navigation des modules : retour a l'accueil, recherche, les sections
                     de travail dans l'ordre de la journee, et le parametrage epingle en
                     pied de panneau. Le contenu vient de SidebarLayout + ModuleCatalog
                     (ModuleNavigationGroup) : aucun bouton de module n'est ecrit en dur
                     ici, et les libelles sont ceux des cartes de l'accueil, donc un seul
                     vocabulaire dans toute l'application. -->
                <Border x:Name="SidebarBorder" Style="{StaticResource CardBorder}" Padding="14,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Modules"
                                       Style="{StaticResource MetricLabelText}"
                                       Margin="14,0,0,10" />

                            <Button x:Name="ShowHomeButton"
                                    Style="{StaticResource ModuleNavButton}"
                                    ToolTip="Vue d'ensemble des modules"
                                    Click="ShowHomeButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16"
                                          Height="16"
                                          Stretch="None"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M2,8.2 L8,2.5 L14,8.2 M3.8,7 V14 H6.8 V10.2 H9.2 V14 H12.2 V7"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Text="Accueil" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Recherche : filtre les modules sur leur nom, leur
                                 description, leur famille et leur numero d'ordre, sans
                                 accent ni casse. Echap efface la saisie. -->
                            <Grid Margin="0,12,0,0">
                                <TextBox x:Name="ModuleSearchTextBox"
                                         Tag="Rechercher un module…"
                                         MinHeight="34"
                                         Padding="32,0,32,0"
                                         TextChanged="ModuleSearchTextBox_TextChanged"
                                         PreviewKeyDown="ModuleSearchTextBox_PreviewKeyDown" />
                                <Path Width="16"
                                      Height="16"
                                      Stretch="None"
                                      Data="M6.5,2.6 A3.9,3.9 0 1 0 6.51,2.6 M9.3,9.3 L13.4,13.4"
                                      Stroke="{StaticResource TextPlaceholderBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="10,0,0,0"
                                      IsHitTestVisible="False" />
                                <Button x:Name="ClearModuleSearchButton"
                                        Style="{StaticResource SearchClearButton}"
                                        Visibility="Collapsed"
                                        ToolTip="Effacer la recherche"
                                        Click="ClearModuleSearchButton_Click" />
                            </Grid>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,14,0,0"
                                      Padding="0,0,4,0">
                            <StackPanel>
                                <ItemsControl x:Name="SidebarGroupsItemsControl"
                                              ItemTemplate="{StaticResource SidebarGroupTemplate}" />

                                <!-- La barre laterale ne liste que les ecrans ouvrables :
                                     le message renvoie au catalogue complet plutot que de
                                     laisser croire que le module n'existe pas. -->
                                <TextBlock x:Name="SidebarSearchEmptyTextBlock"
                                           Text="Aucun écran ne correspond. L'accueil liste les 49 modules du catalogue."
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="10,8,6,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Parametrage epingle en pied, separe des sections de travail :
                             on l'ouvre rarement et jamais dans le flux de la journee, mais
                             il doit rester atteignable en un clic depuis n'importe quel
                             ecran, sans faire defiler la navigation. -->
                        <StackPanel x:Name="SidebarPinnedPanel"
                                    Grid.Row="2"
                                    Margin="0,10,4,0">
                            <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,0,0,8" />
                            <ItemsControl x:Name="SidebarPinnedGroupsItemsControl"
                                          ItemTemplate="{StaticResource SidebarGroupTemplate}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenu des modules -->
                <TabControl x:Name="MainTabs"
                            Grid.Column="2"
                            SelectionChanged="MainTabs_SelectionChanged">

                    <!-- =========================== Accueil =========================== -->
                    <!-- Carte d'avancement des 49 modules de l'ERP : bandeau de
                         progression, filtres, puis les modules regroupes par famille.
                         Le contenu vient de ModuleCatalog (data-driven) : un seul
                         gabarit de carte, aucune carte ecrite en dur. Les cartes dont
                         un ecran existe naviguent par NavigateToModule, exactement
                         comme les boutons de la barre laterale. -->
                    <TabItem Header="Accueil">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,6,0">
                            <StackPanel Margin="6,4,0,0">

                                <!-- ========================= En-tete ========================= -->
                                <StackPanel Style="{StaticResource HomeRevealStyle}">
                                    <TextBlock x:Name="HomeGreetingTextBlock"
                                               Text="Bonjour"
                                               Style="{StaticResource HomeGreetingText}" />
                                    <TextBlock x:Name="HomeDateTextBlock"
                                               Text=""
                                               Style="{StaticResource HomeDateText}"
                                               Margin="0,7,0,2" />
                                    <TextBlock Text="Voici ce qui demande votre attention aujourd’hui."
                                               Style="{StaticResource SubtitleText}" />
                                </StackPanel>

                                <!-- ==================== Espace de travail personnel ==================== -->
                                <StackPanel Style="{StaticResource HomeRevealDelayedStyle}"
                                            Margin="0,24,0,0">
                                    <UniformGrid Columns="4">
                                        <Button Style="{StaticResource HomeSummaryCard}"
                                                Tag="16"
                                                IsEnabled="{Binding IsEnabled, ElementName=ApprovalsTabItem}"
                                                Click="HomeNavigate_Click">
                                            <StackPanel>
                                                <TextBlock Text="Validations" Style="{StaticResource HomeSummaryLabel}" />
                                                <TextBlock Text="À consulter" Style="{StaticResource HomeSummaryValue}" />
                                                <TextBlock Text="Ouvrir ma file" Style="{StaticResource HomeSummaryHint}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeSummaryCard}"
                                                Tag="20"
                                                IsEnabled="{Binding IsEnabled, ElementName=DecCockpitTabItem}"
                                                Click="HomeNavigate_Click">
                                            <StackPanel>
                                                <TextBlock Text="Tâches urgentes" Style="{StaticResource HomeSummaryLabel}" />
                                                <TextBlock Text="À contrôler" Style="{StaticResource HomeSummaryValue}" />
                                                <TextBlock Text="Voir le cockpit" Style="{StaticResource HomeSummaryHint}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeSummaryCard}"
                                                Tag="29"
                                                IsEnabled="{Binding IsEnabled, ElementName=KpiTabItem}"
                                                Click="HomeNavigate_Click">
                                            <StackPanel>
                                                <TextBlock Text="Alertes" Style="{StaticResource HomeSummaryLabel}" />
                                                <TextBlock Text="KPI &amp; écarts" Style="{StaticResource HomeSummaryValue}" />
                                                <TextBlock Text="Analyser les signaux" Style="{StaticResource HomeSummaryHint}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeSummaryCard}"
                                                Tag="5"
                                                IsEnabled="{Binding IsEnabled, ElementName=ClosingTabItem}"
                                                Click="HomeNavigate_Click">
                                            <StackPanel>
                                                <TextBlock Text="Échéances" Style="{StaticResource HomeSummaryLabel}" />
                                                <TextBlock Text="Clôture du jour" Style="{StaticResource HomeSummaryValue}" />
                                                <TextBlock Text="Contrôler la journée" Style="{StaticResource HomeSummaryHint}" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource CardBorder}" Padding="20,18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,14">
                                                    <Button Content="Voir tout"
                                                            DockPanel.Dock="Right"
                                                            Style="{StaticResource HomeTextActionButton}"
                                                            Tag="16"
                                                            IsEnabled="{Binding IsEnabled, ElementName=ApprovalsTabItem}"
                                                            Click="HomeNavigate_Click" />
                                                    <TextBlock Text="À traiter aujourd’hui"
                                                               Style="{StaticResource SectionTitleText}" />
                                                </DockPanel>
                                                <Border Style="{StaticResource HomeWorkItem}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Validations en attente" Style="{StaticResource HomeWorkItemTitle}" />
                                                            <TextBlock Text="Factures, achats et décisions selon vos droits" Style="{StaticResource HomeWorkItemDetail}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Ouvrir" Style="{StaticResource SecondaryButton}"
                                                                Tag="16" IsEnabled="{Binding IsEnabled, ElementName=ApprovalsTabItem}"
                                                                Click="HomeNavigate_Click" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource HomeWorkItem}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Contrôles d’exploitation" Style="{StaticResource HomeWorkItemTitle}" />
                                                            <TextBlock Text="Recettes, clôture, trésorerie et anomalies" Style="{StaticResource HomeWorkItemDetail}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Contrôler" Style="{StaticResource SecondaryButton}"
                                                                Tag="20" IsEnabled="{Binding IsEnabled, ElementName=DecCockpitTabItem}"
                                                                Click="HomeNavigate_Click" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource HomeWorkItem}" Margin="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Arrivées et départs" Style="{StaticResource HomeWorkItemTitle}" />
                                                            <TextBlock Text="Accéder aux opérations PMS de la journée" Style="{StaticResource HomeWorkItemDetail}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Voir" Style="{StaticResource SecondaryButton}"
                                                                Tag="30" IsEnabled="{Binding IsEnabled, ElementName=PmsTabItem}"
                                                                Click="HomeNavigate_Click" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,16">
                                                    <Button Content="Ouvrir le pilotage"
                                                            DockPanel.Dock="Right"
                                                            Style="{StaticResource HomeTextActionButton}"
                                                            Tag="19"
                                                            IsEnabled="{Binding IsEnabled, ElementName=GroupDashboardTabItem}"
                                                            Click="HomeNavigate_Click" />
                                                    <TextBlock Text="Pilotage de mon unité" Style="{StaticResource SectionTitleText}" />
                                                </DockPanel>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="CA du jour" Style="{StaticResource HomeSummaryLabel}" />
                                                        <TextBlock Text="—" Style="{StaticResource HomeKpiValue}" />
                                                        <TextBlock Text="Donnée au chargement" Style="{StaticResource HomeSummaryHint}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Occupation" Style="{StaticResource HomeSummaryLabel}" />
                                                        <TextBlock Text="—" Style="{StaticResource HomeKpiValue}" />
                                                        <TextBlock Text="Donnée au chargement" Style="{StaticResource HomeSummaryHint}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="RevPAR" Style="{StaticResource HomeSummaryLabel}" />
                                                        <TextBlock Text="—" Style="{StaticResource HomeKpiValue}" />
                                                        <TextBlock Text="Donnée au chargement" Style="{StaticResource HomeSummaryHint}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <Border Background="{StaticResource SurfaceSubtleBrush}"
                                                        CornerRadius="8" Height="108" Margin="0,22,0,0">
                                                    <Grid>
                                                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                              Stretch="Fill" Margin="22,28"
                                                              Data="M0,55 C45,52 70,66 108,46 C150,25 184,39 222,35 C267,30 301,48 350,19" />
                                                        <TextBlock Text="Tendance disponible dans le tableau de bord"
                                                                   Style="{StaticResource HomeSummaryHint}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardBorder}" Padding="20,18" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Mes actions rapides" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14" />
                                            <UniformGrid Columns="6">
                                                <Button Content="Nouvelle réservation" Style="{StaticResource HomeQuickActionButton}" Tag="30" IsEnabled="{Binding IsEnabled, ElementName=PmsTabItem}" Click="HomeNavigate_Click" />
                                                <Button Content="Check-in" Style="{StaticResource HomeQuickActionButton}" Tag="30" IsEnabled="{Binding IsEnabled, ElementName=PmsTabItem}" Click="HomeNavigate_Click" />
                                                <Button Content="Saisir le CA" Style="{StaticResource HomeQuickActionButton}" Tag="2" IsEnabled="{Binding IsEnabled, ElementName=RevenueTabItem}" Click="HomeNavigate_Click" />
                                                <Button Content="Créer une facture" Style="{StaticResource HomeQuickActionButton}" Tag="8" IsEnabled="{Binding IsEnabled, ElementName=InvoicesTabItem}" Click="HomeNavigate_Click" />
                                                <Button Content="Demande d’achat" Style="{StaticResource HomeQuickActionButton}" Tag="25" IsEnabled="{Binding IsEnabled, ElementName=PurchasingTabItem}" Click="HomeNavigate_Click" />
                                                <Button Content="Signaler un incident" Style="{StaticResource HomeQuickActionButton}" Tag="4" IsEnabled="{Binding IsEnabled, ElementName=AuditTabItem}" Click="HomeNavigate_Click" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ============== Bandeau d'avancement + filtres ============== -->
                                <Expander Style="{StaticResource HomeCatalogExpander}"
                                          Header="Catalogue des applications"
                                          IsExpanded="False"
                                          Margin="0,18,0,0">
                                <StackPanel>
                                <StackPanel
                                            Margin="0,26,0,0">

                                    <Border Style="{StaticResource CardBorder}" Padding="22,18">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Avancement des modules"
                                                           Style="{StaticResource HomeSectionLabel}"
                                                           Margin="0" />
                                                <TextBlock x:Name="ModuleProgressHeadlineTextBlock"
                                                           Style="{StaticResource HomeProgressHeadlineText}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>

                                            <!-- Compteurs par statut -->
                                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                                <StackPanel Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource HomeStatDot}"
                                                                 Fill="{StaticResource ModuleProgressAvailableBrush}" />
                                                        <TextBlock Text="Disponible"
                                                                   Style="{StaticResource HomeStatLabelText}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="ModuleCountAvailableTextBlock"
                                                               Text="0"
                                                               Style="{StaticResource HomeStatValueText}" />
                                                </StackPanel>

                                                <StackPanel Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource HomeStatDot}"
                                                                 Fill="{StaticResource ModuleProgressApiBrush}" />
                                                        <TextBlock Text="API prête"
                                                                   Style="{StaticResource HomeStatLabelText}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="ModuleCountApiTextBlock"
                                                               Text="0"
                                                               Style="{StaticResource HomeStatValueText}" />
                                                </StackPanel>

                                                <StackPanel Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource HomeStatDot}"
                                                                 Fill="{StaticResource ModuleProgressPartialBrush}" />
                                                        <TextBlock Text="Partiel"
                                                                   Style="{StaticResource HomeStatLabelText}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="ModuleCountPartialTextBlock"
                                                               Text="0"
                                                               Style="{StaticResource HomeStatValueText}" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource HomeStatDot}"
                                                                 Fill="{StaticResource ModuleProgressPlannedBrush}" />
                                                        <TextBlock Text="Planifié"
                                                                   Style="{StaticResource HomeStatLabelText}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="ModuleCountPlannedTextBlock"
                                                               Text="0"
                                                               Style="{StaticResource HomeStatValueText}" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <!-- Barre segmentee : une portion par statut, largeurs
                                                 proportionnelles fixees par le code-behind. -->
                                            <Grid Margin="0,20,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="ModuleProgressAvailableColumn" Width="*" />
                                                    <ColumnDefinition x:Name="ModuleProgressApiColumn" Width="*" />
                                                    <ColumnDefinition x:Name="ModuleProgressPartialColumn" Width="*" />
                                                    <ColumnDefinition x:Name="ModuleProgressPlannedColumn" Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource HomeProgressSegment}"
                                                        Background="{StaticResource ModuleProgressAvailableBrush}" />
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource HomeProgressSegment}"
                                                        Background="{StaticResource ModuleProgressApiBrush}" />
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource HomeProgressSegment}"
                                                        Background="{StaticResource ModuleProgressPartialBrush}" />
                                                <Border Grid.Column="3"
                                                        Style="{StaticResource HomeProgressSegment}"
                                                        Background="{StaticResource ModuleProgressPlannedBrush}"
                                                        Margin="0" />
                                            </Grid>

                                            <TextBlock x:Name="ModuleProgressCaptionTextBlock"
                                                       Text=""
                                                       Style="{StaticResource HomeProgressCaptionText}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Recherche du catalogue. Meme moteur que la barre
                                         laterale (ModuleTile.SearchText, sans accent ni
                                         casse) : ce qu'une surface trouve, l'autre le
                                         trouve. Elle se croise avec les puces de statut
                                         et de priorite plutot que de les remplacer.
                                         Ctrl+K y amene le focus depuis l'accueil, ou la
                                         barre laterale est repliee par design. -->
                                    <Grid Margin="0,20,0,0" MaxWidth="420" HorizontalAlignment="Left">
                                        <TextBox x:Name="HomeSearchTextBox"
                                                 Tag="Rechercher un module…  (Ctrl+K)"
                                                 MinHeight="36"
                                                 Padding="34,0,34,0"
                                                 Width="420"
                                                 ToolTip="Filtrer les 49 modules sur leur nom, leur description ou leur famille"
                                                 TextChanged="HomeSearchTextBox_TextChanged"
                                                 PreviewKeyDown="HomeSearchTextBox_PreviewKeyDown" />
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="None"
                                              Data="M6.5,2.6 A3.9,3.9 0 1 0 6.51,2.6 M9.3,9.3 L13.4,13.4"
                                              Stroke="{StaticResource TextPlaceholderBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="11,0,0,0"
                                              IsHitTestVisible="False" />
                                        <Button x:Name="ClearHomeSearchButton"
                                                Style="{StaticResource SearchClearButton}"
                                                Visibility="Collapsed"
                                                ToolTip="Effacer la recherche (Échap)"
                                                Click="ClearHomeSearchButton_Click" />
                                    </Grid>

                                    <!-- Filtres : statut, puis priorite -->
                                    <WrapPanel Margin="0,12,0,0">
                                        <RadioButton x:Name="ModuleFilterAllChip"
                                                     Style="{StaticResource FilterChip}"
                                                     GroupName="ModuleStatusFilter"
                                                     Content="Tous"
                                                     Tag=""
                                                     IsChecked="True"
                                                     ToolTip="Afficher les 49 modules"
                                                     Checked="ModuleStatusFilterChip_Checked" />
                                        <RadioButton x:Name="ModuleFilterAvailableChip"
                                                     Style="{StaticResource FilterChip}"
                                                     GroupName="ModuleStatusFilter"
                                                     Content="Disponibles"
                                                     Tag="Disponible"
                                                     ToolTip="Écrans utilisables dès maintenant"
                                                     Checked="ModuleStatusFilterChip_Checked" />
                                        <RadioButton x:Name="ModuleFilterApiChip"
                                                     Style="{StaticResource FilterChip}"
                                                     GroupName="ModuleStatusFilter"
                                                     Content="API prête"
                                                     Tag="ApiPrete"
                                                     ToolTip="Backend livré et testé, écran client à venir"
                                                     Checked="ModuleStatusFilterChip_Checked" />
                                        <RadioButton x:Name="ModuleFilterPartialChip"
                                                     Style="{StaticResource FilterChip}"
                                                     GroupName="ModuleStatusFilter"
                                                     Content="Partiels"
                                                     Tag="Partiel"
                                                     ToolTip="Partiellement couverts par l'existant"
                                                     Checked="ModuleStatusFilterChip_Checked" />
                                        <RadioButton x:Name="ModuleFilterPlannedChip"
                                                     Style="{StaticResource FilterChip}"
                                                     GroupName="ModuleStatusFilter"
                                                     Content="Planifiés"
                                                     Tag="Planifie"
                                                     ToolTip="Pas encore développés"
                                                     Checked="ModuleStatusFilterChip_Checked" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="Priorité"
                                                   Style="{StaticResource FilterRowLabelText}" />
                                        <RadioButton x:Name="ModulePriorityAllChip"
                                                     Style="{StaticResource FilterChipCompact}"
                                                     GroupName="ModulePriorityFilter"
                                                     Content="Toutes"
                                                     Tag=""
                                                     IsChecked="True"
                                                     Checked="ModulePriorityFilterChip_Checked" />
                                        <RadioButton x:Name="ModulePriorityP0Chip"
                                                     Style="{StaticResource FilterChipCompact}"
                                                     GroupName="ModulePriorityFilter"
                                                     Content="P0"
                                                     Tag="P0"
                                                     ToolTip="Socle et pilote"
                                                     Checked="ModulePriorityFilterChip_Checked" />
                                        <RadioButton x:Name="ModulePriorityP1Chip"
                                                     Style="{StaticResource FilterChipCompact}"
                                                     GroupName="ModulePriorityFilter"
                                                     Content="P1"
                                                     Tag="P1"
                                                     ToolTip="Cœur de l'ERP"
                                                     Checked="ModulePriorityFilterChip_Checked" />
                                        <RadioButton x:Name="ModulePriorityP2Chip"
                                                     Style="{StaticResource FilterChipCompact}"
                                                     GroupName="ModulePriorityFilter"
                                                     Content="P2"
                                                     Tag="P2"
                                                     ToolTip="Extensions"
                                                     Checked="ModulePriorityFilterChip_Checked" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- ================= Modules groupes par famille ================= -->
                                <StackPanel Style="{StaticResource HomeRevealDelayedMoreStyle}"
                                            Margin="0,6,0,0">
                                    <ItemsControl x:Name="ModuleCatalogItemsControl">
                                        <!-- ItemsPanel : disposition des cartes A L'INTERIEUR d'un
                                             groupe (grille fluide). GroupStyle.Panel : disposition
                                             des sections elles-memes (les unes sous les autres). -->
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <!-- Gabarit unique : toute la mise en forme de la carte
                                                 vit dans le style ModuleCatalogCard du theme. -->
                                            <DataTemplate>
                                                <Button Style="{StaticResource ModuleCatalogCard}"
                                                        IsEnabled="{Binding IsClickable}"
                                                        ToolTip="{Binding ToolTipText}"
                                                        Click="ModuleTileNavigate_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle HeaderTemplate="{StaticResource ModuleCatalogGroupHeaderTemplate}">
                                                <GroupStyle.Panel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </GroupStyle.Panel>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>

                                    <TextBlock x:Name="ModuleCatalogEmptyTextBlock"
                                               Text="Aucun module ne correspond à ce filtre."
                                               Style="{StaticResource ModuleCatalogEmptyText}"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ====================== Unités hôtelières ====================== -->
                    <TabItem x:Name="UnitsTabItem" Header="Unités hôtelières">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Liste des unités"
                                                   Style="{StaticResource PageTitleText}" />
                                        <TextBlock Text="Référentiel des hôtels et unités d'exploitation"
                                                   Style="{StaticResource SubtitleText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <CheckBox x:Name="IncludeInactiveCheckBox"
                                                  Content="Inclure inactives"
                                                  ToolTip="Afficher aussi les unités désactivées"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0" />
                                        <Button x:Name="RefreshUnitsButton"
                                                Content="Actualiser"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Recharger la liste des unités"
                                                Click="RefreshUnitsButton_Click" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="UnitFormTitleTextBlock"
                                                   Text="Nouvelle unité"
                                                   Style="{StaticResource SectionTitleText}"
                                                   FontSize="14"
                                                   Margin="0,0,0,4" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Code" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="UnitCodeTextBox" MaxLength="40" Tag="ex. HTL-01" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Nom" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="UnitNameTextBox" MaxLength="160" Tag="Nom de l'unité" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Type" Style="{StaticResource LabelText}" />
                                                <ComboBox x:Name="UnitTypeComboBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Ordre" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="UnitDisplayOrderTextBox"
                                                         Text="0"
                                                         Style="{StaticResource AmountTextBox}" />
                                            </StackPanel>

                                            <Button x:Name="NewUnitButton"
                                                    Grid.Column="8"
                                                    Content="Nouveau"
                                                    Style="{StaticResource GhostButton}"
                                                    ToolTip="Vider le formulaire pour créer une nouvelle unité"
                                                    VerticalAlignment="Bottom"
                                                    Click="NewUnitButton_Click" />

                                            <Button x:Name="SaveUnitButton"
                                                    Grid.Column="10"
                                                    Content="Créer"
                                                    Style="{StaticResource PrimaryButton}"
                                                    ToolTip="Enregistrer l'unité"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    VerticalAlignment="Bottom"
                                                    Click="SaveUnitButton_Click" />

                                            <Button x:Name="ActivateUnitButton"
                                                    Grid.Column="12"
                                                    Content="Activer"
                                                    Style="{StaticResource SecondaryButton}"
                                                    ToolTip="Réactiver l'unité sélectionnée"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    VerticalAlignment="Bottom"
                                                    Click="ActivateUnitButton_Click" />

                                            <Button x:Name="DeactivateUnitButton"
                                                    Grid.Column="14"
                                                    Content="Désactiver"
                                                    Style="{StaticResource DangerButton}"
                                                    ToolTip="Désactiver l'unité sélectionnée"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    VerticalAlignment="Bottom"
                                                    Click="DeactivateUnitButton_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="4">
                                    <DataGrid x:Name="UnitsDataGrid"
                                              SelectionChanged="UnitsDataGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130" />
                                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding UnitType}" Width="120" />
                                            <DataGridTextColumn Header="Ordre"
                                                                Binding="{Binding DisplayOrder}"
                                                                Width="75"
                                                                ElementStyle="{StaticResource AmountCellText}"
                                                                HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                            <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="70" />
                                            <DataGridTextColumn Header="Mis à jour par"
                                                                Binding="{Binding UpdatedBy}"
                                                                Width="150"
                                                                ElementStyle="{StaticResource MutedCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=UnitsDataGrid}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Path Data="M2,9 L4,3 H12 L14,9 V13 H2 Z M2,9 H6 C6,10.6 6.9,11.4 8,11.4 C9.1,11.4 10,10.6 10,9 H14"
                                              Stroke="{StaticResource BorderStrongBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              Width="46"
                                              Height="42"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,10" />
                                        <TextBlock Text="Aucune unité à afficher"
                                                   Style="{StaticResource EmptyStateTitleText}" />
                                        <TextBlock Text="Créez une première unité ou cliquez sur Actualiser."
                                                   Style="{StaticResource EmptyStateHintText}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ==================== Recettes journalières ==================== -->
                    <TabItem x:Name="RevenueTabItem" Header="Recettes journalières">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="Saisie recette journalière"
                                                       Style="{StaticResource PageTitleText}" />
                                            <TextBlock Text="Création en brouillon, avec option de soumission immédiate au contrôle"
                                                       Style="{StaticResource SubtitleText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="ExportRevenueCsvButton"
                                                    Content="Exporter CSV"
                                                    Style="{StaticResource SecondaryButton}"
                                                    ToolTip="Exporter les recettes affichées au format CSV"
                                                    Margin="0,0,10,0"
                                                    Click="ExportRevenueCsvButton_Click" />
                                            <Button x:Name="PrintRevenueButton"
                                                    Content="Imprimer"
                                                    Style="{StaticResource SecondaryButton}"
                                                    ToolTip="Imprimer l'état des recettes de la journée"
                                                    Margin="0,0,10,0"
                                                    Click="PrintRevenueButton_Click" />
                                            <Button x:Name="RefreshRevenueButton"
                                                    Content="Actualiser"
                                                    Style="{StaticResource SecondaryButton}"
                                                    ToolTip="Recharger les recettes de la date sélectionnée"
                                                    Click="RefreshRevenueButton_Click" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Date d'exploitation" Style="{StaticResource LabelText}" />
                                            <DatePicker x:Name="BusinessDatePicker" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Unité hôtelière" Style="{StaticResource LabelText}" />
                                            <ComboBox x:Name="RevenueUnitComboBox"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Code" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Notes" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="NotesTextBox" MaxLength="1000" Tag="Commentaire facultatif" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Hébergement" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="AccommodationTextBox" Style="{StaticResource AmountTextBox}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Restauration" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="FoodTextBox" Style="{StaticResource AmountTextBox}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Boissons" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="BeverageTextBox" Style="{StaticResource AmountTextBox}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Autres" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="OtherTextBox" Style="{StaticResource AmountTextBox}" />
                                        </StackPanel>

                                        <Button x:Name="CreateRevenueButton"
                                                Grid.Column="8"
                                                Content="Créer brouillon"
                                                Style="{StaticResource PrimaryButton}"
                                                ToolTip="Enregistrer la recette en brouillon"
                                                ToolTipService.ShowOnDisabled="True"
                                                VerticalAlignment="Bottom"
                                                Click="CreateRevenueButton_Click" />

                                        <Button x:Name="CreateAndSubmitRevenueButton"
                                                Grid.Column="10"
                                                Content="Créer + soumettre"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Enregistrer puis soumettre immédiatement au contrôle"
                                                ToolTipService.ShowOnDisabled="True"
                                                VerticalAlignment="Bottom"
                                                Click="CreateAndSubmitRevenueButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Recettes de la journée sélectionnée"
                                               Style="{StaticResource SectionTitleText}" />

                                    <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,28,0">
                                                <TextBlock Text="Total" Style="{StaticResource MetricLabelText}" />
                                                <TextBlock x:Name="SummaryTotalTextBlock"
                                                           Text="0.00"
                                                           Style="{StaticResource MetricValueText}" />
                                            </StackPanel>
                                            <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0" Margin="0,2,28,2" />
                                            <StackPanel Margin="0,0,28,0">
                                                <TextBlock Text="Brouillons" Style="{StaticResource MetricLabelText}" />
                                                <TextBlock x:Name="SummaryDraftTextBlock"
                                                           Text="0"
                                                           Style="{StaticResource MetricValueText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,28,0">
                                                <TextBlock Text="Soumises" Style="{StaticResource MetricLabelText}" />
                                                <TextBlock x:Name="SummarySubmittedTextBlock"
                                                           Text="0"
                                                           Style="{StaticResource MetricValueText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,28,0">
                                                <TextBlock Text="Validées" Style="{StaticResource MetricLabelText}" />
                                                <TextBlock x:Name="SummaryValidatedTextBlock"
                                                           Text="0"
                                                           Style="{StaticResource MetricValueText}"
                                                           Foreground="{StaticResource StatusValidatedForegroundBrush}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Rejetées" Style="{StaticResource MetricLabelText}" />
                                                <TextBlock x:Name="SummaryRejectedTextBlock"
                                                           Text="0"
                                                           Style="{StaticResource MetricValueText}"
                                                           Foreground="{StaticResource StatusRejectedForegroundBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Motif de rejet (recette sélectionnée)" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="RejectReasonTextBox" MaxLength="500" Tag="Obligatoire pour rejeter" />
                                        </StackPanel>

                                        <Button x:Name="ValidateRevenueButton"
                                                Grid.Column="2"
                                                Content="Valider"
                                                Style="{StaticResource PrimaryButton}"
                                                ToolTip="Valider la recette sélectionnée"
                                                ToolTipService.ShowOnDisabled="True"
                                                VerticalAlignment="Bottom"
                                                Click="ValidateRevenueButton_Click" />

                                        <Button x:Name="RejectRevenueButton"
                                                Grid.Column="4"
                                                Content="Rejeter"
                                                Style="{StaticResource DangerButton}"
                                                ToolTip="Rejeter la recette sélectionnée (motif requis)"
                                                ToolTipService.ShowOnDisabled="True"
                                                VerticalAlignment="Bottom"
                                                Click="RejectRevenueButton_Click" />
                                    </Grid>

                                    <Grid Grid.Row="6">
                                        <DataGrid x:Name="DailyRevenueDataGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date"
                                                                    Binding="{Binding BusinessDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                                    Width="100" />
                                                <DataGridTextColumn Header="Unité" Binding="{Binding HotelUnitCode}" Width="110" />
                                                <DataGridTextColumn Header="Hébergement"
                                                                    Binding="{Binding Accommodation, StringFormat={}{0:N2}}"
                                                                    Width="115"
                                                                    ElementStyle="{StaticResource AmountCellText}"
                                                                    HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                                <DataGridTextColumn Header="Restauration"
                                                                    Binding="{Binding Food, StringFormat={}{0:N2}}"
                                                                    Width="115"
                                                                    ElementStyle="{StaticResource AmountCellText}"
                                                                    HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                                <DataGridTextColumn Header="Boissons"
                                                                    Binding="{Binding Beverage, StringFormat={}{0:N2}}"
                                                                    Width="105"
                                                                    ElementStyle="{StaticResource AmountCellText}"
                                                                    HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                                <DataGridTextColumn Header="Autres"
                                                                    Binding="{Binding Other, StringFormat={}{0:N2}}"
                                                                    Width="100"
                                                                    ElementStyle="{StaticResource AmountCellText}"
                                                                    HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                                <DataGridTextColumn Header="Total"
                                                                    Binding="{Binding Total, StringFormat={}{0:N2}}"
                                                                    Width="115"
                                                                    ElementStyle="{StaticResource TotalCellText}"
                                                                    HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                                <DataGridTemplateColumn Header="Statut" Width="120" SortMemberPath="Status">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="StatusBadge"
                                                                    CornerRadius="10"
                                                                    Padding="10,3"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="{StaticResource StatusDraftBackgroundBrush}">
                                                                <TextBlock x:Name="StatusBadgeText"
                                                                           Text="Brouillon"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource StatusDraftForegroundBrush}" />
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Submitted">
                                                                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
                                                                    <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
                                                                    <Setter TargetName="StatusBadgeText" Property="Text" Value="Soumise" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Validated">
                                                                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusValidatedBackgroundBrush}" />
                                                                    <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusValidatedForegroundBrush}" />
                                                                    <Setter TargetName="StatusBadgeText" Property="Text" Value="Validée" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusRejectedBackgroundBrush}" />
                                                                    <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusRejectedForegroundBrush}" />
                                                                    <Setter TargetName="StatusBadgeText" Property="Text" Value="Rejetée" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Saisi par"
                                                                    Binding="{Binding CreatedBy}"
                                                                    Width="*"
                                                                    ElementStyle="{StaticResource MutedCellText}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=DailyRevenueDataGrid}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path Data="M2,9 L4,3 H12 L14,9 V13 H2 Z M2,9 H6 C6,10.6 6.9,11.4 8,11.4 C9.1,11.4 10,10.6 10,9 H14"
                                                  Stroke="{StaticResource BorderStrongBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineJoin="Round"
                                                  Width="46"
                                                  Height="42"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,10" />
                                            <TextBlock Text="Aucune recette pour cette date"
                                                       Style="{StaticResource EmptyStateTitleText}" />
                                            <TextBlock Text="Changez la date d'exploitation ou saisissez une première recette ci-dessus."
                                                       Style="{StaticResource EmptyStateHintText}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ======================= Tableau de bord ======================= -->
                    <TabItem x:Name="DashboardTabItem" Header="Tableau de bord">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tableau de bord — recettes par unité"
                                                   Style="{StaticResource PageTitleText}" />
                                        <TextBlock Text="Répartition par unité hôtelière de l'état des recettes journalières pour une date donnée."
                                                   Style="{StaticResource SubtitleText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                        <StackPanel Width="150" Margin="0,0,14,0">
                                            <TextBlock Text="Date d'exploitation" Style="{StaticResource LabelText}" />
                                            <DatePicker x:Name="DashboardDatePicker" />
                                        </StackPanel>

                                        <Button x:Name="RefreshDashboardButton"
                                                Content="Actualiser"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Recharger le tableau de bord"
                                                VerticalAlignment="Bottom"
                                                Click="RefreshDashboardButton_Click" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,28,0">
                                            <TextBlock Text="Unités au total" Style="{StaticResource MetricLabelText}" />
                                            <TextBlock x:Name="DashboardTotalUnitsTextBlock"
                                                       Text="0"
                                                       Style="{StaticResource MetricValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,28,0">
                                            <TextBlock Text="Avec saisie" Style="{StaticResource MetricLabelText}" />
                                            <TextBlock x:Name="DashboardWithEntryTextBlock"
                                                       Text="0"
                                                       Style="{StaticResource MetricValueText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,28,0">
                                            <TextBlock Text="Manquantes" Style="{StaticResource MetricLabelText}" />
                                            <TextBlock x:Name="DashboardMissingTextBlock"
                                                       Text="0"
                                                       Style="{StaticResource MetricValueText}"
                                                       Foreground="{StaticResource StatusRejectedForegroundBrush}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,28,0">
                                            <TextBlock Text="En attente de validation" Style="{StaticResource MetricLabelText}" />
                                            <TextBlock x:Name="DashboardPendingValidationTextBlock"
                                                       Text="0"
                                                       Style="{StaticResource MetricValueText}"
                                                       Foreground="{StaticResource StatusSubmittedForegroundBrush}" />
                                        </StackPanel>
                                        <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0" Margin="0,2,28,2" />
                                        <StackPanel>
                                            <TextBlock Text="Total consolidé" Style="{StaticResource MetricLabelText}" />
                                            <TextBlock x:Name="DashboardGrandTotalTextBlock"
                                                       Text="0.00"
                                                       Style="{StaticResource MetricValueText}"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="4">
                                    <DataGrid x:Name="UnitDashboardDataGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Code" Binding="{Binding HotelUnitCode}" Width="110" />
                                            <DataGridTextColumn Header="Nom" Binding="{Binding HotelUnitName}" Width="*" />
                                            <DataGridTemplateColumn Header="État de saisie" Width="225" SortMemberPath="EntryStatusText">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock x:Name="EntryStatusTextBlock"
                                                                   Text="{Binding EntryStatusText}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                                        </TextBlock>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding EntryStatusText}" Value="Non saisi">
                                                                <Setter TargetName="EntryStatusTextBlock" Property="Foreground" Value="{StaticResource StatusRejectedForegroundBrush}" />
                                                                <Setter TargetName="EntryStatusTextBlock" Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntryStatusText}" Value="Validée">
                                                                <Setter TargetName="EntryStatusTextBlock" Property="Foreground" Value="{StaticResource StatusValidatedForegroundBrush}" />
                                                                <Setter TargetName="EntryStatusTextBlock" Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntryStatusText}" Value="Soumise — en attente de validation">
                                                                <Setter TargetName="EntryStatusTextBlock" Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntryStatusText}" Value="Rejetée">
                                                                <Setter TargetName="EntryStatusTextBlock" Property="Foreground" Value="{StaticResource StatusRejectedForegroundBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Total"
                                                                Binding="{Binding Total, StringFormat={}{0:N2}}"
                                                                Width="120"
                                                                ElementStyle="{StaticResource TotalCellText}"
                                                                HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                            <DataGridTextColumn Header="Soumis le"
                                                                Binding="{Binding SubmittedAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                                Width="145"
                                                                ElementStyle="{StaticResource MutedCellText}" />
                                            <DataGridTextColumn Header="Validé le"
                                                                Binding="{Binding ValidatedAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                                Width="145"
                                                                ElementStyle="{StaticResource MutedCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=UnitDashboardDataGrid}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Path Data="M2,9 L4,3 H12 L14,9 V13 H2 Z M2,9 H6 C6,10.6 6.9,11.4 8,11.4 C9.1,11.4 10,10.6 10,9 H14"
                                              Stroke="{StaticResource BorderStrongBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              Width="46"
                                              Height="42"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,10" />
                                        <TextBlock Text="Aucune donnée pour cette date"
                                                   Style="{StaticResource EmptyStateTitleText}" />
                                        <TextBlock Text="Choisissez une date d'exploitation puis cliquez sur Actualiser."
                                                   Style="{StaticResource EmptyStateHintText}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ======================== Journal d'audit ====================== -->
                    <TabItem x:Name="AuditTabItem" Header="Journal d'audit">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Journal d'audit"
                                                   Style="{StaticResource PageTitleText}" />
                                        <TextBlock Text="Traçabilité des actions, en lecture seule"
                                                   Style="{StaticResource SubtitleText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="ExportAuditCsvButton"
                                                Content="Exporter CSV"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Exporter les entrées affichées au format CSV"
                                                Margin="0,0,10,0"
                                                Click="ExportAuditCsvButton_Click" />
                                        <Button x:Name="RefreshAuditButton"
                                                Content="Actualiser"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Recharger le journal avec les filtres saisis"
                                                Click="RefreshAuditButton_Click" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Du" Style="{StaticResource LabelText}" />
                                        <DatePicker x:Name="AuditFromDatePicker" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Au" Style="{StaticResource LabelText}" />
                                        <DatePicker x:Name="AuditToDatePicker" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Action" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="AuditActionTextBox" MaxLength="160" Tag="Filtrer par action (ex. Login)" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="AuditResultCountTextBlock"
                                           Grid.Row="4"
                                           Text=""
                                           Style="{StaticResource CaptionText}" />

                                <Grid Grid.Row="6">
                                    <DataGrid x:Name="AuditDataGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Date/heure"
                                                                Binding="{Binding OccurredAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                                                Width="155" />
                                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding UserName}" Width="140" />
                                            <DataGridTemplateColumn Header="Action" Width="170" SortMemberPath="Action">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceSubtleBrush}"
                                                                CornerRadius="9"
                                                                Padding="9,2.5"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Action}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SecondaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Entité" Binding="{Binding EntityName}" Width="140" />
                                            <DataGridTextColumn Header="Id entité"
                                                                Binding="{Binding EntityId}"
                                                                Width="200"
                                                                ElementStyle="{StaticResource MutedCellText}" />
                                            <DataGridTextColumn Header="Adresse IP"
                                                                Binding="{Binding IpAddress}"
                                                                Width="*"
                                                                ElementStyle="{StaticResource MutedCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=AuditDataGrid}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Path Data="M2,9 L4,3 H12 L14,9 V13 H2 Z M2,9 H6 C6,10.6 6.9,11.4 8,11.4 C9.1,11.4 10,10.6 10,9 H14"
                                              Stroke="{StaticResource BorderStrongBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              Width="46"
                                              Height="42"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,10" />
                                        <TextBlock Text="Aucune entrée d'audit"
                                                   Style="{StaticResource EmptyStateTitleText}" />
                                        <TextBlock Text="Ajustez les filtres puis cliquez sur Actualiser."
                                                   Style="{StaticResource EmptyStateHintText}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ===================== Clôture journalière ===================== -->
                    <!-- Les modules ci-dessous vivent dans des UserControl
                         autonomes (dossier Views) : la fenetre ne fait que les heberger,
                         leur passer un ModuleViewContext apres connexion, et declencher
                         leur premier chargement quand l'onglet est ouvert. -->
                    <TabItem x:Name="ClosingTabItem" Header="Clôture journalière">
                        <views:ClosingView x:Name="ClosingView" />
                    </TabItem>

                    <!-- ========================== Trésorerie ========================= -->
                    <TabItem x:Name="TreasuryTabItem" Header="Trésorerie">
                        <views:TreasuryView x:Name="TreasuryView" />
                    </TabItem>

                    <!-- ============================ Clients ========================== -->
                    <TabItem x:Name="CustomersTabItem" Header="Clients">
                        <views:CustomersView x:Name="CustomersView" />
                    </TabItem>

                    <!-- ========================== Facturation ======================== -->
                    <TabItem x:Name="InvoicesTabItem" Header="Facturation">
                        <views:InvoicesView x:Name="InvoicesView" />
                    </TabItem>

                    <!-- ====================== Paramétrage global ==================== -->
                    <TabItem x:Name="SettingsTabItem" Header="Paramétrage global">
                        <views:SettingsView x:Name="SettingsView" />
                    </TabItem>

                    <!-- ================ Administration & utilisateurs =============== -->
                    <TabItem x:Name="UsersTabItem" Header="Administration &amp; utilisateurs">
                        <views:UsersView x:Name="UsersView" />
                    </TabItem>

                    <!-- Les onglets ci-dessous sont ajoutes A LA FIN, apres
                         l'administration, et non a cote des autres modules metier :
                         l'index d'un onglet est l'identite d'un module dans tout le
                         code (sidebar, ModuleCatalog, chargement paresseux), donc
                         inserer au milieu renumeroterait silencieusement les modules
                         existants. L'ordre visible pour l'utilisateur est celui de la
                         barre laterale, ou ces modules sont bien places parmi
                         les modules d'exploitation. -->

                    <!-- ======================= Comptabilité SCF ====================== -->
                    <TabItem x:Name="AccountingTabItem" Header="Comptabilité SCF">
                        <views:AccountingView x:Name="AccountingView" />
                    </TabItem>

                    <!-- ===================== Budget &amp; prévisions ==================== -->
                    <TabItem x:Name="BudgetTabItem" Header="Budget &amp; prévisions">
                        <views:BudgetView x:Name="BudgetView" />
                    </TabItem>

                    <!-- =================== Créances &amp; recouvrement ================== -->
                    <TabItem x:Name="ReceivablesTabItem" Header="Créances &amp; recouvrement">
                        <views:ReceivablesView x:Name="ReceivablesView" />
                    </TabItem>

                    <!-- ===================== Tarifs &amp; conventions ==================== -->
                    <TabItem x:Name="TariffsTabItem" Header="Tarifs &amp; conventions">
                        <views:TariffsView x:Name="TariffsView" />
                    </TabItem>

                    <!-- ================= Hébergement &amp; occupation ==================== -->
                    <TabItem x:Name="LodgingTabItem" Header="Hébergement &amp; occupation">
                        <views:LodgingView x:Name="LodgingView" />
                    </TabItem>

                    <!-- ==================== Workflows &amp; validations ================== -->
                    <TabItem x:Name="ApprovalsTabItem" Header="Validations">
                        <views:ApprovalsView x:Name="ApprovalsView" />
                    </TabItem>

                    <!-- ===================== Rapports automatiques =================== -->
                    <TabItem x:Name="ReportsTabItem" Header="Rapports">
                        <views:ReportsView x:Name="ReportsView" />
                    </TabItem>

                    <!-- ==================== Sauvegarde &amp; restauration =============== -->
                    <TabItem x:Name="BackupTabItem" Header="Sauvegarde">
                        <views:BackupView x:Name="BackupView" />
                    </TabItem>

                    <!-- ======================== Pilotage : direction ================== -->
                    <!-- Onglets 19 et 20. L'index d'un onglet est l'identite d'un module dans
                         tout le code (ModuleCatalog.TabIndex compris) : les nouveaux modules
                         s'ajoutent donc TOUJOURS a la fin, quelle que soit leur place metier
                         dans la barre laterale. -->
                    <TabItem x:Name="GroupDashboardTabItem" Header="Tableau de bord PDG">
                        <views:GroupDashboardView x:Name="GroupDashboardView" />
                    </TabItem>

                    <TabItem x:Name="DecCockpitTabItem" Header="Cockpit DEC">
                        <views:DecCockpitView x:Name="DecCockpitView" />
                    </TabItem>

                    <!-- Onglet 21. Meme regle que ci-dessus : l'index d'un onglet est
                         l'identite d'un module dans tout le code, un nouveau module
                         s'ajoute donc TOUJOURS a la fin. Sa place metier - parmi les
                         modules d'exploitation, juste apres l'hebergement - est celle
                         que lui donne ModuleCatalog dans la barre laterale. -->
                    <TabItem x:Name="HousekeepingTabItem" Header="Housekeeping &amp; chambres">
                        <views:HousekeepingView x:Name="HousekeepingView" />
                    </TabItem>

                    <!-- Onglet 22. Meme regle que ci-dessus : ajoute a la fin, sa place
                         metier - le groupe Ressources humaines - lui etant donnee par
                         ModuleCatalog dans la barre laterale. -->
                    <TabItem x:Name="HumanResourcesTabItem" Header="RH &amp; paie">
                        <views:HumanResourcesView x:Name="HumanResourcesView" />
                    </TabItem>

                    <!-- Onglet 23. Meme regle que ci-dessus : ajoute a la fin, sa place
                         metier - parmi les modules d'exploitation, apres le housekeeping -
                         lui etant donnee par ModuleCatalog dans la barre laterale. -->
                    <TabItem x:Name="CrmTabItem" Header="CRM &amp; expérience client">
                        <views:CrmView x:Name="CrmView" />
                    </TabItem>

                    <!-- Onglets 24, 25 et 26 - vague E1, la chaine d'exploitation
                         achats -> stocks -> cuisine. Meme regle que ci-dessus :
                         l'index d'un onglet est l'identite d'un module dans tout le
                         code, un nouveau module s'ajoute donc TOUJOURS a la fin. Leur
                         place metier - le groupe Exploitation, juste apres
                         l'hebergement - leur est donnee par ModuleCatalog dans la
                         barre laterale, pas par leur rang ici. -->
                    <TabItem x:Name="InventoryTabItem" Header="Stocks &amp; consommations">
                        <views:InventoryView x:Name="InventoryView" />
                    </TabItem>

                    <TabItem x:Name="PurchasingTabItem" Header="Achats &amp; approvisionnements">
                        <views:PurchasingView x:Name="PurchasingView" />
                    </TabItem>

                    <TabItem x:Name="KitchenTabItem" Header="Cuisine &amp; HACCP">
                        <views:KitchenView x:Name="KitchenView" />
                    </TabItem>

                    <TabItem x:Name="SyncTabItem" Header="Postes &amp; erreurs">
                        <views:SyncView x:Name="SyncView" />
                    </TabItem>

                    <TabItem x:Name="MiceTabItem" Header="Groupes &amp; MICE">
                        <views:MiceView x:Name="MiceView" />
                    </TabItem>

                    <!-- Onglet 29. Meme regle que ci-dessus : l'index d'un onglet est
                         l'identite d'un module dans tout le code, un nouveau module s'ajoute
                         donc TOUJOURS a la fin. Sa place metier - le groupe Pilotage - lui est
                         donnee par ModuleCatalog dans la barre laterale. -->
                    <TabItem x:Name="KpiTabItem" Header="Bibliothèque KPI">
                        <views:KpiView x:Name="KpiView" />
                    </TabItem>

                    <!-- Onglet 30 - PMS front office. Meme regle que ci-dessus : un nouveau module
                         s'ajoute TOUJOURS a la fin, sa place metier lui etant donnee par
                         ModuleCatalog dans la barre laterale. Il complete le module 10 plutot que
                         de le remplacer : "Hebergement & occupation" tient le parametrage et la
                         vente, celui-ci tient l'exploitation quotidienne. -->
                    <TabItem x:Name="PmsTabItem" Header="PMS front office">
                        <views:PmsView x:Name="PmsView" />
                    </TabItem>
                </TabControl>

                <!-- ========================= Bandeau de session ========================= -->
                <!-- Sorti de la barre laterale, qui est repliee sur l'accueil : le
                     resultat d'un appel ("Données chargées.", une erreur) doit rester
                     lisible sur TOUS les ecrans, y compris celui d'ouverture. Une seule
                     surface, donc un seul StatusTextBlock alimente par SetStatus. -->
                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ProgressBar x:Name="BusyProgressBar"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="0,0,0,10" />

                    <!-- Le bandeau est toujours a l'ecran, mais l'oeil est ailleurs :
                         quand on vient de cliquer un bouton en haut d'un ecran long, un
                         texte qui change discretement 700 px plus bas ne se voit pas. Le
                         fond fait donc un bref surlignage a chaque nouveau message (voir
                         SetStatus) : le mouvement attire le regard sans deplacer quoi que
                         ce soit, sans fenetre a fermer, et sans bulle qui recouvre l'ecran.
                         La pastille reprend celle de la carte de connexion - meme grammaire
                         des deux cotes de l'ouverture de session. -->
                    <Border x:Name="SessionStatusBorder"
                            Grid.Row="1"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,6,6"
                            Padding="8,10,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Session"
                                       Style="{StaticResource MetricLabelText}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                            <Ellipse x:Name="SessionStatusDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="Prêt."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

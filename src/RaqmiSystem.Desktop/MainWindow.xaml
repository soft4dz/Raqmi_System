<Window x:Class="RaqmiSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raqmi System"
        Height="760"
        Width="1240"
        MinHeight="680"
        MinWidth="1100"
        Background="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0" />

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Raqmi System"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Client desktop exploitation"
                               Foreground="#CBD5E1"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <StackPanel Width="220" Margin="0,0,10,0">
                        <TextBlock Text="API" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="ApiBaseUrlTextBox" Text="http://localhost:5180" />
                    </StackPanel>

                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="Utilisateur" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="UserNameTextBox" />
                    </StackPanel>

                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="Mot de passe" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PasswordBox" />
                    </StackPanel>

                    <Button x:Name="LoginButton"
                            Content="Connexion"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Bottom"
                            Click="LoginButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Modules"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   Margin="0,0,0,14" />
                        <Button Content="Unites hotelieres"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,8"
                                Click="ShowUnitsButton_Click" />
                        <Button Content="Recettes journalieres"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,8"
                                Click="ShowRevenueButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <ProgressBar x:Name="BusyProgressBar"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Margin="0,0,0,12" />
                        <TextBlock Text="Session"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="CurrentUserTextBlock"
                                   Text="Non connecte"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Pret."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0">
                <TabItem Header="Unites hotelieres">
                    <Border Background="White"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Liste des unites"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Referentiel consomme depuis /api/v1/organization/hotel-units"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="IncludeInactiveCheckBox"
                                              Content="Inclure inactives"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0" />
                                    <Button x:Name="RefreshUnitsButton"
                                            Content="Actualiser"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="RefreshUnitsButton_Click" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="UnitsDataGrid"
                                      Grid.Row="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding UnitType}" Width="120" />
                                    <DataGridTextColumn Header="Ordre" Binding="{Binding DisplayOrder}" Width="80" />
                                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="70" />
                                    <DataGridTextColumn Header="Maj par" Binding="{Binding UpdatedBy}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Recettes journalieres">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="White"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Saisie recette journaliere"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Creation en brouillon, avec option de soumission immediate au controle"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Button x:Name="RefreshRevenueButton"
                                            Content="Actualiser recettes"
                                            Style="{StaticResource SecondaryButton}"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="RefreshRevenueButton_Click" />
                                </DockPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Date exploitation" Style="{StaticResource LabelText}" />
                                        <DatePicker x:Name="BusinessDatePicker" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Unite hoteliere" Style="{StaticResource LabelText}" />
                                        <ComboBox x:Name="RevenueUnitComboBox"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Code" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Notes" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="NotesTextBox" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Hebergement" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="AccommodationTextBox" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Restauration" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="FoodTextBox" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Boissons" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="BeverageTextBox" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Autres" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="OtherTextBox" />
                                    </StackPanel>

                                    <Button x:Name="CreateRevenueButton"
                                            Grid.Column="8"
                                            Content="Creer brouillon"
                                            Style="{StaticResource PrimaryButton}"
                                            VerticalAlignment="Bottom"
                                            Click="CreateRevenueButton_Click" />

                                    <Button x:Name="CreateAndSubmitRevenueButton"
                                            Grid.Column="10"
                                            Content="Creer + soumettre"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Bottom"
                                            Click="CreateAndSubmitRevenueButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Recettes de la journee selectionnee"
                                           FontSize="18"
                                           FontWeight="SemiBold" />

                                <DataGrid x:Name="DailyRevenueDataGrid"
                                          Grid.Row="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="110" />
                                        <DataGridTextColumn Header="Unite" Binding="{Binding HotelUnitCode}" Width="130" />
                                        <DataGridTextColumn Header="Hebergement" Binding="{Binding Accommodation, StringFormat={}{0:N2}}" Width="120" />
                                        <DataGridTextColumn Header="Restauration" Binding="{Binding Food, StringFormat={}{0:N2}}" Width="120" />
                                        <DataGridTextColumn Header="Boissons" Binding="{Binding Beverage, StringFormat={}{0:N2}}" Width="110" />
                                        <DataGridTextColumn Header="Autres" Binding="{Binding Other, StringFormat={}{0:N2}}" Width="100" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="120" />
                                        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="110" />
                                        <DataGridTextColumn Header="Saisi par" Binding="{Binding CreatedBy}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>

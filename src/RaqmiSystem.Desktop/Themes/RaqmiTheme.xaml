    <!-- Convertisseurs de l'ecran d'accueil (classes du projet Desktop). -->
    <desktop:ModuleGroupIconConverter x:Key="ModuleGroupIconConverter" />
    <desktop:ModuleCountLabelConverter x:Key="ModuleCountLabelConverter" />

    <!-- Icones vectorielles par groupe fonctionnel : une seule icone par famille,
         dessinee dans une boite de 16x16, tracee au trait comme le reste de l'UI.
         La cle est resolue par ModuleGroupIconConverter ("ModuleGroupIcon.<cle>"). -->
    <PathGeometry x:Key="ModuleGroupIcon.Socle"
                  Figures="M2.5,14.5 V4.5 L8,1.8 V14.5 M8,6.5 H13.5 V14.5 M1,14.5 H15 M4.7,7.5 H5.8 M4.7,10.2 H5.8 M10.2,9.6 H11.3" />
    <PathGeometry x:Key="ModuleGroupIcon.Finance"
                  Figures="M1.5,4.5 H14.5 V11.5 H1.5 Z M8,5.9 A2.1,2.1 0 1 0 8.01,5.9 M3.9,8 H4.1 M11.9,8 H12.1" />
    <PathGeometry x:Key="ModuleGroupIcon.Exploitation"
                  Figures="M6.2,9.8 A3.2,3.2 0 1 0 6.21,9.8 M8.6,7.4 L14.2,1.8 M11.4,4.6 L13,6.2 M9.8,6.2 L11.4,7.8" />
    <PathGeometry x:Key="ModuleGroupIcon.Juridique"
                  Figures="M8,2.4 V13.6 M4.6,13.6 H11.4 M2.6,5 H13.4 M2.6,5 L1.2,9 H4 Z M13.4,5 L12,9 H14.8 Z" />
    <PathGeometry x:Key="ModuleGroupIcon.RessourcesHumaines"
                  Figures="M5.6,6 A2.2,2.2 0 1 0 5.61,6 M1.9,13.8 V12.6 A3.4,3.4 0 0 1 5.3,9.2 H6 A3.4,3.4 0 0 1 9.4,12.6 V13.8 M11.2,6.2 A1.8,1.8 0 1 0 11.21,6.2 M11.6,9.4 A3.2,3.2 0 0 1 14.2,12.5 V13.8" />
    <PathGeometry x:Key="ModuleGroupIcon.Controle"
                  Figures="M8,1.8 L13.4,3.9 V8 Q13.4,12.2 8,14.3 Q2.6,12.2 2.6,8 V3.9 Z M5.8,8.1 L7.3,9.6 L10.3,6.5" />
    <PathGeometry x:Key="ModuleGroupIcon.Conformite"
                  Figures="M3.4,1.8 H9.8 L12.4,4.4 V14.2 H3.4 Z M9.8,1.8 V4.4 H12.4 M5.8,6.8 H10 M5.8,9.1 H10 M9,12.2 A1.7,1.7 0 1 0 9.01,12.2" />
    <PathGeometry x:Key="ModuleGroupIcon.Pilotage"
                  Figures="M2.2,11.5 A5.8,5.8 0 0 1 13.8,11.5 M8,11.5 L10.9,7.7 M3.4,8.6 L4.3,9.3 M8,5.7 V6.8" />
    <PathGeometry x:Key="ModuleGroupIcon.Specifique"
                  Figures="M8,2.2 A1.4,1.4 0 1 0 8.01,2.2 M8,3.6 V13.8 M5,6.2 H11 M3.6,10 V11.6 L8,13.9 L12.4,11.6 V10" />
    <PathGeometry x:Key="ModuleGroupIcon.Documentaire"
                  Figures="M1.8,13.2 V3.8 H6 L7.4,5.8 H14.2 V13.2 Z" />
    <!-- Section « Achats & stocks » de la barre laterale : le catalogue range ces
         modules dans Exploitation, la navigation leur donne leur propre section, donc
         sa propre icone (un carton de magasin). Cle citee par SidebarLayout. -->
    <PathGeometry x:Key="ModuleGroupIcon.Achats"
                  Figures="M2.4,5.4 L8,2.6 L13.6,5.4 V10.6 L8,13.4 L2.4,10.6 Z M2.4,5.4 L8,8.2 L13.6,5.4 M8,8.2 V13.4" />
    <PathGeometry x:Key="ModuleGroupIcon.Systeme"
                  Figures="M8,5.5 A2.5,2.5 0 1 0 8.01,5.5 M8,1.4 V3 M8,13 V14.6 M1.4,8 H3 M13,8 H14.6 M3.6,3.6 L4.7,4.7 M11.3,11.3 L12.4,12.4 M12.4,3.6 L11.3,4.7 M4.7,11.3 L3.6,12.4" />

    <!-- ===================== Barre laterale : familles deroulantes ===================== -->
    <!-- Suite de ModuleNavButton, declaree ICI et pas la-bas : ces gabarits lisent
         ModuleGroupIconConverter et les geometries ci-dessus, qu'un StaticResource
         doit trouver deja declarees. L'ERP compte une cinquantaine de modules : la
         barre laterale les presente par famille, repliees, avec une recherche - une
         liste plate de vingt boutons ne tient ni a l'ecran ni dans la tete. -->

    <!-- Module a l'interieur d'une famille : meme comportement que ModuleNavButton
         (surbrillance Tag="Active", etat desactive), en retrait et un cran plus
         discret pour marquer la subordination a l'en-tete de famille. -->
    <Style x:Key="ModuleNavSubButton" TargetType="Button" BasedOn="{StaticResource ModuleNavButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="8,0,0,2" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- Un module verrouille est desactive : sans cela, l'info-bulle qui dit
             POURQUOI (permission manquante) ne s'afficherait jamais. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
    </Style>

    <!-- En-tete d'une famille : icone, libelle, compteur et chevron. C'est un
         ToggleButton pour que la ligne entiere ouvre et ferme la famille, a la
         souris comme au clavier (barre d'espace). -->
    <Style x:Key="ModuleNavGroupHeader" TargetType="ToggleButton">
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="10,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center" />

                            <!-- Chevron ferme = pointe a droite (rotation -90), ouvert =
                                 pointe en bas : l'etat de la famille se lit sans avoir a
                                 la comparer avec ses voisines. -->
                            <Path x:Name="chevron"
                                  Grid.Column="1"
                                  Width="9"
                                  Height="7"
                                  Stretch="None"
                                  Data="M0.6,1.6 L4.5,5.5 L8.4,1.6"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Contenu de l'en-tete : le DataContext est un ModuleNavigationGroup. -->
    <DataTemplate x:Key="ModuleNavGroupHeaderTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path Width="16"
                  Height="16"
                  Stretch="None"
                  Data="{Binding IconKey, Converter={StaticResource ModuleGroupIconConverter}}"
                  Stroke="{StaticResource TextMutedBrush}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <!-- Nombre de modules affiches : pendant une recherche, il devient le
                 nombre de resultats de la famille. -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    CornerRadius="8"
                    Padding="7,1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding VisibleModules.Count}"
                           FontSize="10.5"
                           FontWeight="Normal"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Famille deroulante. Le gabarit d'origine de l'Expander (fleche ronde,
         bordure) est entierement remplace : seule la ligne d'en-tete ouvre et ferme
         la famille, et IsExpanded reste lie au groupe, donc la fenetre peut ouvrir
         la famille du module qu'elle affiche. -->
    <Style x:Key="ModuleNavGroup" TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource ModuleNavGroupHeader}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        <ContentPresenter x:Name="content"
                                          Visibility="Collapsed"
                                          Margin="0,2,0,8" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="content" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Croix d'effacement du champ de recherche, posee par-dessus le TextBox. -->
    <Style x:Key="SearchClearButton" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <Path x:Name="glyph"
                              Width="9"
                              Height="9"
                              Stretch="None"
                              Data="M0.8,0.8 L8.2,8.2 M8.2,0.8 L0.8,8.2"
                              Stroke="{StaticResource TextMutedBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="glyph" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModuleCardIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cadenas discret affiche quand le profil n'a pas la permission de lecture. -->
    <Style x:Key="ModuleCardLockIcon" TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Data" Value="M3.4,5.4 V4 A2.6,2.6 0 0 1 8.6,4 V5.4 M2.2,5.4 H9.8 V10.6 H2.2 Z" />
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- ==================== Carte d'avancement des 49 modules ==================== -->
    <!-- L'accueil est pilote par les donnees (ModuleCatalog -> ModuleTile) : un seul
         gabarit de carte sert les 49 modules, quatre etats de statut, un etat
         verrouille (permission manquante). -->

    <!-- Bandeau d'avancement : compteurs par statut + barre segmentee. -->
    <Style x:Key="HomeProgressHeadlineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeStatDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <Style x:Key="HomeStatLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeStatValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="15,2,0,0" />
    </Style>

    <!-- Un segment de la barre d'avancement ; sa largeur (proportionnelle au
         nombre de modules du statut) est fixee par le code-behind. -->
    <Style x:Key="HomeProgressSegment" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,3,0" />
    </Style>

    <Style x:Key="HomeProgressCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================= Puces de filtre ============================= -->
    <!-- RadioButton stylise en puce : un seul filtre actif par rangee, l'etat
         coche est peint en accent. -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="chip"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentActionBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentActionBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentActionForegroundBrush}" />
                        </Trigger>
                        <!-- Filtre actif ET au clavier : la bordure navy ne se
                             detache pas d'un fond plein, l'anneau blanc si. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource FocusRingOnFilledBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante compacte : rangee de priorites, hierarchiquement secondaire. -->
    <Style x:Key="FilterChipCompact" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}">
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="FilterRowLabelText" TargetType="TextBlock" BasedOn="{StaticResource MetricLabelText}">
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ======================= En-tete de section de groupe ====================== -->
    <DataTemplate x:Key="ModuleCatalogGroupHeaderTemplate">
        <Grid Margin="0,22,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    CornerRadius="10"
                    Padding="9,3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                <!-- TextSecondary et non TextMuted : sur la pastille SurfaceSubtle,
                     TextMuted tombe a 4,16:1, sous le seuil WCAG AA de 4,5:1. -->
                <TextBlock Text="{Binding ItemCount, Converter={StaticResource ModuleCountLabelConverter}}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <!-- Filet discret qui structure les familles sans alourdir le lanceur. -->
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="14,0,4,0"
                    VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <Style x:Key="ModuleCatalogEmptyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="2,18,0,10" />
    </Style>

    <!-- ============================== Carte module =============================== -->
    <!-- Gabarit unique des 49 cartes. Les declencheurs de donnees lisent le
         ModuleTile porte par le DataContext : statut (couleur de pastille et
         d'icone) et verrouillage (cadenas). IsEnabled=False = carte non
         ouvrable (statut sans ecran ou permission manquante) : fond attenue,
         plus d'ombre ni de survol, mais texte a pleine lisibilite. -->
    <Style x:Key="ModuleCatalogCard" TargetType="Button">
        <Setter Property="Width" Value="158" />
        <Setter Property="Height" Value="136" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="card"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource StructureShadowColor}"
                                              Direction="270"
                                              ShadowDepth="1"
                                              BlurRadius="12"
                                              Opacity="0.06" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Icone du groupe, priorite et cadenas -->
                            <Grid>
                                <Border x:Name="iconChip"
                                        Width="50"
                                        Height="50"
                                        CornerRadius="14"
                                        Background="{StaticResource AppTileBlueSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock x:Name="moduleIcon"
                                               Text="{Binding IconGlyph}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="{StaticResource AppTileBlueBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,3,0,0">
                                    <Path x:Name="lockIcon"
                                          Style="{StaticResource ModuleCardLockIcon}"
                                          Margin="0,0,8,0"
                                          Visibility="Collapsed" />
                                    <!-- TextSecondary et non TextMuted : sur une carte
                                         attenuee (fond SurfaceSubtle - 39 cartes sur 49),
                                         TextMuted tombe a 4,16:1, sous WCAG AA 4,5:1. -->
                                    <TextBlock Text="{Binding Priority}"
                                               Visibility="Collapsed"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Titre et description -->
                            <StackPanel Grid.Row="1" Margin="0,9,0,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           MaxHeight="35" />
                                <TextBlock Text="{Binding Description}"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Pastille de statut -->
                            <Border x:Name="statusPill"
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    Background="{StaticResource ModuleStatusPlannedBackgroundBrush}">
                                <TextBlock x:Name="statusPillText"
                                           Text="{Binding StatusLabel}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModuleStatusPlannedForegroundBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Couleurs par statut -->
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static desktop:ModuleStatus.Disponible}">
                            <Setter TargetName="statusPill" Property="Background" Value="{StaticResource ModuleStatusAvailableBackgroundBrush}" />
                            <Setter TargetName="statusPillText" Property="Foreground" Value="{StaticResource ModuleStatusAvailableForegroundBrush}" />
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="moduleIcon" Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Group}" Value="Finance">
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource AppTileGreenSoftBrush}" />
                            <Setter TargetName="moduleIcon" Property="Foreground" Value="{StaticResource AppTileGreenBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Group}" Value="Exploitation">
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource AppTileTealSoftBrush}" />
                            <Setter TargetName="moduleIcon" Property="Foreground" Value="{StaticResource AppTileTealBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Group}" Value="Ressources humaines">
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource AppTileGoldSoftBrush}" />
                            <Setter TargetName="moduleIcon" Property="Foreground" Value="{StaticResource AppTileGoldBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Group}" Value="Pilotage">
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource AppTileIndigoSoftBrush}" />
                            <Setter TargetName="moduleIcon" Property="Foreground" Value="{StaticResource AppTileIndigoBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static desktop:ModuleStatus.ApiPrete}">
                            <Setter TargetName="statusPill" Property="Background" Value="{StaticResource ModuleStatusApiBackgroundBrush}" />
                            <Setter TargetName="statusPillText" Property="Foreground" Value="{StaticResource ModuleStatusApiForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static desktop:ModuleStatus.Partiel}">
                            <Setter TargetName="statusPill" Property="Background" Value="{StaticResource ModuleStatusPartialBackgroundBrush}" />
                            <Setter TargetName="statusPillText" Property="Foreground" Value="{StaticResource ModuleStatusPartialForegroundBrush}" />
                        </DataTrigger>

                        <!-- Carte non ouvrable : plus d'ombre, fond attenue, texte intact -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter TargetName="card" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>

                        <!-- Permission de lecture manquante : cadenas explicite -->
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter TargetName="lockIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="moduleIcon" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </DataTrigger>

                        <!-- Survol : elevation de 2px, bordure accent de marque.
                             Volontairement distinct du focus clavier (navy) : la
                             souris et le clavier ne doivent pas produire le meme
                             signal, sinon on ne sait plus lequel des deux parle. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-3"
                                                         Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.20"
                                                         Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0"
                                                         Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.07"
                                                         Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apparition de la vue Accueil : fondu + leger glissement, en cascade
         (trois blocs decales de 80 ms). Rejoue a chaque retour sur l'Accueil. -->
    <Style x:Key="HomeRevealStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="14"
                                             To="0"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeRevealDelayedStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             BeginTime="0:0:0.08"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="14"
                                             To="0"
                                             BeginTime="0:0:0.08"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- Maintient le bloc invisible pendant le delai de cascade. -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="0"
                                             Duration="0:0:0.08"
                                             FillBehavior="Stop" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeRevealDelayedMoreStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             BeginTime="0:0:0.16"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="14"
                                             To="0"
                                             BeginTime="0:0:0.16"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- Maintient le bloc invisible pendant le delai de cascade. -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="0"
                                             Duration="0:0:0.16"
                                             FillBehavior="Stop" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================= ToolTip ================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource StructureBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

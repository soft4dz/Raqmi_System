<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:desktop="clr-namespace:RaqmiSystem.Desktop"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================================
         RaqmiTheme - systeme de design centralise de Raqmi System Desktop.
         Palette de marque : structure #071525, primaire #073B78, secondaire #145CAB,
         accent #0AA3AD. Les variantes hover/pressed sont derivees de facon coherente
         (~ +8% de luminosite au survol, ~ -10% a l'appui).
         ============================================================================ -->

    <!-- ============================== Densite ================================== -->
    <!-- Hauteur des lignes de grille. En DynamicResource dans les styles ci-dessous
         (contrairement au reste du theme, en StaticResource) : une valeur de type
         Double n'est pas un objet mutable, changer la densite remplace donc l'entree
         du dictionnaire, et seul DynamicResource voit ce remplacement.
         Trois valeurs pilotent les 759 grilles du produit. -->
    <sys:Double x:Key="GridRowHeight">40</sys:Double>
    <sys:Double x:Key="GridHeaderHeight">40</sys:Double>

    <!-- =========================== Nom accessible ============================== -->
    <!-- Voir AccessibleNameConverter (Converters.cs) : donne aux champs de saisie le
         nom que les lecteurs d'ecran n'ont pas, derive du texte indicatif ou de
         l'info-bulle que la vue ecrit deja. Applique par les styles implicites de
         TextBox, PasswordBox, ComboBox et DatePicker, plus bas. -->
    <desktop:AccessibleNameConverter x:Key="AccessibleNameConverter" />

    <!-- ================================ Typographie ============================= -->
    <FontFamily x:Key="AppFontFamily">Manrope, Noto Kufi Arabic, Segoe UI</FontFamily>

    <!-- ================================= Palette ================================ -->
    <!-- Structure (fonds sombres de marque) -->
    <SolidColorBrush x:Key="StructureBrush" Color="#071525" />
    <!-- Couleur d'ombre portee (DropShadowEffect.Color attend une Color, pas un Brush) -->
    <Color x:Key="StructureShadowColor">#071525</Color>
    <!-- Texte principal sur les fonds structure sombres (en-tete, ecran de connexion) -->
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StructureElevatedBrush" Color="#0C2135" />
    <LinearGradientBrush x:Key="LoginBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#071525" Offset="0" />
        <GradientStop Color="#0A2440" Offset="0.55" />
        <GradientStop Color="#071C31" Offset="1" />
    </LinearGradientBrush>

    <!-- Primaire (navy) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#073B78" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0A4C97" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#052B57" />

    <!-- Secondaire (bleu) -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#145CAB" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#1A6BC4" />
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#0F4A8C" />

    <!-- Accent de MARQUE (teal). Reserve a ce qui ne porte pas de texte :
         pastilles, traits, bordures, filets de selection. Sur blanc il ne pese
         que 3,06:1 - insuffisant pour du texte, suffisant pour un trait. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0AA3AD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0DB6C1" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#088790" />

    <!-- Accent d'ACTION : meme teinte (H 184), assombrie pour porter du texte
         blanc. C'est la couleur des surfaces pleines - bouton principal, filtre
         actif, case cochee, barre de progression. Repos 5,39:1, survol 4,54:1,
         appui 6,36:1 : les trois etats passent WCAG AA sur texte normal, ce que
         l'accent de marque ne faisait a aucun (3,06 / 2,71 / 3,89).
         Le survol s'eclaircit comme partout ailleurs dans le theme, mais depuis
         un palier assez bas pour rester au-dessus de 4,5:1. -->
    <SolidColorBrush x:Key="AccentActionBrush" Color="#07767D" />
    <!-- Texte porte par une surface d'action. Un token plutot que « White » en dur :
         en theme sombre la surface d'action s'eclaircit, et c'est le texte qui doit
         alors s'assombrir. Sans ce token, le bouton principal serait illisible. -->
    <SolidColorBrush x:Key="AccentActionForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentActionHoverBrush" Color="#08838B" />
    <SolidColorBrush x:Key="AccentActionPressedBrush" Color="#066A70" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E1F4F5" />
    <!-- Selection translucide dans les grilles (18% accent) -->
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#2E0AA3AD" />

    <!-- Danger -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D24A3C" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#992E22" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBECEA" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EFC9C4" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#EEF4F8" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E4EDF4" />

    <!-- Bordures.
         PanelBorder delimite une carte : filet decoratif, la carte est deja identifiee
         par sa surface et son ombre, aucun seuil ne s'y applique.
         FieldBorder delimite un CHAMP DE SAISIE, et la c'est autre chose : un champ
         blanc pose sur une carte blanche n'est identifiable que par sa bordure, donc
         elle tombe sous WCAG 1.4.11 et doit peser 3:1. Le filet de carte (#DCE6EF,
         1,26:1) ne convenait pas a cet emploi. La teinte du theme est conservee, la
         saturation abaissee a 18 % : plus foncee qu'avant, mais grise a l'oeil plutot
         que bleue - le seuil est atteint sans que 412 champs virent au souligne. -->
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE6EF" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#7A8FA3" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B9CCDD" />

    <!-- Textes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F2337" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A6A87" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5B6C7E" />
    <SolidColorBrush x:Key="TextLabelBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#5C7188" />
    <SolidColorBrush x:Key="MutedBrush" Color="#4A6A87" />
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#9FC3DC" />

    <!-- Focus clavier. Deux tokens, parce qu'un anneau doit contraster avec ce
         qu'il entoure et que le theme a deux familles de fonds :
         - FocusRingBrush (navy) sur les surfaces claires : 9,3 a 11,0:1
         - FocusRingOnFilledBrush (blanc) sur les surfaces pleines d'action :
           5,4:1 sur l'accent d'action, 11,0 sur le primaire, 5,4 sur le danger.
         L'ancien anneau (AccentBrush sur fond clair) pesait 3,06:1 sur 1 px, et
         serait tombe a 2,04:1 une fois l'accent d'action assombri. -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#073B78" />
    <SolidColorBrush x:Key="FocusRingOnFilledBrush" Color="#FFFFFF" />
    <!-- Anneau sur le fond structure de l'en-tete. Distinct du precedent : en theme
         clair les deux valent blanc, mais en theme sombre la surface d'action devient
         claire (anneau sombre) alors que l'en-tete reste sombre (anneau clair). Un
         token unique y tombait a 1,17:1 - un focus invisible dans l'en-tete. -->
    <SolidColorBrush x:Key="FocusRingOnDarkBrush" Color="#FFFFFF" />

    <!-- Etats desactives -->
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#E5EBF1" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#576C82" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#DDE5EC" />

    <!-- Navigation laterale -->
    <SolidColorBrush x:Key="ModuleInactiveBackgroundBrush" Color="#EEF4F8" />
    <SolidColorBrush x:Key="ModuleActiveBackgroundBrush" Color="#1A0AA3AD" />

    <!-- Grilles -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F0F6FA" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#FAFCFE" />
    <SolidColorBrush x:Key="GridHeaderForegroundBrush" Color="#5B7591" />

    <!-- Badges de statut -->
    <SolidColorBrush x:Key="StatusDraftBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="StatusDraftForegroundBrush" Color="#475569" />
    <SolidColorBrush x:Key="StatusSubmittedBackgroundBrush" Color="#FCEFC7" />
    <SolidColorBrush x:Key="StatusSubmittedForegroundBrush" Color="#92600A" />
    <SolidColorBrush x:Key="StatusValidatedBackgroundBrush" Color="#DBF2E3" />
    <SolidColorBrush x:Key="StatusValidatedForegroundBrush" Color="#187A41" />
    <SolidColorBrush x:Key="StatusRejectedBackgroundBrush" Color="#FBE3E1" />
    <SolidColorBrush x:Key="StatusRejectedForegroundBrush" Color="#B3261E" />

    <!-- Avancement des modules (carte d'avancement de l'accueil).
         Pastilles : fond doux + texte fonce contraste (>= 4.5:1).
         Segments  : versions saturees des memes teintes, pour la barre. -->
    <SolidColorBrush x:Key="ModuleStatusAvailableBackgroundBrush" Color="#DCF3E5" />
    <SolidColorBrush x:Key="ModuleStatusAvailableForegroundBrush" Color="#14713C" />
    <SolidColorBrush x:Key="ModuleStatusApiBackgroundBrush" Color="#DDF2F4" />
    <SolidColorBrush x:Key="ModuleStatusApiForegroundBrush" Color="#096B73" />
    <SolidColorBrush x:Key="ModuleStatusPartialBackgroundBrush" Color="#FBEBC8" />
    <SolidColorBrush x:Key="ModuleStatusPartialForegroundBrush" Color="#8A5A08" />
    <SolidColorBrush x:Key="ModuleStatusPlannedBackgroundBrush" Color="#E8EEF4" />
    <SolidColorBrush x:Key="ModuleStatusPlannedForegroundBrush" Color="#46617B" />

    <SolidColorBrush x:Key="ModuleProgressAvailableBrush" Color="#1F9D57" />
    <SolidColorBrush x:Key="ModuleProgressApiBrush" Color="#0AA3AD" />
    <SolidColorBrush x:Key="ModuleProgressPartialBrush" Color="#BF8B16" />
    <SolidColorBrush x:Key="ModuleProgressPlannedBrush" Color="#7798B5" />

    <!-- Teintes d'icones du lanceur d'applications. Elles donnent aux domaines
         un repere visuel rapide, sans reprendre la palette violette d'Odoo. -->
    <SolidColorBrush x:Key="AppTileBlueSoftBrush" Color="#E3EFFB" />
    <SolidColorBrush x:Key="AppTileBlueBrush" Color="#145CAB" />
    <SolidColorBrush x:Key="AppTileTealSoftBrush" Color="#E1F4F5" />
    <SolidColorBrush x:Key="AppTileTealBrush" Color="#087B84" />
    <SolidColorBrush x:Key="AppTileGoldSoftBrush" Color="#FBF0D6" />
    <SolidColorBrush x:Key="AppTileGoldBrush" Color="#986B0D" />
    <SolidColorBrush x:Key="AppTileGreenSoftBrush" Color="#E2F3E8" />
    <SolidColorBrush x:Key="AppTileGreenBrush" Color="#247A49" />
    <SolidColorBrush x:Key="AppTileIndigoSoftBrush" Color="#E9EAF8" />
    <SolidColorBrush x:Key="AppTileIndigoBrush" Color="#5057A4" />

    <!-- Barre de defilement -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#6C90B0" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#567DA0" />

    <!-- ============================ Echelle typographique ======================= -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MetricLabelText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ================================= Cartes ================================= -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SubtleCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ================================= Boutons ================================ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="Background" Value="{StaticResource AccentActionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentActionBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource AccentActionForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <!-- Anneau de focus interne : invisible au repos, il ne
                             deplace jamais le contenu puisqu'il est pose en
                             surimpression et non en epaisseur de bordure. -->
                        <Border x:Name="focusRing"
                                CornerRadius="4"
                                Margin="2"
                                BorderThickness="1.5"
                                BorderBrush="Transparent"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentActionHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentActionHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="BorderBrush" Value="{StaticResource FocusRingOnFilledBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentActionPressedBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentActionPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,7" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,7" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBorderBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton fantome sur fond sombre (en-tete) -->
    <Style x:Key="HeaderGhostButton" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#3DFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AFFFFFF" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#66FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusRingOnDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


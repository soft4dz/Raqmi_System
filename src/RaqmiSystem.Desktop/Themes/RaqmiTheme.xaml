<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================
         RaqmiTheme - systeme de design centralise de Raqmi System Desktop.
         Palette de marque : structure #071525, primaire #073B78, secondaire #145CAB,
         accent #0AA3AD. Les variantes hover/pressed sont derivees de facon coherente
         (~ +8% de luminosite au survol, ~ -10% a l'appui).
         ============================================================================ -->

    <!-- ================================ Typographie ============================= -->
    <FontFamily x:Key="AppFontFamily">Manrope, Noto Kufi Arabic, Segoe UI</FontFamily>

    <!-- ================================= Palette ================================ -->
    <!-- Structure (fonds sombres de marque) -->
    <SolidColorBrush x:Key="StructureBrush" Color="#071525" />
    <!-- Couleur d'ombre portee (DropShadowEffect.Color attend une Color, pas un Brush) -->
    <Color x:Key="StructureShadowColor">#071525</Color>
    <!-- Texte principal sur les fonds structure sombres (en-tete, ecran de connexion) -->
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StructureElevatedBrush" Color="#0C2135" />
    <LinearGradientBrush x:Key="LoginBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#071525" Offset="0" />
        <GradientStop Color="#0A2440" Offset="0.55" />
        <GradientStop Color="#071C31" Offset="1" />
    </LinearGradientBrush>

    <!-- Primaire (navy) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#073B78" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0A4C97" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#052B57" />

    <!-- Secondaire (bleu) -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#145CAB" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#1A6BC4" />
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#0F4A8C" />

    <!-- Accent (teal - actions principales) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0AA3AD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0DB6C1" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#088790" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E1F4F5" />
    <!-- Selection translucide dans les grilles (18% accent) -->
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#2E0AA3AD" />

    <!-- Danger -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D24A3C" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#992E22" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBECEA" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EFC9C4" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#EEF4F8" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E4EDF4" />

    <!-- Bordures -->
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE6EF" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B9CCDD" />

    <!-- Textes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F2337" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A6A87" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64778B" />
    <SolidColorBrush x:Key="TextLabelBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#9AAABB" />
    <SolidColorBrush x:Key="MutedBrush" Color="#4A6A87" />
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#9FC3DC" />

    <!-- Etats desactives -->
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#E5EBF1" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9AAABB" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#DDE5EC" />

    <!-- Navigation laterale -->
    <SolidColorBrush x:Key="ModuleInactiveBackgroundBrush" Color="#EEF4F8" />
    <SolidColorBrush x:Key="ModuleActiveBackgroundBrush" Color="#1A0AA3AD" />

    <!-- Grilles -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F0F6FA" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#FAFCFE" />
    <SolidColorBrush x:Key="GridHeaderForegroundBrush" Color="#5B7591" />

    <!-- Badges de statut -->
    <SolidColorBrush x:Key="StatusDraftBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="StatusDraftForegroundBrush" Color="#475569" />
    <SolidColorBrush x:Key="StatusSubmittedBackgroundBrush" Color="#FCEFC7" />
    <SolidColorBrush x:Key="StatusSubmittedForegroundBrush" Color="#92600A" />
    <SolidColorBrush x:Key="StatusValidatedBackgroundBrush" Color="#DBF2E3" />
    <SolidColorBrush x:Key="StatusValidatedForegroundBrush" Color="#187A41" />
    <SolidColorBrush x:Key="StatusRejectedBackgroundBrush" Color="#FBE3E1" />
    <SolidColorBrush x:Key="StatusRejectedForegroundBrush" Color="#B3261E" />

    <!-- Barre de defilement -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3D2DF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9FB4C6" />

    <!-- ============================ Echelle typographique ======================= -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MetricLabelText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ================================= Cartes ================================= -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SubtleCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ================================= Boutons ================================ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,7" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>


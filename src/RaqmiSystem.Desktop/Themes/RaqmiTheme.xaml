         ceinture, deux roues. -->
    <PathGeometry x:Key="ModuleGroupIcon.Parking"
                  Figures="M1.6,12 V8.6 L3.6,4.6 H12.4 L14.4,8.6 V12 M1.6,8.6 H14.4 M4.4,10.7 A1.3,1.3 0 1 0 4.41,10.7 M11.6,10.7 A1.3,1.3 0 1 0 11.61,10.7" />
    <!-- 21 Integrations & Materiels : une fiche electrique - corps, deux broches,
         cordon. Le materiel se branche ; Systeme garde l'engrenage du serveur. -->
    <PathGeometry x:Key="ModuleGroupIcon.Integrations"
                  Figures="M4.4,6.4 H11.6 V9.4 A3.6,3.6 0 0 1 4.4,9.4 Z M6,2.8 V6.4 M10,2.8 V6.4 M8,13 V14.6" />

    <!-- ===================== Barre laterale : familles deroulantes ===================== -->
    <!-- Suite de ModuleNavButton, declaree ICI et pas la-bas : ces gabarits lisent
         ModuleGroupIconConverter et les geometries ci-dessus, qu'un StaticResource
         doit trouver deja declarees. L'ERP compte une cinquantaine de modules : la
         barre laterale les presente par famille, repliees, avec une recherche - une
         liste plate de vingt boutons ne tient ni a l'ecran ni dans la tete. -->

    <!-- Module a l'interieur d'une famille : meme comportement que ModuleNavButton
         (surbrillance Tag="Active", etat desactive), en retrait et un cran plus
         discret pour marquer la subordination a l'en-tete de famille. -->
    <Style x:Key="ModuleNavSubButton" TargetType="Button" BasedOn="{StaticResource ModuleNavButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="8,0,0,2" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- Un module verrouille est desactive : sans cela, l'info-bulle qui dit
             POURQUOI (permission manquante) ne s'afficherait jamais. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
    </Style>

    <!-- En-tete d'une famille : icone, libelle, compteur et chevron. C'est un
         ToggleButton pour que la ligne entiere ouvre et ferme la famille, a la
         souris comme au clavier (barre d'espace). -->
    <Style x:Key="ModuleNavGroupHeader" TargetType="ToggleButton">
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="10,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center" />

                            <!-- Chevron ferme = pointe a droite (rotation -90), ouvert =
                                 pointe en bas : l'etat de la famille se lit sans avoir a
                                 la comparer avec ses voisines. -->
                            <Path x:Name="chevron"
                                  Grid.Column="1"
                                  Width="9"
                                  Height="7"
                                  Stretch="None"
                                  Data="M0.6,1.6 L4.5,5.5 L8.4,1.6"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Contenu de l'en-tete : le DataContext est un ModuleNavigationGroup. -->
    <DataTemplate x:Key="ModuleNavGroupHeaderTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path Width="16"
                  Height="16"
                  Stretch="None"
                  Data="{Binding IconKey, Converter={StaticResource ModuleGroupIconConverter}}"
                  Stroke="{StaticResource TextMutedBrush}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <!-- Nombre de modules affiches : pendant une recherche, il devient le
                 nombre de resultats de la famille. -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    CornerRadius="8"
                    Padding="7,1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding VisibleModules.Count}"
                           FontSize="10.5"
                           FontWeight="Normal"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Famille deroulante. Le gabarit d'origine de l'Expander (fleche ronde,
         bordure) est entierement remplace : seule la ligne d'en-tete ouvre et ferme
         la famille, et IsExpanded reste lie au groupe, donc la fenetre peut ouvrir
         la famille du module qu'elle affiche. -->
    <Style x:Key="ModuleNavGroup" TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource ModuleNavGroupHeader}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        <ContentPresenter x:Name="content"
                                          Visibility="Collapsed"
                                          Margin="0,2,0,8" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="content" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Croix d'effacement du champ de recherche, posee par-dessus le TextBox. -->
    <Style x:Key="SearchClearButton" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <Path x:Name="glyph"
                              Width="9"
                              Height="9"
                              Stretch="None"
                              Data="M0.8,0.8 L8.2,8.2 M8.2,0.8 L0.8,8.2"
                              Stroke="{StaticResource TextMutedBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="glyph" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModuleCardIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cadenas discret affiche quand le profil n'a pas la permission de lecture. -->
    <Style x:Key="ModuleCardLockIcon" TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Data" Value="M3.4,5.4 V4 A2.6,2.6 0 0 1 8.6,4 V5.4 M2.2,5.4 H9.8 V10.6 H2.2 Z" />
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- ======================= Badges de maturite des domaines ======================= -->
    <!-- Meme mecanique que la pastille de statut de la carte module (Border arrondi,
         fond doux, texte 10.5 semi-gras fonce de la meme teinte), mais en styles
         nommes : un badge de maturite s'affiche sur l'accueil, dans la barre laterale
         et dans le fil d'Ariane, et ne doit pas etre redessine trois fois.

         La couleur du texte est posee par TextElement.Foreground SUR LE BORDER : la
         propriete est heritee, le TextBlock enfant la recoit sans style propre, et le
         badge tient en un seul element :

             <Border Style="{StaticResource MaturityBadge.Functional}">
                 <TextBlock Text="Fonctionnel" />
             </Border>

         Dans un gabarit pilote par les donnees, un DataTrigger sur la maturite change
         le Style du Border nomme (Setter TargetName="badge" Property="Style") plutot
         que de recopier fond et texte, comme le fait la carte module pour ModuleStatus.

         Libelles attendus, a une seule source (charte, 1.5) : « Planifie »,
         « Apercu technique », « Fonctionnel », « Pret pour la production ». -->
    <Style x:Key="MaturityBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,2.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.FontSize" Value="10.5" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <!-- Defaut = Planned : le niveau le plus bas est le seul qu'un oubli de style
             ait le droit d'annoncer (charte, 4.3 : un statut gonfle est un defaut). -->
        <Setter Property="Background" Value="{StaticResource MaturityPlannedBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource MaturityPlannedForegroundBrush}" />
    </Style>

    <Style x:Key="MaturityBadge.Planned" TargetType="Border" BasedOn="{StaticResource MaturityBadge}" />

    <Style x:Key="MaturityBadge.TechnicalPreview" TargetType="Border" BasedOn="{StaticResource MaturityBadge}">
        <Setter Property="Background" Value="{StaticResource MaturityTechnicalPreviewBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource MaturityTechnicalPreviewForegroundBrush}" />
    </Style>

    <Style x:Key="MaturityBadge.Functional" TargetType="Border" BasedOn="{StaticResource MaturityBadge}">
        <Setter Property="Background" Value="{StaticResource MaturityFunctionalBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource MaturityFunctionalForegroundBrush}" />
    </Style>

    <Style x:Key="MaturityBadge.ProductionReady" TargetType="Border" BasedOn="{StaticResource MaturityBadge}">
        <Setter Property="Background" Value="{StaticResource MaturityProductionReadyBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource MaturityProductionReadyForegroundBrush}" />
    </Style>

    <!-- Point de maturite : la version compacte du badge, pour un en-tete de domaine
         de la barre laterale ou une legende, la ou un mot ne tient pas. Le sens reste
         porte par l'info-bulle ou le libelle voisin, jamais par la couleur seule. -->
    <Style x:Key="MaturityDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource MaturityPlannedAccentBrush}" />
    </Style>

    <Style x:Key="MaturityDot.Planned" TargetType="Ellipse" BasedOn="{StaticResource MaturityDot}" />

    <Style x:Key="MaturityDot.TechnicalPreview" TargetType="Ellipse" BasedOn="{StaticResource MaturityDot}">
        <Setter Property="Fill" Value="{StaticResource MaturityTechnicalPreviewAccentBrush}" />
    </Style>

    <Style x:Key="MaturityDot.Functional" TargetType="Ellipse" BasedOn="{StaticResource MaturityDot}">
        <Setter Property="Fill" Value="{StaticResource MaturityFunctionalAccentBrush}" />
    </Style>

    <Style x:Key="MaturityDot.ProductionReady" TargetType="Ellipse" BasedOn="{StaticResource MaturityDot}">
        <Setter Property="Fill" Value="{StaticResource MaturityProductionReadyAccentBrush}" />
    </Style>

    <!-- ==================== Carte d'avancement des 50 modules ==================== -->
    <!-- L'accueil est pilote par les donnees (ModuleCatalog -> ModuleTile) : un seul
         gabarit de carte sert les 50 modules, quatre etats de statut, un etat
         verrouille (permission manquante). -->

    <!-- Bandeau d'avancement : compteurs par statut + barre segmentee. -->
    <Style x:Key="HomeProgressHeadlineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeStatDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <Style x:Key="HomeStatLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeStatValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="15,2,0,0" />
    </Style>

    <!-- Un segment de la barre d'avancement ; sa largeur (proportionnelle au
         nombre de modules du statut) est fixee par le code-behind. -->
    <Style x:Key="HomeProgressSegment" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,3,0" />
    </Style>

    <Style x:Key="HomeProgressCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================= Puces de filtre ============================= -->
    <!-- RadioButton stylise en puce : un seul filtre actif par rangee, l'etat
         coche est peint en accent. -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="chip"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentActionBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentActionBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentActionForegroundBrush}" />
                        </Trigger>
                        <!-- Filtre actif ET au clavier : la bordure navy ne se
                             detache pas d'un fond plein, l'anneau blanc si. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource FocusRingOnFilledBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante compacte : rangee de priorites, hierarchiquement secondaire. -->
    <Style x:Key="FilterChipCompact" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}">
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="FilterRowLabelText" TargetType="TextBlock" BasedOn="{StaticResource MetricLabelText}">
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ======================= En-tete de domaine du catalogue ====================== -->
    <!-- Le groupe est un DOMAINE (HomeCatalogDomainHeader porte par CollectionViewGroup.Name),
         pas un couple domaine-module : icone du domaine, « NN Nom », compteur de modules et
         badge de maturite du domaine. C'est le seul endroit du catalogue ou ce badge
         s'affiche (navigation-shell 6.3 : la carte module ne le porte jamais, sa pastille
         dit le statut du module, qui est une autre echelle). Le titre est un en-tete de
         niveau 2 pour les lecteurs d'ecran. -->
    <DataTemplate x:Key="ModuleCatalogGroupHeaderTemplate">
        <Grid Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Path Width="16"
                  Height="16"
                  Stretch="None"
                  Stroke="{StaticResource TextMutedBrush}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  VerticalAlignment="Center"
                  Margin="0,0,9,0"
                  IsHitTestVisible="False"
                  Data="{Binding Name.IconKey, Converter={StaticResource ModuleGroupIconConverter}}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Name.Title}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level2">
                <AutomationProperties.Name>
                    <MultiBinding StringFormat="Domaine {0} {1}, {2}, {3}">
                        <Binding Path="Name.Id" />
                        <Binding Path="Name.Label" />
                        <Binding Path="ItemCount" Converter="{StaticResource ModuleCountLabelConverter}" />
                        <Binding Path="Name.MaturityLabel" />
                    </MultiBinding>
                </AutomationProperties.Name>
            </TextBlock>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    CornerRadius="9"
                    Padding="9,2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                <!-- TextSecondary et non TextMuted : sur la pastille SurfaceSubtle,
                     TextMuted tombe a 4,16:1, sous le seuil WCAG AA de 4,5:1. -->
                <TextBlock Text="{Binding ItemCount, Converter={StaticResource ModuleCountLabelConverter}}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <Border Grid.Column="3"
                    desktop:MaturityBadge.Maturity="{Binding Name.Maturity}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding Name.MaturityLabel}" />
            </Border>

            <!-- Filet de separation qui prolonge le titre jusqu'au bord. -->
            <Border Grid.Column="4"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="14,0,4,0"
                    VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <!-- ============================ Puce de raccourci ============================ -->
    <!-- Bouton au visuel d'une FilterChip non cochee : les « derniers ecrans ouverts »
         de l'accueil. Un Button et non un RadioButton - une puce qui navigue n'est pas
         un filtre, et le clavier comme le lecteur d'ecran doivent l'annoncer comme un
         bouton. Aucun brush nouveau. -->
    <Style x:Key="HomeChipButton" TargetType="Button">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="chip"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================== Bandeau d'avertissement ========================== -->
    <!-- Promu de TreasuryView : dit a l'ecran qu'un chiffre affiche ne repond pas au
         filtre visible, qu'un compteur n'a pas repondu, ou qu'un reglage manque. Les
         vues qui en portent encore une copie locale la gardent : une ressource locale
         prime sur celle du theme, rien ne casse. -->
    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusSubmittedForegroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style x:Key="WarningBannerText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================ Onglets de section ============================ -->
    <!-- Promus de TreasuryView : le style implicite du TabControl supprime les en-tetes
         (la barre laterale est l'unique navigation entre modules) ; une vue qui a des
         sections internes utilise ce gabarit d'onglets visibles. -->
    <Style x:Key="SectionTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="tabBackground"
                                Background="Transparent"
                                CornerRadius="6,6,0,0"
                                Padding="18,9">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <Rectangle x:Name="tabIndicator"
                                   Grid.Row="1"
                                   Height="2.5"
                                   Fill="{StaticResource AccentBrush}"
                                   Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tabIndicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SectionTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                        </Border>

                        <ContentPresenter Grid.Row="1"
                                          Margin="0,16,0,0"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModuleCatalogEmptyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="2,18,0,10" />
    </Style>

    <!-- ============================== Carte module =============================== -->
    <!-- Gabarit unique des 50 cartes. Les declencheurs de donnees lisent le
         ModuleTile porte par le DataContext : statut (couleur de pastille et
         d'icone) et verrouillage (cadenas). IsEnabled=False = carte non
         ouvrable (statut sans ecran ou permission manquante) : fond attenue,
         plus d'ombre ni de survol, mais texte a pleine lisibilite. -->
    <Style x:Key="ModuleCatalogCard" TargetType="Button">
        <Setter Property="Width" Value="224" />
        <Setter Property="Height" Value="176" />
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
        <!-- Le bouton n'a pas de Content (tout vit dans le gabarit) : sans ces deux
             lignes son nom accessible serait vide pour les 50 cartes. ModuleTile
             compose la phrase - « Ouvrir X, Disponible », « X, accès non autorisé
             pour votre profil », « X, planifié, aucun écran ». -->
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="card"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource StructureShadowColor}"
                                              Direction="270"
                                              ShadowDepth="2"
                                              BlurRadius="10"
                                              Opacity="0.07" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Icone du groupe, priorite et cadenas -->
                            <Grid>
                                <Border x:Name="iconChip"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        Background="{StaticResource SurfaceHoverBrush}"
                                        HorizontalAlignment="Left">
                                    <Path x:Name="groupIcon"
                                          Style="{StaticResource ModuleCardIcon}"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          Data="{Binding GroupIconKey, Converter={StaticResource ModuleGroupIconConverter}}" />
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,3,0,0">
                                    <Path x:Name="lockIcon"
                                          Style="{StaticResource ModuleCardLockIcon}"
                                          Margin="0,0,8,0"
                                          Visibility="Collapsed" />
                                    <!-- TextSecondary et non TextMuted : sur une carte
                                         attenuee - la majorite des cartes),
                                         TextMuted tombe a 4,16:1, sous WCAG AA 4,5:1. -->
                                    <TextBlock Text="{Binding Priority}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Titre et description -->
                            <StackPanel Grid.Row="1" Margin="0,13,0,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="38" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="33"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <!-- Pastille de statut, et le module de l'arbre auquel la
                                 carte appartient : le groupement se fait desormais par
                                 domaine, le module reste lisible ici plutot que de
                                 disparaitre avec les en-tetes composes. -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="statusPill"
                                        HorizontalAlignment="Left"
                                        CornerRadius="9"
                                        Padding="9,2.5"
                                        Background="{StaticResource ModuleStatusPlannedBackgroundBrush}">
                                    <TextBlock x:Name="statusPillText"
                                               Text="{Binding StatusLabel}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ModuleStatusPlannedForegroundBrush}" />
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ModuleLabel}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Couleurs par statut -->
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static desktop:ModuleStatus.Disponible}">
                            <Setter TargetName="statusPill" Property="Background" Value="{StaticResource ModuleStatusAvailableBackgroundBrush}" />
                            <Setter TargetName="statusPillText" Property="Foreground" Value="{StaticResource ModuleStatusAvailableForegroundBrush}" />
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="groupIcon" Property="Stroke" Value="{StaticResource AccentPressedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static desktop:ModuleStatus.ApiPrete}">
                            <Setter TargetName="statusPill" Property="Background" Value="{StaticResource ModuleStatusApiBackgroundBrush}" />
                            <Setter TargetName="statusPillText" Property="Foreground" Value="{StaticResource ModuleStatusApiForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static desktop:ModuleStatus.Partiel}">
                            <Setter TargetName="statusPill" Property="Background" Value="{StaticResource ModuleStatusPartialBackgroundBrush}" />
                            <Setter TargetName="statusPillText" Property="Foreground" Value="{StaticResource ModuleStatusPartialForegroundBrush}" />
                        </DataTrigger>

                        <!-- Carte non ouvrable : plus d'ombre, fond attenue, texte intact -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter TargetName="card" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>

                        <!-- Permission de lecture manquante : cadenas explicite -->
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter TargetName="lockIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="iconChip" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="groupIcon" Property="Stroke" Value="{StaticResource TextMutedBrush}" />
                        </DataTrigger>

                        <!-- Survol : elevation de 2px, bordure accent de marque.
                             Volontairement distinct du focus clavier (navy) : la
                             souris et le clavier ne doivent pas produire le meme
                             signal, sinon on ne sait plus lequel des deux parle. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-2"
                                                         Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.20"
                                                         Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0"
                                                         Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.07"
                                                         Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apparition de la vue Accueil : fondu + leger glissement, en cascade
         (trois blocs decales de 80 ms). Rejoue a chaque retour sur l'Accueil. -->
    <Style x:Key="HomeRevealStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="14"
                                             To="0"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeRevealDelayedStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             BeginTime="0:0:0.08"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="14"
                                             To="0"
                                             BeginTime="0:0:0.08"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- Maintient le bloc invisible pendant le delai de cascade. -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="0"
                                             Duration="0:0:0.08"
                                             FillBehavior="Stop" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeRevealDelayedMoreStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             BeginTime="0:0:0.16"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="14"
                                             To="0"
                                             BeginTime="0:0:0.16"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- Maintient le bloc invisible pendant le delai de cascade. -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="0"
                                             Duration="0:0:0.16"
                                             FillBehavior="Stop" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================= ToolTip ================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource StructureBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<UserControl x:Class="RaqmiSystem.Desktop.Views.DecCockpitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RaqmiSystem.Desktop.Views"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- Cockpit DEC : poste de controle quotidien de la Direction de l'Exploitation
         et du Controle. Files de travail en cartes sectionnees prioritaires (le
         nombre en gros, la liste triee par age decroissant en dessous), tableau de
         sante par unite, indicateurs de charge. Lecture pure : chaque ligne de file
         porte un bouton "Ouvrir" qui demande la navigation vers le module concerne
         via l'evenement NavigateRequested - jamais d'acces a MainWindow. -->

    <UserControl.Resources>
        <views:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================= En-tete d'ecran ========================= -->
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Cockpit DEC"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Ce qui exige une action aujourd'hui, unité par unité — l'état du groupe ce matin."
                               Style="{StaticResource SubtitleText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Date du cockpit" Style="{StaticResource LabelText}" />
                    <DatePicker x:Name="CockpitDatePicker"
                                ToolTip="Journée observée (aujourd'hui par défaut)" />
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Grid.Column="4"
                        Content="Actualiser"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Recharger le cockpit pour la date sélectionnée"
                        VerticalAlignment="Bottom"
                        Click="RefreshButton_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ==================== Indicateurs de charge ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Recettes à valider" Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="IndicatorPendingCountText"
                                       Text="—"
                                       Style="{StaticResource MetricValueText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Montant à valider" Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="IndicatorPendingAmountText"
                                       Text="—"
                                       Style="{StaticResource MetricValueText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Retard de clôture le plus ancien" Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="IndicatorOldestClosingText"
                                       Text="—"
                                       Style="{StaticResource MetricValueText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ File n°1 : recettes soumises a valider ============ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock x:Name="PendingValidationCountText"
                                       DockPanel.Dock="Left"
                                       Text="0"
                                       Style="{StaticResource MetricValueText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Recettes soumises en attente de validation"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="L'action quotidienne n°1 de la DEC — une ligne par unité, la plus ancienne d'abord."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="PendingValidationDataGrid" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Unité" Binding="{Binding HotelUnitCode}" Width="100" />
                                    <DataGridTextColumn Header="Désignation" Binding="{Binding HotelUnitName}" Width="180"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Count}" Width="80"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Montant total" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="130"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Plus ancienne" Binding="{Binding OldestBusinessDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                                    <DataGridTextColumn Header="Âge (jours)" Binding="{Binding OldestAgeDays}" Width="100"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTemplateColumn Width="*" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ouvrir"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="12,4"
                                                        HorizontalAlignment="Right"
                                                        ToolTip="Ouvrir le module Recettes journalières pour valider"
                                                        Click="OpenRevenueRow_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,18"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PendingValidationDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M5,8 L7.2,10.2 L11,5.8"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="40" Height="38" Stretch="Uniform"
                                      HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Aucune recette en attente de validation"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Toutes les recettes soumises ont été traitées."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ File n°2 : journees non cloturees ============ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock x:Name="ClosingBacklogCountText"
                                       DockPanel.Dock="Left"
                                       Text="0"
                                       Style="{StaticResource MetricValueText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Journées non clôturées antérieures à hier"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Une journée d'avant-hier non clôturée est un retard de process. La journée d'hier, elle, est le travail normal du jour (tableau de santé)."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="ClosingBacklogDataGrid" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Unité" Binding="{Binding HotelUnitCode}" Width="100" />
                                    <DataGridTextColumn Header="Désignation" Binding="{Binding HotelUnitName}" Width="180"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Journées" Binding="{Binding MissingCount}" Width="90"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Dates manquantes" Binding="{Binding MissingDatesDisplay}" Width="2*"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="La plus ancienne" Binding="{Binding OldestMissingDate, StringFormat={}{0:dd/MM/yyyy}}" Width="130" />
                                    <DataGridTextColumn Header="Âge (jours)" Binding="{Binding OldestAgeDays}" Width="100"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTemplateColumn Width="*" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ouvrir"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="12,4"
                                                        HorizontalAlignment="Right"
                                                        ToolTip="Ouvrir le module Clôture journalière"
                                                        Click="OpenClosingRow_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,18"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=ClosingBacklogDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="M4,7 V4.5 A4,4 0 0 1 12,4.5 V7 M2.5,7 H13.5 V14 H2.5 Z M8,9.5 V11.5"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="40" Height="38" Stretch="Uniform"
                                      HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Aucun retard de clôture"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Toutes les journées antérieures à hier sont clôturées."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ File n°3 : recettes rejetees a corriger ============ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock x:Name="RejectedCountText"
                                       DockPanel.Dock="Left"
                                       Text="0"
                                       Style="{StaticResource MetricValueText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Recettes rejetées en attente de correction"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Rejetées avec motif ; elles repassent en brouillon dès que l'unité les corrige."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="RejectedDataGrid" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Unité" Binding="{Binding HotelUnitCode}" Width="100" />
                                    <DataGridTextColumn Header="Désignation" Binding="{Binding HotelUnitName}" Width="170"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Date métier" Binding="{Binding BusinessDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                                    <DataGridTextColumn Header="Montant" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="120"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Motif du rejet" Binding="{Binding RejectionReason}" Width="2*" />
                                    <DataGridTextColumn Header="Rejetée le" Binding="{Binding RejectedAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130" />
                                    <DataGridTextColumn Header="Âge (jours)" Binding="{Binding AgeDays}" Width="100"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTemplateColumn Width="*" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ouvrir"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="12,4"
                                                        HorizontalAlignment="Right"
                                                        ToolTip="Ouvrir le module Recettes journalières pour suivre la correction"
                                                        Click="OpenRevenueRow_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,18"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=RejectedDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="M8,2.5 L14,13.5 H2 Z M8,7 V10 M8,11.5 V12"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="40" Height="38" Stretch="Uniform"
                                      HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Aucune recette rejetée en attente"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Aucune correction n'est attendue des unités."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ File n°4 : ordres de paiement en attente ============ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock x:Name="PaymentOrdersCountText"
                                       DockPanel.Dock="Left"
                                       Text="0"
                                       Style="{StaticResource MetricValueText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ordres de paiement en attente d'approbation"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Brouillons de la trésorerie, les plus anciens d'abord."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="PaymentOrdersDataGrid" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                                    <DataGridTextColumn Header="Bénéficiaire" Binding="{Binding Beneficiary}" Width="2*" />
                                    <DataGridTextColumn Header="Montant" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Échéance" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                                    <DataGridTextColumn Header="Compte" Binding="{Binding BankAccountCode}" Width="120"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Âge (jours)" Binding="{Binding AgeDays}" Width="100"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTemplateColumn Width="*" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ouvrir"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="12,4"
                                                        HorizontalAlignment="Right"
                                                        ToolTip="Ouvrir le module Trésorerie pour approuver"
                                                        Click="OpenTreasuryRow_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,18"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PaymentOrdersDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="M2.5,4.5 H13.5 V11.5 H2.5 Z M8,6.5 A1.5,1.5 0 1 1 8,9.5 A1.5,1.5 0 1 1 8,6.5"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="40" Height="38" Stretch="Uniform"
                                      HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Aucun ordre de paiement en attente"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Tous les ordres de paiement ont été approuvés, payés ou annulés."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================== Sante du jour par unite ================== -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Santé du jour par unité"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock x:Name="HealthSubtitleTextBlock"
                                       Text="Recette d'hier, clôture d'hier et occupation du jour. Une unité sans recette d'hier et sans clôture est surlignée."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="HealthDataGrid" MaxHeight="420">
                                <DataGrid.RowStyle>
                                    <!-- Teinte d'attention (teinte semantique "en attente" du
                                         theme) sur les unites sans recette d'hier exploitable
                                         et sans cloture d'hier : elles doivent sauter aux yeux. -->
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Unité" Binding="{Binding HotelUnitCode}" Width="100" />
                                    <DataGridTextColumn Header="Désignation" Binding="{Binding HotelUnitName}" Width="*"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Recette d'hier" Binding="{Binding RevenueDisplay}" Width="140"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTemplateColumn Header="Statut recette" Width="120" SortMemberPath="RevenueStatus">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RevenueBadge"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource StatusDraftBackgroundBrush}">
                                                    <TextBlock x:Name="RevenueBadgeText"
                                                               Text="Aucune"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource StatusDraftForegroundBrush}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RevenueStatus}" Value="Validated">
                                                        <Setter TargetName="RevenueBadge" Property="Background" Value="{StaticResource StatusValidatedBackgroundBrush}" />
                                                        <Setter TargetName="RevenueBadgeText" Property="Foreground" Value="{StaticResource StatusValidatedForegroundBrush}" />
                                                        <Setter TargetName="RevenueBadgeText" Property="Text" Value="Validée" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RevenueStatus}" Value="Submitted">
                                                        <Setter TargetName="RevenueBadge" Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
                                                        <Setter TargetName="RevenueBadgeText" Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
                                                        <Setter TargetName="RevenueBadgeText" Property="Text" Value="Soumise" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RevenueStatus}" Value="Draft">
                                                        <Setter TargetName="RevenueBadgeText" Property="Text" Value="Brouillon" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RevenueStatus}" Value="Rejected">
                                                        <Setter TargetName="RevenueBadge" Property="Background" Value="{StaticResource StatusRejectedBackgroundBrush}" />
                                                        <Setter TargetName="RevenueBadgeText" Property="Foreground" Value="{StaticResource StatusRejectedForegroundBrush}" />
                                                        <Setter TargetName="RevenueBadgeText" Property="Text" Value="Rejetée" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Journée d'hier" Width="130" SortMemberPath="YesterdayClosed">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ClosedBadge"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource StatusSubmittedBackgroundBrush}">
                                                    <TextBlock x:Name="ClosedBadgeText"
                                                               Text="Non clôturée"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource StatusSubmittedForegroundBrush}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding YesterdayClosed}" Value="True">
                                                        <Setter TargetName="ClosedBadge" Property="Background" Value="{StaticResource StatusValidatedBackgroundBrush}" />
                                                        <Setter TargetName="ClosedBadgeText" Property="Foreground" Value="{StaticResource StatusValidatedForegroundBrush}" />
                                                        <Setter TargetName="ClosedBadgeText" Property="Text" Value="Clôturée" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Occupation du jour" Binding="{Binding OccupancyDisplay}" Width="160"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,18"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=HealthDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="M3,13 V8 M8,13 V4 M13,13 V10"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="40" Height="38" Stretch="Uniform"
                                      HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Aucune unité active"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Créez ou activez des unités hôtelières pour suivre leur santé quotidienne ici."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>

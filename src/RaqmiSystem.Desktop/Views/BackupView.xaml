<UserControl x:Class="RaqmiSystem.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="700"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- ============================================================================
         Sauvegarde & restauration (volet applicatif) : carte d'etat de la derniere
         sauvegarde, liste des fichiers par palier de retention, declenchement d'une
         sauvegarde immediate. La restauration n'a volontairement AUCUN bouton ici :
         c'est une procedure d'administration serveur documentee, rappelee par
         l'encart dedie.
         ============================================================================ -->

    <UserControl.Resources>
        <!-- Bandeau d'avertissement de configuration : memes teintes semantiques que les
             badges Submitted (attention), aucune couleur en dur. -->
        <Style x:Key="ConfigWarningBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== Etat des sauvegardes ============================== -->
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Sauvegarde &amp; restauration"
                                   Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="Sauvegardes de la base de données du serveur : état, historique et déclenchement"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="RefreshButton"
                                Content="Actualiser"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Recharger l'état et la liste des sauvegardes"
                                Margin="0,0,10,0"
                                Click="RefreshButton_Click" />
                        <Button x:Name="TriggerBackupButton"
                                Content="Sauvegarder maintenant"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="Lancer immédiatement une sauvegarde de la base de données"
                                ToolTipService.ShowOnDisabled="True"
                                Click="TriggerBackupButton_Click" />
                    </StackPanel>
                </DockPanel>

                <!-- Trois indicateurs : derniere sauvegarde, anciennete, dossier configure. -->
                <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="DERNIÈRE SAUVEGARDE"
                                       Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="LastBackupValueTextBlock"
                                       Text="—"
                                       Style="{StaticResource MetricValueText}"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="LastBackupFileTextBlock"
                                       Text=""
                                       Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ANCIENNETÉ"
                                       Style="{StaticResource MetricLabelText}" />
                            <Border x:Name="AgeBadgeBorder"
                                    CornerRadius="10"
                                    Padding="12,4"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Background="{StaticResource StatusDraftBackgroundBrush}">
                                <TextBlock x:Name="AgeBadgeTextBlock"
                                           Text="—"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource StatusDraftForegroundBrush}" />
                            </Border>
                            <TextBlock x:Name="AgeCaptionTextBlock"
                                       Text=""
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="DOSSIER DE SAUVEGARDE"
                                       Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="BackupDirectoryTextBlock"
                                       Text="—"
                                       Style="{StaticResource BodyText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Dossier RAQMI_BACKUP_DIR du serveur"
                                       Margin="0,4,0,0" />
                            <!-- La retention (nombre de fichiers gardes par palier) est appliquee
                                 par la tache serveur deploy\onpremise\backup-raqmi.ps1 et n'est
                                 pas renvoyee par l'API : l'ecran nomme les paliers qu'il affiche
                                 et renvoie a la procedure, sans avancer de chiffres qu'il ne
                                 connait pas. -->
                            <TextBlock x:Name="RetentionCaptionTextBlock"
                                       Text="Rétention par paliers (quotidien, hebdomadaire, mensuel) appliquée par la tâche serveur — voir docs/deployment-onpremise.md."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Marche a suivre quand le serveur n'est pas configure : visible uniquement
                     dans ce cas, pilote par le code-behind. -->
                <Border x:Name="NotConfiguredBorder"
                        Grid.Row="3"
                        Style="{StaticResource ConfigWarningBorder}"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="NotConfiguredTitleTextBlock"
                                   Text="Dossier de sauvegarde non configuré sur le serveur"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource StatusSubmittedForegroundBrush}" />
                        <TextBlock x:Name="NotConfiguredDetailTextBlock"
                                   Text="Définissez la variable RAQMI_BACKUP_DIR (et RAQMI_PG_BIN) dans le fichier config\raqmi.env.ps1 du serveur — l'installeur deploy\onpremise\install-server.ps1 le fait automatiquement. Procédure complète : docs/deployment-onpremise.md, section « Backups »."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource StatusSubmittedForegroundBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== Encart restauration ============================== -->
        <!-- Volontairement sans bouton : une restauration en un clic sur la base de
             production serait irrattrapable. L'ecran dit ou est la procedure. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Restauration"
                           Style="{StaticResource SectionTitleText}" />
                <TextBlock Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    La restauration d'une sauvegarde est une procédure d'administration exécutée
                    directement sur le serveur (pg_restore vers une base de test, vérification,
                    puis bascule), jamais depuis cet écran : aucune action ici ne peut écraser la
                    base de production. La procédure pas à pas — restauration d'essai comprise —
                    est documentée dans docs/deployment-onpremise.md, sections « Testing a restore »
                    et « Go-live checklist ».
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============================== Liste des sauvegardes ============================== -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Sauvegardes disponibles"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock x:Name="BackupCountTextBlock"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="BackupsDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fichier"
                                                Binding="{Binding FileName}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="Palier" Width="150" SortMemberPath="Tier">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TierBadge"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource StatusDraftBackgroundBrush}">
                                            <TextBlock x:Name="TierBadgeText"
                                                       Text="{Binding TierLabel}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StatusDraftForegroundBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tier}" Value="weekly">
                                                <Setter TargetName="TierBadge" Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
                                                <Setter TargetName="TierBadgeText" Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tier}" Value="monthly">
                                                <Setter TargetName="TierBadge" Property="Background" Value="{StaticResource StatusValidatedBackgroundBrush}" />
                                                <Setter TargetName="TierBadgeText" Property="Foreground" Value="{StaticResource StatusValidatedForegroundBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Taille (Mo)"
                                                Binding="{Binding SizeMbLabel}"
                                                Width="130"
                                                SortMemberPath="SizeBytes"
                                                ElementStyle="{StaticResource AmountCellText}"
                                                HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding ModifiedLabel}"
                                                Width="160"
                                                SortMemberPath="ModifiedAtUtc"
                                                ElementStyle="{StaticResource MutedCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Etat vide : superpose a la grille tant qu'elle ne contient aucune ligne. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=BackupsDataGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource ModuleGroupIcon.Systeme}"
                              Stroke="{StaticResource BorderStrongBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="46"
                              Height="42"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock Text="Aucune sauvegarde à afficher"
                                   Style="{StaticResource EmptyStateTitleText}" />
                        <TextBlock Text="Lancez « Sauvegarder maintenant » ou attendez la tâche quotidienne du serveur."
                                   Style="{StaticResource EmptyStateHintText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="RaqmiSystem.Desktop.Views.PmsPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saisie"
        SizeToContent="Height"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <!-- Petite saisie modale du PMS : un message, un champ, deux boutons. Elle existe parce que
         plusieurs gestes du comptoir - motif d'un changement de chambre, date de remise en
         service - exigent UNE information et une seule, et qu'ouvrir un formulaire complet pour
         cela ralentirait la reception sans rien apporter. -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   Style="{StaticResource BodyText}" />

        <TextBox x:Name="AnswerTextBox"
                 Grid.Row="2"
                 KeyDown="AnswerTextBox_KeyDown" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    MinWidth="100"
                    Margin="0,0,10,0" />
            <Button Content="Valider"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    MinWidth="100"
                    Click="ValidateButton_Click" />
        </StackPanel>
    </Grid>
</Window>

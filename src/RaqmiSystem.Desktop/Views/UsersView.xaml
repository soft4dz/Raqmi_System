<UserControl x:Class="RaqmiSystem.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFontFamily}"
             Background="Transparent"
             IsVisibleChanged="UsersView_IsVisibleChanged"
             d:DesignWidth="1200"
             d:DesignHeight="820">

    <!-- ============================================================================
         Administration et utilisateurs : comptes, roles et actions de securite.

         Meme mise en page que le fichier clients (carte de formulaire en haut,
         liste en dessous), avec deux surfaces propres a ce module :
           - le selecteur de roles, a droite du formulaire, qui montre le libelle
             ET la description de chaque role pour que l'administrateur sache ce
             qu'il accorde ;
           - l'encart du mot de passe temporaire, que le serveur ne renvoie
             qu'une seule fois (creation et reinitialisation).

         Les garde-fous anti-verrouillage sont ceux du SERVEUR. Ce que fait cet
         ecran n'est qu'un miroir : griser une action condamnee evite de la
         decouvrir sur un refus, mais ne remplace jamais la regle serveur.
         ============================================================================ -->

    <UserControl.Resources>
        <!-- Precision affichee sous un champ dont la saisie obeit a une regle metier. -->
        <Style x:Key="FieldHintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Encart du mot de passe temporaire : couleurs d'avertissement, pour
             qu'un secret affiche une seule fois ne se confonde pas avec le reste
             du formulaire. -->
        <Style x:Key="SecretBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StatusSubmittedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style x:Key="SecretTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SecretHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Bloc "libelle / valeur" du detail du compte selectionne. -->
        <Style x:Key="DetailLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="DetailValueText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================== Recherche, fiche du compte et roles ================== -->
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Administration &amp; utilisateurs"
                                   Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="Comptes de connexion, rôles accordés et actions de sécurité"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBox x:Name="SearchTextBox"
                                 Width="250"
                                 Tag="Rechercher par identifiant, nom ou courriel"
                                 ToolTip="Filtrer les comptes par identifiant, nom affiché ou courriel, puis appuyer sur Entrée"
                                 MaxLength="160"
                                 Margin="0,0,12,0"
                                 KeyDown="SearchTextBox_KeyDown" />
                        <CheckBox x:Name="IncludeInactiveUsersCheckBox"
                                  Content="Inclure les comptes désactivés"
                                  ToolTip="Afficher aussi les comptes qui ne peuvent plus se connecter"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  Click="IncludeInactiveUsersCheckBox_Click" />
                        <Button x:Name="RefreshUsersButton"
                                Content="Actualiser"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Recharger la liste des comptes"
                                Click="RefreshUsersButton_Click" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- ========================= Fiche du compte ========================= -->
                    <Border Style="{StaticResource SubtleCardBorder}" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="FormTitleTextBlock"
                                       Text="Nouveau compte"
                                       Style="{StaticResource SectionTitleText}"
                                       FontSize="14"
                                       Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Identifiant de connexion" Style="{StaticResource LabelText}" />
                                    <!-- En modification, le champ passe en LECTURE SEULE plutot
                                         que desactive : la valeur reste lisible et copiable,
                                         alors qu'un champ grise se lit mal. -->
                                    <TextBox x:Name="UserNameTextBox"
                                             Tag="ex. n.benali"
                                             ToolTip="Nom d'utilisateur saisi sur l'écran de connexion"
                                             MaxLength="80" />
                                    <TextBlock x:Name="UserNameHintTextBlock"
                                               Style="{StaticResource FieldHintText}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nom affiché" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="DisplayNameTextBox"
                                             Tag="Prénom et nom de la personne"
                                             MaxLength="160" />
                                    <TextBlock Text="Nom présenté dans l'application et dans le journal d'audit."
                                               Style="{StaticResource FieldHintText}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Courriel" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="EmailTextBox"
                                         Tag="prenom.nom@exemple.dz"
                                         MaxLength="160" />
                                <TextBlock Text="Unique dans le système : il permet aussi de se connecter."
                                           Style="{StaticResource FieldHintText}" />
                            </StackPanel>

                            <!-- Actions de la fiche. Les actions d'ecriture sont grisees
                                 quand le profil ne detient pas users.write, et
                                 ShowOnDisabled laisse l'info-bulle dire pourquoi
                                 (voir UpdateActionButtons). -->
                            <DockPanel Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="NewUserButton"
                                            Content="Nouveau"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="Vider le formulaire pour créer un nouveau compte"
                                            Margin="0,0,10,0"
                                            Click="NewUserButton_Click" />

                                    <Button x:Name="SaveUserButton"
                                            Content="Créer le compte"
                                            Style="{StaticResource PrimaryButton}"
                                            ToolTip="Enregistrer la fiche du compte"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="SaveUserButton_Click" />
                                </StackPanel>

                                <WrapPanel>
                                    <Button x:Name="ActivateUserButton"
                                            Content="Activer"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Réactiver le compte sélectionné"
                                            ToolTipService.ShowOnDisabled="True"
                                            Margin="0,0,10,8"
                                            Click="ActivateUserButton_Click" />

                                    <Button x:Name="DeactivateUserButton"
                                            Content="Désactiver"
                                            Style="{StaticResource DangerButton}"
                                            ToolTip="Empêcher le compte sélectionné de se connecter"
                                            ToolTipService.ShowOnDisabled="True"
                                            Margin="0,0,10,8"
                                            Click="DeactivateUserButton_Click" />

                                    <Button x:Name="UnlockUserButton"
                                            Content="Déverrouiller"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Lever immédiatement le verrouillage pour échecs de connexion"
                                            ToolTipService.ShowOnDisabled="True"
                                            Margin="0,0,10,8"
                                            Click="UnlockUserButton_Click" />

                                    <Button x:Name="ResetPasswordButton"
                                            Content="Réinitialiser le mot de passe"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Générer un nouveau mot de passe temporaire pour ce compte"
                                            ToolTipService.ShowOnDisabled="True"
                                            Margin="0,0,10,8"
                                            Click="ResetPasswordButton_Click" />
                                </WrapPanel>
                            </DockPanel>

                            <!-- Mot de passe temporaire : le serveur ne le renvoie qu'une
                                 seule fois, aucune route ne permet de le relire. Il est
                                 donc affiche ici, en clair et en police a chasse fixe,
                                 tant que l'administrateur ne change pas de selection. -->
                            <Border x:Name="TemporaryPasswordBorder"
                                    Style="{StaticResource SecretBorder}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="HideTemporaryPasswordButton"
                                                DockPanel.Dock="Right"
                                                Content="Masquer"
                                                Style="{StaticResource GhostButton}"
                                                ToolTip="Effacer ce mot de passe de l'écran"
                                                VerticalAlignment="Top"
                                                Click="HideTemporaryPasswordButton_Click" />
                                        <TextBlock Text="Mot de passe temporaire — affiché une seule fois"
                                                   Style="{StaticResource SecretTitleText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                    </DockPanel>

                                    <TextBlock x:Name="TemporaryPasswordCaptionTextBlock"
                                               Style="{StaticResource SecretHintText}"
                                               Margin="0,6,0,0" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Zone de saisie en lecture seule, et non un simple
                                             libelle : le mot de passe reste selectionnable a la
                                             souris pour qui prefere ne pas passer par le
                                             presse-papiers. -->
                                        <TextBox x:Name="TemporaryPasswordTextBox"
                                                 IsReadOnly="True"
                                                 FontFamily="Consolas, Courier New"
                                                 FontSize="16"
                                                 ToolTip="Mot de passe temporaire à remettre au titulaire du compte" />

                                        <Button x:Name="CopyTemporaryPasswordButton"
                                                Grid.Column="2"
                                                Content="Copier"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Copier le mot de passe temporaire dans le presse-papiers"
                                                Click="CopyTemporaryPasswordButton_Click" />
                                    </Grid>

                                    <TextBlock Text="Ce mot de passe ne sera PLUS JAMAIS affiché : copiez-le maintenant et remettez-le à son titulaire par un canal sûr. Il devra le changer dès sa première connexion."
                                               Style="{StaticResource SecretHintText}"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===================== Affectation des roles ===================== -->
                    <Border Grid.Column="2" Style="{StaticResource SubtleCardBorder}" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="RolesTitleTextBlock"
                                       Text="Rôles du nouveau compte"
                                       Style="{StaticResource SectionTitleText}"
                                       FontSize="14" />
                            <TextBlock x:Name="RolesHintTextBlock"
                                       Style="{StaticResource FieldHintText}"
                                       Margin="0,4,0,10" />

                            <Grid>
                                <ScrollViewer MaxHeight="230"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RolesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0,0,0,10"
                                                          VerticalContentAlignment="Top">
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Etat vide : superpose a la liste tant qu'aucun role n'a
                                     ete recu du serveur. -->
                                <TextBlock x:Name="RolesEmptyTextBlock"
                                           Text="Aucun rôle n'est défini sur le serveur."
                                           Style="{StaticResource EmptyStateHintText}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>

                            <Button x:Name="SaveRolesButton"
                                    Content="Enregistrer les rôles"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="Remplacer les rôles du compte sélectionné par ceux cochés ci-dessus"
                                    ToolTipService.ShowOnDisabled="True"
                                    HorizontalAlignment="Right"
                                    Margin="0,6,0,0"
                                    Click="SaveRolesButton_Click" />

                            <Border Height="1"
                                    Background="{StaticResource PanelBorderBrush}"
                                    Margin="0,16,0,0" />

                            <TextBlock Text="Permissions effectives"
                                       Style="{StaticResource DetailLabelText}" />
                            <TextBlock x:Name="EffectivePermissionsTextBlock"
                                       Style="{StaticResource DetailValueText}" />

                            <TextBlock x:Name="AccountTraceTextBlock"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================= Liste des comptes ============================= -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Comptes"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock x:Name="UserCountTextBlock"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="UsersDataGrid"
                              SelectionChanged="UsersDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Identifiant" Binding="{Binding UserName}" Width="150" />
                            <DataGridTextColumn Header="Nom affiché" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Courriel"
                                                Binding="{Binding Email}"
                                                Width="220"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Rôles" Binding="{Binding RolesText}" Width="200" />

                            <DataGridTemplateColumn Header="Statut" Width="130" SortMemberPath="StatusKind">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadge"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding StatusTooltip}"
                                                Background="{StaticResource StatusValidatedBackgroundBrush}">
                                            <TextBlock x:Name="StatusBadgeText"
                                                       Text="Actif"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StatusValidatedForegroundBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Un compte desactive l'emporte sur un verrouillage :
                                                 il ne peut de toute facon plus se connecter. -->
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Inactive">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusDraftBackgroundBrush}" />
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusDraftForegroundBrush}" />
                                                <Setter TargetName="StatusBadgeText" Property="Text" Value="Désactivé" />
                                            </DataTrigger>
                                            <!-- Casse de phrase et teinte Rejected, conformement a la
                                                 table des badges de la charte (Verrouille = refus). -->
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Locked">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusRejectedBackgroundBrush}" />
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusRejectedForegroundBrush}" />
                                                <Setter TargetName="StatusBadgeText" Property="Text" Value="Verrouillé" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Doit changer son mot de passe"
                                                Binding="{Binding MustChangePasswordText}"
                                                Width="200"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Dernière connexion"
                                                Binding="{Binding LastLoginText}"
                                                Width="170"
                                                ElementStyle="{StaticResource MutedCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Etat vide : superpose a la grille tant qu'elle ne contient aucune ligne. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=UsersDataGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource ModuleGroupIcon.Socle}"
                              Stroke="{StaticResource BorderStrongBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="46"
                              Height="42"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock Text="Aucun compte à afficher"
                                   Style="{StaticResource EmptyStateTitleText}" />
                        <TextBlock Text="Élargissez la recherche, cochez « Inclure les comptes désactivés » ou créez un compte ci-dessus."
                                   Style="{StaticResource EmptyStateHintText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="RaqmiSystem.Desktop.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="700"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- ============================================================================
         Module 29 - Registre des postes & erreurs clients.

         Cet ecran ne synchronise RIEN et ne comporte AUCUN bouton d'ecriture. Il est
         en lecture seule de bout en bout : tous les postes ecrivent deja dans la meme
         base PostgreSQL a travers la meme API, il n'y a donc aucun etat a reconcilier.

         Vocabulaire : on n'ecrit jamais "en ligne" ni "connecte". Le serveur n'apprend
         jamais qu'un poste a ete eteint - un client lourd n'a aucun moyen fiable
         d'annoncer sa propre mort. Tout ce qui est honnetement affichable est la date
         du DERNIER CONTACT, et une fraicheur calculee par le serveur a partir d'elle.
         ============================================================================ -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="1.1*" />
        </Grid.RowDefinitions>

        <!-- ============================== Synthese ============================== -->
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Registre des postes &amp; erreurs clients"
                                   Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="Postes déclarés, dernier contact et erreurs remontées par les clients"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="IncludeAllKnownCheckBox"
                                  Content="Afficher tous les postes connus"
                                  VerticalAlignment="Center"
                                  ToolTip="Par défaut, seuls les postes vus depuis 30 jours sont listés"
                                  Margin="0,0,14,0"
                                  Checked="IncludeAllKnownCheckBox_Changed"
                                  Unchecked="IncludeAllKnownCheckBox_Changed" />
                        <Button x:Name="RefreshButton"
                                Content="Actualiser"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Recharger le registre et le journal des erreurs"
                                Click="RefreshButton_Click" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="POSTES LISTÉS"
                                       Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="StationCountTextBlock"
                                       Text="—"
                                       Style="{StaticResource MetricValueText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SANS CONTACT RÉCENT"
                                       Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="StaleCountTextBlock"
                                       Text="—"
                                       Style="{StaticResource MetricValueText}"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="ThresholdCaptionTextBlock"
                                       Text=""
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Le chiffre reellement utile de ce module : plusieurs versions en
                             service contre la meme API est un danger d'exploitation. -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="VERSIONS EN SERVICE"
                                       Style="{StaticResource MetricLabelText}" />
                            <Border x:Name="VersionBadgeBorder"
                                    CornerRadius="10"
                                    Padding="12,4"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Background="{StaticResource StatusDraftBackgroundBrush}">
                                <TextBlock x:Name="VersionBadgeTextBlock"
                                           Text="—"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource StatusDraftForegroundBrush}" />
                            </Border>
                            <TextBlock x:Name="VersionCaptionTextBlock"
                                       Text=""
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="CE POSTE"
                                       Style="{StaticResource MetricLabelText}" />
                            <TextBlock x:Name="ThisStationTextBlock"
                                       Text="—"
                                       Style="{StaticResource BodyText}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="ServerTimeTextBlock"
                                       Text=""
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== Perimetre assume ==============================
             Encart volontairement franc. Le module s'appelait "Synchronisation
             multi-postes" dans l'ancien produit, ou chaque poste portait sa propre base
             locale. Laisser croire qu'une file existe ici serait un mensonge. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Ce que cet écran montre, et ce qu'il ne fait pas"
                           Style="{StaticResource SectionTitleText}" />
                <TextBlock Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    Aucune synchronisation n'a lieu ici, et aucune n'est nécessaire : tous les postes
                    écrivent dans la même base de données, sur le même serveur. Il n'existe donc pas de
                    file d'attente ni de données à faire converger. Cet écran rend les pannes
                    <Run FontWeight="SemiBold">visibles après coup</Run> ; il ne les atténue pas et ne
                    permet pas de travailler serveur éteint. Le registre est alimenté par les postes
                    eux-mêmes, qui déclarent leur nom et leur version sans que le serveur ne les
                    vérifie : c'est un inventaire d'exploitation, jamais une pièce justificative.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============================== Postes declares ============================== -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Postes déclarés"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock x:Name="StationsCaptionTextBlock"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="StationsDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Poste"
                                                Binding="{Binding Label}"
                                                Width="*" />
                            <DataGridTextColumn Header="Dernier utilisateur"
                                                Binding="{Binding LastUserName}"
                                                Width="160" />
                            <DataGridTextColumn Header="Version"
                                                Binding="{Binding AppVersion}"
                                                Width="120" />
                            <!-- "Derniere unite" et non "Unite" : c'est l'unite selectionnee sur
                                 l'ecran CA au dernier contact, seul contexte d'unite dont dispose
                                 le client. Le titre dit ce que la donnee est reellement. -->
                            <DataGridTextColumn Header="Dernière unité"
                                                Binding="{Binding HotelUnitLabel}"
                                                Width="120" />
                            <DataGridTemplateColumn Header="Fraîcheur" Width="170" SortMemberPath="MinutesSinceLastContact">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Etat neutre par defaut : un poste eteint la nuit n'est
                                             PAS une erreur, donc jamais de teinte Rejected ici. -->
                                        <Border x:Name="FreshnessBadge"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource StatusValidatedBackgroundBrush}">
                                            <TextBlock x:Name="FreshnessBadgeText"
                                                       Text="{Binding FreshnessLabel}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StatusValidatedForegroundBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Freshness}" Value="Stale">
                                                <Setter TargetName="FreshnessBadge" Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
                                                <Setter TargetName="FreshnessBadgeText" Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Freshness}" Value="Silent">
                                                <Setter TargetName="FreshnessBadge" Property="Background" Value="{StaticResource StatusDraftBackgroundBrush}" />
                                                <Setter TargetName="FreshnessBadgeText" Property="Foreground" Value="{StaticResource StatusDraftForegroundBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dernier contact"
                                                Binding="{Binding LastSeenLabel}"
                                                Width="160"
                                                SortMemberPath="MinutesSinceLastContact"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Premier contact"
                                                Binding="{Binding FirstSeenLabel}"
                                                Width="160"
                                                ElementStyle="{StaticResource MutedCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=StationsDataGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource ModuleGroupIcon.Systeme}"
                              Stroke="{StaticResource BorderStrongBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="46"
                              Height="42"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock Text="Aucun poste déclaré"
                                   Style="{StaticResource EmptyStateTitleText}" />
                        <TextBlock Text="Un poste apparaît ici après sa première connexion. Un poste qui ne s'est jamais connecté n'est pas recensé."
                                   Style="{StaticResource EmptyStateHintText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================== Erreurs remontees ============================== -->
        <Border Grid.Row="6" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Erreurs remontées par les postes"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock x:Name="FailuresCaptionTextBlock"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="FailuresDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Poste"
                                                Binding="{Binding WorkstationLabel}"
                                                Width="150" />
                            <DataGridTextColumn Header="Nature"
                                                Binding="{Binding KindLabel}"
                                                Width="130" />
                            <DataGridTextColumn Header="Appel"
                                                Binding="{Binding CallLabel}"
                                                Width="*"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Signalé le"
                                                Binding="{Binding RecordedLabel}"
                                                Width="160"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Écart d'horloge"
                                                Binding="{Binding ClockDriftLabel}"
                                                Width="140"
                                                SortMemberPath="ClockDriftSeconds"
                                                ElementStyle="{StaticResource MutedCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=FailuresDataGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource ModuleGroupIcon.Systeme}"
                              Stroke="{StaticResource BorderStrongBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="46"
                              Height="42"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock Text="Aucune erreur remontée"
                                   Style="{StaticResource EmptyStateTitleText}" />
                        <TextBlock Text="Un poste ne peut signaler ses erreurs qu'une fois le lien rétabli : cette liste ne prétend pas être exhaustive."
                                   Style="{StaticResource EmptyStateHintText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

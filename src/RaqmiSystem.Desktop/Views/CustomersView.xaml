<UserControl x:Class="RaqmiSystem.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="700">

    <!-- ============================================================================
         Fichier clients : recherche, fiche client (identifiants fiscaux algeriens)
         et liste. La mise en page reprend celle des recettes journalieres :
         carte de formulaire en haut, liste en dessous.
         ============================================================================ -->

    <UserControl.Resources>
        <!-- Precision affichee sous un champ dont la saisie obeit a une regle metier. -->
        <Style x:Key="FieldHintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== Recherche et fiche client ======================== -->
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Fichier clients"
                                   Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="Référentiel des clients facturés et de leurs identifiants fiscaux"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBox x:Name="SearchTextBox"
                                 Width="250"
                                 Tag="Rechercher par code ou nom"
                                 ToolTip="Filtrer les clients par code ou par nom, puis appuyer sur Entrée"
                                 MaxLength="200"
                                 Margin="0,0,12,0"
                                 KeyDown="SearchTextBox_KeyDown" />
                        <CheckBox x:Name="IncludeInactiveCustomersCheckBox"
                                  Content="Inclure les clients inactifs"
                                  ToolTip="Afficher aussi les clients désactivés"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  Click="IncludeInactiveCustomersCheckBox_Click" />
                        <Button x:Name="RefreshCustomersButton"
                                Content="Actualiser"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Recharger le fichier clients"
                                Click="RefreshCustomersButton_Click" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <!-- Espacement masque en meme temps que le bloc fiscal,
                                 pour ne pas laisser un trou dans le formulaire. -->
                            <RowDefinition x:Name="FiscalSpacerRow" Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="FormTitleTextBlock"
                                   Text="Nouveau client"
                                   Style="{StaticResource SectionTitleText}"
                                   FontSize="14"
                                   Margin="0,0,0,4" />

                        <!-- Identite -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Code" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerCodeTextBox"
                                         Tag="ex. CLI-0001"
                                         MaxLength="40" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nom" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerNameTextBox"
                                         Tag="Raison sociale ou nom du client"
                                         MaxLength="200" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Type de client" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="CustomerTypeComboBox"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectionChanged="CustomerTypeComboBox_SelectionChanged" />
                                <TextBlock x:Name="IndividualHintTextBlock"
                                           Text="Les identifiants fiscaux ne s'appliquent pas à un particulier."
                                           Style="{StaticResource FieldHintText}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- Identifiants fiscaux algeriens : masques pour un client
                             particulier, a qui ils ne s'appliquent pas. -->
                        <Grid x:Name="FiscalIdentifiersGrid" Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="NIF" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerNifTextBox"
                                         Tag="Numéro d'identification fiscale"
                                         ToolTip="Numéro d'identification fiscale : exactement 15 chiffres"
                                         MaxLength="15" />
                                <TextBlock Text="Facultatif — s'il est renseigné, exactement 15 chiffres."
                                           Style="{StaticResource FieldHintText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RC" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerRcTextBox"
                                         Tag="Registre du commerce"
                                         MaxLength="20" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AI" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerAiTextBox"
                                         Tag="Article d'imposition"
                                         MaxLength="20" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="NIS" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerNisTextBox"
                                         Tag="Identification statistique"
                                         MaxLength="20" />
                            </StackPanel>
                        </Grid>

                        <!-- Coordonnees -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Adresse" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerAddressTextBox"
                                         Tag="Adresse du client"
                                         MaxLength="200" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ville" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerCityTextBox" MaxLength="80" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Téléphone" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerPhoneTextBox" MaxLength="40" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Courriel" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="CustomerEmailTextBox"
                                         Tag="contact@exemple.dz"
                                         MaxLength="160" />
                            </StackPanel>
                        </Grid>

                        <!-- Actions de la fiche -->
                        <StackPanel Grid.Row="8"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="NewCustomerButton"
                                    Content="Nouveau"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="Vider le formulaire pour créer un nouveau client"
                                    Margin="0,0,10,0"
                                    Click="NewCustomerButton_Click" />

                            <!-- Les trois actions d'ecriture sont grisees quand le profil ne
                                 detient pas customers.write : ShowOnDisabled laisse alors
                                 l'info-bulle expliquer pourquoi (voir UpdateActionButtons). -->
                            <Button x:Name="SaveCustomerButton"
                                    Content="Créer le client"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="Enregistrer la fiche client"
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="0,0,10,0"
                                    Click="SaveCustomerButton_Click" />

                            <Button x:Name="ActivateCustomerButton"
                                    Content="Activer"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Réactiver le client sélectionné"
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="0,0,10,0"
                                    Click="ActivateCustomerButton_Click" />

                            <Button x:Name="DeactivateCustomerButton"
                                    Content="Désactiver"
                                    Style="{StaticResource DangerButton}"
                                    ToolTip="Désactiver le client sélectionné"
                                    ToolTipService.ShowOnDisabled="True"
                                    Click="DeactivateCustomerButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== Liste des clients ============================== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Clients"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock x:Name="CustomerCountTextBlock"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="CustomersDataGrid"
                              SelectionChanged="CustomersDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding CustomerTypeLabel}" Width="150" />
                            <DataGridTextColumn Header="NIF"
                                                Binding="{Binding Nif}"
                                                Width="160"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Ville" Binding="{Binding City}" Width="140" />
                            <DataGridTextColumn Header="Téléphone"
                                                Binding="{Binding Phone}"
                                                Width="140"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTemplateColumn Header="Actif" Width="110" SortMemberPath="IsActive">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ActiveBadge"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource StatusValidatedBackgroundBrush}">
                                            <TextBlock x:Name="ActiveBadgeText"
                                                       Text="Actif"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StatusValidatedForegroundBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="ActiveBadge" Property="Background" Value="{StaticResource StatusDraftBackgroundBrush}" />
                                                <Setter TargetName="ActiveBadgeText" Property="Foreground" Value="{StaticResource StatusDraftForegroundBrush}" />
                                                <Setter TargetName="ActiveBadgeText" Property="Text" Value="Inactif" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Etat vide : superpose a la grille tant qu'elle ne contient aucune ligne. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=CustomersDataGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource ModuleGroupIcon.RessourcesHumaines}"
                              Stroke="{StaticResource BorderStrongBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="46"
                              Height="42"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock Text="Aucun client à afficher"
                                   Style="{StaticResource EmptyStateTitleText}" />
                        <TextBlock Text="Élargissez la recherche ou créez un premier client ci-dessus."
                                   Style="{StaticResource EmptyStateHintText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="RaqmiSystem.Desktop.Views.HumanResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="900"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- ============================================================================
         Ressources humaines & paie. Quatre sections, dans l'ordre du cycle metier :
         Collaborateurs (annuaire, fiche, contrats), Temps & absences, Paie du mois,
         Referentiel (departements, postes, baremes legaux).

         Deux regles de cet ecran ne sont pas cosmetiques :
         - la CLOTURE de la paie est le seul bouton Danger, et demande confirmation :
           elle est irreversible et verrouille le mois cote serveur ;
         - l'annuaire n'affiche AUCUN identifiant legal (NIN, NSS, RIB). Ces donnees
           n'apparaissent que dans la fiche, dont la lecture est journalisee.
         ============================================================================ -->

    <UserControl.Resources>
        <!-- Gabarit d'onglets de section (repris de TreasuryView / ApprovalsView) : le
             TabControl par defaut de WPF ne rend pas le style de la charte. -->
        <Style x:Key="SectionTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="tabBackground"
                                    Background="Transparent"
                                    CornerRadius="6,6,0,0"
                                    Padding="18,9">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>

                            <Rectangle x:Name="tabIndicator"
                                       Grid.Row="1"
                                       Height="2.5"
                                       Fill="{StaticResource AccentBrush}"
                                       Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SectionTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Margin="0,16,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FormField" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================ Bandeau ================================ -->
        <Border Style="{StaticResource CardBorder}">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Ressources humaines &amp; paie"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Collaborateurs, contrats, temps et absences, et cycle de paie algérien"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Content="Actualiser"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                        Click="OnRefreshClick" />
            </DockPanel>
        </Border>

        <TabControl x:Name="SectionTabs"
                    Grid.Row="2"
                    Style="{StaticResource SectionTabControl}"
                    SelectionChanged="OnSectionChanged">

            <!-- ========================== 1. Collaborateurs ========================== -->
            <TabItem Header="Collaborateurs">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Annuaire" Style="{StaticResource SectionTitleText}" />

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <ComboBox x:Name="EmployeeStatusFilterComboBox"
                                              Width="150"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="OnEmployeeFilterChanged"
                                              Margin="0,0,8,0" />

                                    <TextBox x:Name="SearchTextBox"
                                             Width="220"
                                             VerticalContentAlignment="Center"
                                             KeyDown="OnSearchKeyDown"
                                             ToolTip="Rechercher par matricule ou par nom, puis Entrée." />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="EmployeesDataGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="OnEmployeeSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeNumber}" Width="110" />
                                    <DataGridTextColumn Header="Nom" Binding="{Binding LastName}" Width="*" />
                                    <DataGridTextColumn Header="Prénom" Binding="{Binding FirstName}" Width="*" />
                                    <DataGridTextColumn Header="Poste" Binding="{Binding PositionLabel}" Width="*" />
                                    <DataGridTextColumn Header="Unité" Binding="{Binding HotelUnitCode}" Width="80" />
                                    <DataGridTextColumn Header="Statut"
                                                        Binding="{Binding Status}"
                                                        ElementStyle="{StaticResource MutedCellText}"
                                                        Width="100" />
                                    <DataGridTextColumn Header="Salaire brut"
                                                        Binding="{Binding ActiveContractGrossSalary, StringFormat=N2}"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                        Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Fiche du collaborateur et ses contrats -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="EmployeeFormTitleTextBlock"
                                               Text="Nouveau collaborateur"
                                               Style="{StaticResource SectionTitleText}" />

                                    <Button x:Name="NewEmployeeButton"
                                            DockPanel.Dock="Right"
                                            Content="Nouveau"
                                            Style="{StaticResource GhostButton}"
                                            Click="OnNewEmployeeClick" />
                                </DockPanel>

                                <TextBlock Text="Identité" Style="{StaticResource LabelText}" Margin="0,14,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Matricule" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="EmployeeNumberTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Date d'embauche" Style="{StaticResource FormLabel}" />
                                        <DatePicker x:Name="HireDatePicker" Margin="0,0,0,10" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Nom" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="LastNameTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Prénom" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="FirstNameTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="Unité" Style="{StaticResource FormLabel}" />
                                        <ComboBox x:Name="EmployeeUnitComboBox" Style="{StaticResource FormCombo}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Poste" Style="{StaticResource FormLabel}" />
                                        <ComboBox x:Name="EmployeePositionComboBox"
                                                  Style="{StaticResource FormCombo}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Code" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3">
                                        <TextBlock Text="E-mail" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="EmployeeEmailTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="2">
                                        <TextBlock Text="Téléphone" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="EmployeePhoneTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Identifiants légaux et paie" Style="{StaticResource LabelText}" Margin="0,6,0,4" />
                                <TextBlock Text="Données personnelles protégées par la loi 18-07 : chaque consultation de cette fiche est journalisée."
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="NIN" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="NationalIdentityTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NSS" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="SocialSecurityTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="RIB" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BankAccountTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Badge pointeuse" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BadgeTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="Enfants à charge" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="DependentChildrenTextBox"
                                                 Style="{StaticResource FormField}"
                                                 ToolTip="Chaque enfant à charge augmente l'abattement IRG et donc le net à payer." />
                                    </StackPanel>
                                </Grid>

                                <!-- Date et motif de la fin de relation : la fin de contrat est
                                     datee, elle ne peut pas etre implicitement "aujourd'hui". -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Date de fin" Style="{StaticResource FormLabel}" />
                                        <DatePicker x:Name="TerminationDatePicker" Margin="0,0,0,10" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Motif de la fin" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="TerminationReasonTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="SaveEmployeeButton"
                                            Content="Enregistrer"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnSaveEmployeeClick"
                                            Margin="0,0,8,8" />

                                    <Button x:Name="SuspendEmployeeButton"
                                            Content="Suspendre"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnSuspendEmployeeClick"
                                            Margin="0,0,8,8" />

                                    <Button x:Name="ReactivateEmployeeButton"
                                            Content="Réactiver"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnReactivateEmployeeClick"
                                            Margin="0,0,8,8" />

                                    <Button x:Name="TerminateEmployeeButton"
                                            Content="Fin de relation"
                                            Style="{StaticResource DangerButton}"
                                            Click="OnTerminateEmployeeClick"
                                            ToolTip="Clôt le dossier et met fin au contrat actif à la date indiquée."
                                            Margin="0,0,0,8" />
                                </WrapPanel>

                                <!-- =============================== Contrats =============================== -->
                                <TextBlock Text="Contrats" Style="{StaticResource SectionTitleText}" Margin="0,14,0,8" />

                                <DataGrid x:Name="ContractsDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          MaxHeight="160"
                                          Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                                        <DataGridTextColumn Header="Début" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="90" />
                                        <DataGridTextColumn Header="Fin" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="90" />
                                        <DataGridTextColumn Header="Brut"
                                                            Binding="{Binding GrossSalary, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="110" />
                                        <DataGridTextColumn Header="H/sem."
                                                            Binding="{Binding WeeklyHours, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="70" />
                                        <DataGridTextColumn Header="Statut"
                                                            Binding="{Binding Status}"
                                                            ElementStyle="{StaticResource MutedCellText}"
                                                            Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Type" Style="{StaticResource FormLabel}" />
                                        <ComboBox x:Name="ContractTypeComboBox" Style="{StaticResource FormCombo}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Début" Style="{StaticResource FormLabel}" />
                                        <DatePicker x:Name="ContractStartDatePicker" Margin="0,0,0,10" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Fin (CDD)" Style="{StaticResource FormLabel}" />
                                        <DatePicker x:Name="ContractEndDatePicker" Margin="0,0,0,10" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Salaire brut" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="ContractGrossSalaryTextBox" Style="{StaticResource FormField}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Heures / semaine" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="ContractWeeklyHoursTextBox" Style="{StaticResource FormField}" Text="40" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="4" VerticalAlignment="Bottom">
                                        <Button x:Name="AddContractButton"
                                                Content="Ajouter le contrat"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnAddContractClick"
                                                Margin="0,0,0,10" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================= 2. Temps & absences ========================= -->
            <TabItem Header="Temps &amp; absences">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Pointages" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Seules les heures validées alimentent la paie."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                                    <DatePicker x:Name="TimeFromDatePicker" Width="120" Margin="0,0,6,0" />
                                    <DatePicker x:Name="TimeToDatePicker" Width="120" Margin="0,0,6,0" />
                                    <Button Content="Filtrer"
                                            Style="{StaticResource GhostButton}"
                                            Click="OnReloadTimeClick" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="TimeEntriesDataGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding WorkDate, StringFormat=dd/MM/yyyy}" Width="95" />
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeNumber}" Width="100" />
                                    <DataGridTextColumn Header="Collaborateur" Binding="{Binding EmployeeFullName}" Width="*" />
                                    <DataGridTextColumn Header="Heures"
                                                        Binding="{Binding HoursWorked, StringFormat=N2}"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Source"
                                                        Binding="{Binding Source}"
                                                        ElementStyle="{StaticResource MutedCellText}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Statut"
                                                        Binding="{Binding Status}"
                                                        ElementStyle="{StaticResource MutedCellText}"
                                                        Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Collaborateur" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="TimeEmployeeComboBox"
                                              Style="{StaticResource FormCombo}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Jour" Style="{StaticResource FormLabel}" />
                                    <DatePicker x:Name="TimeEntryDatePicker" Margin="0,0,0,10" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Heures" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="TimeEntryHoursTextBox" Style="{StaticResource FormField}" Text="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                    <Button x:Name="SaveTimeEntryButton"
                                            Content="Enregistrer"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnSaveTimeEntryClick"
                                            Margin="0,0,0,10" />
                                </StackPanel>

                                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                                    <Button x:Name="ValidateTimeEntryButton"
                                            Content="Valider"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnValidateTimeEntryClick"
                                            ToolTip="Valide le pointage sélectionné pour qu'il alimente la pré-paie."
                                            Margin="0,0,0,10" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Absences" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Seules les absences approuvées et sans solde réduisent le salaire."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>

                                <ComboBox x:Name="AbsenceStatusFilterComboBox"
                                          DockPanel.Dock="Right"
                                          Width="150"
                                          VerticalAlignment="Top"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="OnAbsenceFilterChanged" />
                            </DockPanel>

                            <DataGrid x:Name="AbsencesDataGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeNumber}" Width="100" />
                                    <DataGridTextColumn Header="Collaborateur" Binding="{Binding EmployeeFullName}" Width="*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                                    <DataGridTextColumn Header="Du" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="90" />
                                    <DataGridTextColumn Header="Au" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="90" />
                                    <DataGridTextColumn Header="Jours"
                                                        Binding="{Binding TotalDays}"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                        Width="60" />
                                    <DataGridCheckBoxColumn Header="Sans solde" Binding="{Binding IsUnpaid}" Width="85" />
                                    <DataGridTextColumn Header="Statut"
                                                        Binding="{Binding Status}"
                                                        ElementStyle="{StaticResource MutedCellText}"
                                                        Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Collaborateur" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="AbsenceEmployeeComboBox"
                                              Style="{StaticResource FormCombo}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Type" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="AbsenceTypeComboBox" Style="{StaticResource FormCombo}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Du" Style="{StaticResource FormLabel}" />
                                    <DatePicker x:Name="AbsenceStartDatePicker" Margin="0,0,0,10" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Au" Style="{StaticResource FormLabel}" />
                                    <DatePicker x:Name="AbsenceEndDatePicker" Margin="0,0,0,10" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                                    <TextBlock Text="Motif" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="AbsenceReasonTextBox" Style="{StaticResource FormField}" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" VerticalAlignment="Bottom">
                                    <Button x:Name="CreateAbsenceButton"
                                            Content="Créer"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnCreateAbsenceClick"
                                            Margin="0,0,6,10" />

                                    <Button x:Name="ApproveAbsenceButton"
                                            Content="Approuver"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnApproveAbsenceClick"
                                            Margin="0,0,6,10" />

                                    <Button x:Name="RejectAbsenceButton"
                                            Content="Refuser"
                                            Style="{StaticResource GhostButton}"
                                            Click="OnRejectAbsenceClick"
                                            Margin="0,0,0,10" />
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================== 3. Paie =============================== -->
            <TabItem Header="Paie du mois">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Période"
                                           Style="{StaticResource FilterRowLabelText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <TextBox x:Name="PeriodTextBox"
                                         Width="110"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Période de paie au format AAAA-MM (par exemple 2026-08)." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="GenerateButton"
                                        Content="Générer la pré-paie"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="OnGenerateClick"
                                        ToolTip="Recalcule les bulletins en brouillon du mois. Les bulletins déjà validés ne sont pas touchés."
                                        Margin="0,0,8,0" />

                                <Button x:Name="ValidatePayslipButton"
                                        Content="Valider le bulletin"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnValidatePayslipClick"
                                        Margin="0,0,8,0" />

                                <Button x:Name="ValidatePeriodButton"
                                        Content="Valider la période"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnValidatePeriodClick"
                                        ToolTip="Marque le mois comme entièrement contrôlé. Refusé tant qu'un bulletin reste en brouillon."
                                        Margin="0,0,8,0" />

                                <Button x:Name="ClosePeriodButton"
                                        Content="Clôturer"
                                        Style="{StaticResource DangerButton}"
                                        Click="OnClosePeriodClick"
                                        ToolTip="Verrouille définitivement le mois." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SubtleCardBorder}">
                            <StackPanel>
                                <TextBlock Text="Statut de la période" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="PeriodStatusTextBlock" Text="—" Style="{StaticResource MetricValueText}" />
                                <TextBlock x:Name="PeriodStatusDetailTextBlock" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SubtleCardBorder}">
                            <StackPanel>
                                <TextBlock Text="Bulletins" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="PayslipCountTextBlock" Text="—" Style="{StaticResource MetricValueText}" />
                                <TextBlock x:Name="DraftCountTextBlock" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource SubtleCardBorder}">
                            <StackPanel>
                                <TextBlock Text="Brut imposable" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="TotalGrossTextBlock" Text="—" Style="{StaticResource MetricValueText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource SubtleCardBorder}">
                            <StackPanel>
                                <TextBlock Text="Net à payer" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="TotalNetTextBlock" Text="—" Style="{StaticResource MetricValueText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="8" Style="{StaticResource SubtleCardBorder}">
                            <StackPanel>
                                <TextBlock Text="Coût employeur" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="TotalEmployerCostTextBlock" Text="—" Style="{StaticResource MetricValueText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Bulletins du mois" Style="{StaticResource SectionTitleText}" />

                                <DataGrid x:Name="PayslipsDataGrid"
                                          Grid.Row="2"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeNumber}" Width="100" />
                                        <DataGridTextColumn Header="Collaborateur" Binding="{Binding EmployeeFullName}" Width="*" />
                                        <DataGridTextColumn Header="Heures"
                                                            Binding="{Binding HoursWorked, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="75" />
                                        <DataGridTextColumn Header="HS"
                                                            Binding="{Binding OvertimeHours, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="60" />
                                        <DataGridTextColumn Header="Retenue"
                                                            Binding="{Binding AbsenceDeduction, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="95" />
                                        <DataGridTextColumn Header="Primes"
                                                            Binding="{Binding BonusTotal, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="95" />
                                        <DataGridTextColumn Header="Brut"
                                                            Binding="{Binding TaxableGross, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="105" />
                                        <DataGridTextColumn Header="CNAS"
                                                            Binding="{Binding EmployeeSocialContribution, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="95" />
                                        <DataGridTextColumn Header="IRG"
                                                            Binding="{Binding IncomeTax, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="95" />
                                        <DataGridTextColumn Header="Net à payer"
                                                            Binding="{Binding NetPay, StringFormat=N2}"
                                                            ElementStyle="{StaticResource TotalCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="115" />
                                        <DataGridTextColumn Header="Statut"
                                                            Binding="{Binding Status}"
                                                            ElementStyle="{StaticResource MutedCellText}"
                                                            Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border x:Name="WarningsBorder"
                                        Grid.Row="3"
                                        Background="{StaticResource StatusSubmittedBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Points de contrôle de la dernière pré-paie"
                                                   Style="{StaticResource LabelText}" />
                                        <ItemsControl x:Name="WarningsItemsControl" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Style="{StaticResource CaptionText}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Primes variables du mois -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Primes du mois" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Saisies avant la pré-paie, elles entrent dans le brut."
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>

                                <DataGrid x:Name="BonusesDataGrid"
                                          Grid.Row="2"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Collaborateur" Binding="{Binding EmployeeFullName}" Width="*" />
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" />
                                        <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                                        <DataGridTextColumn Header="Montant"
                                                            Binding="{Binding Amount, StringFormat=N2}"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                            Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <TextBlock Text="Collaborateur" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="BonusEmployeeComboBox"
                                              Style="{StaticResource FormCombo}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Id" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Code" Style="{StaticResource FormLabel}" />
                                            <TextBox x:Name="BonusCodeTextBox" Style="{StaticResource FormField}" Text="PRIME" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Libellé" Style="{StaticResource FormLabel}" />
                                            <TextBox x:Name="BonusLabelTextBox" Style="{StaticResource FormField}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Montant" Style="{StaticResource FormLabel}" />
                                            <TextBox x:Name="BonusAmountTextBox" Style="{StaticResource FormField}" />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel>
                                        <Button x:Name="AddBonusButton"
                                                Content="Ajouter la prime"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnAddBonusClick"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="DeleteBonusButton"
                                                Content="Supprimer"
                                                Style="{StaticResource GhostButton}"
                                                Click="OnDeleteBonusClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================ 4. Référentiel ============================ -->
            <TabItem Header="Référentiel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Départements" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Référentiel partagé par tout le groupe."
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>

                            <DataGrid x:Name="DepartmentsDataGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                                    <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Code" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="DepartmentCodeTextBox" Style="{StaticResource FormField}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Libellé" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="DepartmentLabelTextBox" Style="{StaticResource FormField}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                    <Button x:Name="AddDepartmentButton"
                                            Content="Créer"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnAddDepartmentClick"
                                            Margin="0,0,0,10" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Postes" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Le salaire plancher est un contrôle : un contrat en dessous est refusé."
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>

                            <DataGrid x:Name="PositionsDataGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110" />
                                    <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                                    <DataGridTextColumn Header="Département" Binding="{Binding DepartmentLabel}" Width="*" />
                                    <DataGridTextColumn Header="Plancher"
                                                        Binding="{Binding MinimumGrossSalary, StringFormat=N2}"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}"
                                                        Width="110" />
                                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Code" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="PositionCodeTextBox" Style="{StaticResource FormField}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Libellé" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="PositionLabelTextBox" Style="{StaticResource FormField}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Département" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="PositionDepartmentComboBox"
                                              Style="{StaticResource FormCombo}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Code" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Plancher" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="PositionMinimumSalaryTextBox" Style="{StaticResource FormField}" />
                                </StackPanel>

                                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                                    <Button x:Name="AddPositionButton"
                                            Content="Créer"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnAddPositionClick"
                                            Margin="0,0,0,10" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

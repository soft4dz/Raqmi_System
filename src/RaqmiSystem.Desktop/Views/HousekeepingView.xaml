<UserControl x:Class="RaqmiSystem.Desktop.Views.HousekeepingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- Housekeeping & chambres : le poste de travail de la gouvernante, en trois
         sous-onglets :
           1. Tableau des   - une ligne par chambre active : etat de proprete
              chambres        (le module en est proprietaire) croise avec ce que
                              les reservations attendent de la chambre (deduit, non
                              stocke), et la tache du jour quand il y en a une ;
           2. Planning des  - la feuille du jour : generation depuis les
              equipes         reservations, charge par agent, et le cycle complet
                              d'une tache (affecter, demarrer, terminer, controler) ;
           3. Minibar       - la carte de l'unite et l'enregistrement d'une
                              consommation, portee sur le folio du sejour.
         Comme les autres ecrans du module hotelier, la vue ne manipule que des
         dates metier (DateOnly) cote filtres ; les horodatages venus du serveur
         sont convertis en heure locale par le code-behind. -->

    <UserControl.Resources>
        <!-- Onglets internes du module : le style implicite du theme supprime les
             en-tetes (le panneau lateral est l'unique navigation de l'application),
             ce module a donc besoin de son propre gabarit d'onglets visibles -
             meme gabarit SectionTabControl que LodgingView et TreasuryView. -->
        <Style x:Key="SectionTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="tabBackground"
                                    Background="Transparent"
                                    CornerRadius="6,6,0,0"
                                    Padding="18,9">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>

                            <Rectangle x:Name="tabIndicator"
                                       Grid.Row="1"
                                       Height="2.5"
                                       Fill="{StaticResource AccentBrush}"
                                       Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SectionTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Margin="0,16,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compteur du bandeau de synthese : une valeur, un libelle. -->
        <Style x:Key="CounterValueText" TargetType="TextBlock" BasedOn="{StaticResource MetricValueText}">
            <Setter Property="FontSize" Value="21" />
        </Style>

        <Style x:Key="CounterLabelText" TargetType="TextBlock" BasedOn="{StaticResource MetricLabelText}" />

        <Style x:Key="ActionsRowPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== En-tete du module ============================== -->
        <StackPanel>
            <TextBlock Text="Housekeeping &amp; chambres"
                       Style="{StaticResource PageTitleText}" />
            <TextBlock Text="État des chambres, planning des équipes de nettoyage, contrôle des chambres et minibar."
                       Style="{StaticResource SubtitleText}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ========================== Filtres communs aux onglets ========================= -->
        <!-- L'unite et la date pilotent les trois onglets : la gouvernante travaille
             sur un etablissement et une journee, pas sur une selection differente
             par ecran. -->
        <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Unité"
                           Style="{StaticResource FilterRowLabelText}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="UnitComboBox"
                          Width="260"
                          Margin="8,0,20,0"
                          DisplayMemberPath="Label"
                          ToolTip="Établissement dont on gère les chambres"
                          SelectionChanged="Filters_Changed" />

                <TextBlock Text="Date"
                           Style="{StaticResource FilterRowLabelText}"
                           VerticalAlignment="Center" />
                <DatePicker x:Name="DatePicker"
                            Width="150"
                            Margin="8,0,20,0"
                            ToolTip="Journée de service"
                            SelectedDateChanged="Filters_Changed" />

                <Button x:Name="RefreshButton"
                        Content="Actualiser"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Recharger le tableau, la feuille du jour et le minibar"
                        Click="RefreshButton_Click" />
            </StackPanel>
        </Border>

        <TabControl x:Name="HousekeepingTabs"
                    Grid.Row="4"
                    Style="{StaticResource SectionTabControl}"
                    SelectionChanged="HousekeepingTabs_SelectionChanged">

            <!-- ========================== TABLEAU DES CHAMBRES ========================== -->
            <TabItem Header="Tableau des chambres">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Synthese du jour : les chiffres que la gouvernante lit en premier. -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Synthèse de la journée"
                                       Style="{StaticResource SectionTitleText}"
                                       Margin="0,0,0,12" />

                            <UniformGrid Rows="1" Columns="7">
                                <StackPanel>
                                    <TextBlock x:Name="TotalRoomsTextBlock" Text="—" Style="{StaticResource CounterValueText}" />
                                    <TextBlock Text="Chambres actives" Style="{StaticResource CounterLabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="DirtyRoomsTextBlock" Text="—" Style="{StaticResource CounterValueText}" />
                                    <TextBlock Text="À nettoyer" Style="{StaticResource CounterLabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="CleanRoomsTextBlock" Text="—" Style="{StaticResource CounterValueText}" />
                                    <TextBlock Text="Propres" Style="{StaticResource CounterLabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="InspectedRoomsTextBlock" Text="—" Style="{StaticResource CounterValueText}" />
                                    <TextBlock Text="Contrôlées" Style="{StaticResource CounterLabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="OutOfOrderRoomsTextBlock" Text="—" Style="{StaticResource CounterValueText}" />
                                    <TextBlock Text="Hors service" Style="{StaticResource CounterLabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="DeparturesTextBlock" Text="—" Style="{StaticResource CounterValueText}" />
                                    <TextBlock Text="Départs" Style="{StaticResource CounterLabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="TurnoversTextBlock" Text="—" Style="{StaticResource CounterValueText}" />
                                    <TextBlock Text="Recouches" Style="{StaticResource CounterLabelText}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Actions sur la chambre selectionnee. Declarer un etat est un acte
                         manuel de la gouvernante : le cycle normal passe par les taches. -->
                    <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chambre sélectionnée"
                                       Style="{StaticResource FilterRowLabelText}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedRoomTextBlock"
                                       Text="aucune"
                                       Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,20,0" />

                            <Button x:Name="MarkDirtyButton"
                                    Content="Déclarer sale"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Déclarer la chambre à nettoyer"
                                    Click="MarkDirtyButton_Click" />

                            <Button x:Name="MarkCleanButton"
                                    Content="Déclarer propre"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Déclarer la chambre propre sans passer par une tâche"
                                    Click="MarkCleanButton_Click" />

                            <Button x:Name="MarkOutOfOrderButton"
                                    Content="Mettre hors service"
                                    Style="{StaticResource DangerButton}"
                                    Margin="0,0,16,0"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Retirer la chambre du service : motif obligatoire"
                                    Click="MarkOutOfOrderButton_Click" />

                            <TextBlock Text="Motif"
                                       Style="{StaticResource FilterRowLabelText}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="OutOfOrderReasonTextBox"
                                     Width="260"
                                     Margin="8,0,0,0"
                                     MaxLength="300"
                                     ToolTip="Motif de la mise hors service (obligatoire pour cette action)" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4">
                        <DataGrid x:Name="BoardDataGrid"
                                  SelectionChanged="BoardDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chambre" Binding="{Binding RoomNumber}" Width="90" />
                                <DataGridTextColumn Header="Type" Binding="{Binding RoomTypeCode}" Width="90" />
                                <DataGridTextColumn Header="Étage" Binding="{Binding Floor}" Width="80" />
                                <DataGridTextColumn Header="État"
                                                    Binding="{Binding ConditionLabel}"
                                                    Width="130" />
                                <DataGridTextColumn Header="Occupation"
                                                    Binding="{Binding OccupancyLabel}"
                                                    Width="130" />
                                <DataGridTextColumn Header="Client"
                                                    Binding="{Binding CustomerCode}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource MutedCellText}" />
                                <DataGridTextColumn Header="Tâche du jour"
                                                    Binding="{Binding TaskLabel}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Agent"
                                                    Binding="{Binding TaskAssignedTo}"
                                                    Width="150" />
                                <DataGridTextColumn Header="Dernier nettoyage"
                                                    Binding="{Binding LastCleanedLabel}"
                                                    Width="150"
                                                    ElementStyle="{StaticResource MutedCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Etat vide : superpose a la grille tant qu'aucune chambre n'est chargee. -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=BoardDataGrid}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource ModuleGroupIcon.Exploitation}"
                                  Stroke="{StaticResource BorderStrongBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  Width="46"
                                  Height="42"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10" />
                            <TextBlock Text="Aucune chambre à afficher"
                                       Style="{StaticResource EmptyStateTitleText}" />
                            <TextBlock Text="Choisissez une unité hôtelière : le tableau liste ses chambres actives."
                                       Style="{StaticResource EmptyStateHintText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- =========================== PLANNING DES EQUIPES =========================== -->
            <TabItem Header="Planning des équipes">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ==================== Generation et charge par agent ==================== -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Feuille du jour"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="La feuille est construite depuis les réservations : un départ à blanc par chambre libérée, une recouche par chambre occupée, un rafraîchissement par chambre libre restée sale. Relancer ne recrée jamais une tâche existante."
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,12" />

                                <Button x:Name="GenerateSheetButton"
                                        Content="Générer la feuille du jour"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Créer les tâches manquantes pour cette unité et cette date"
                                        Click="GenerateSheetButton_Click" />

                                <TextBlock x:Name="SheetSummaryTextBlock"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel>
                                    <TextBlock Text="Charge par agent"
                                               Style="{StaticResource SectionTitleText}" />
                                    <TextBlock x:Name="UnassignedTextBlock"
                                               DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionText}" />
                                </DockPanel>

                                <DataGrid x:Name="AttendantsDataGrid"
                                          Grid.Row="2"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Agent" Binding="{Binding AssignedTo}" Width="*" />
                                        <DataGridTextColumn Header="Tâches"
                                                            Binding="{Binding TaskCount}"
                                                            Width="70"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                        <DataGridTextColumn Header="Reste"
                                                            Binding="{Binding Remaining}"
                                                            Width="70"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                        <DataGridTextColumn Header="Minutes"
                                                            Binding="{Binding TotalMinutes}"
                                                            Width="80"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================ Taches de la feuille ============================ -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Tâches de la journée"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="TaskCountTextBlock"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionText}" />
                            </DockPanel>

                            <!-- Cycle d'une tache. Le controle est une permission distincte :
                                 l'agent qui a nettoye ne signe pas lui-meme la chambre. -->
                            <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource ActionsRowPanel}">
                                        <TextBlock Text="Agent"
                                                   Style="{StaticResource FilterRowLabelText}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="AttendantTextBox"
                                                 Width="200"
                                                 Margin="8,0,8,0"
                                                 MaxLength="160"
                                                 ToolTip="Nom de la femme ou du valet de chambre à qui affecter la tâche" />

                                        <Button x:Name="AssignTaskButton"
                                                Content="Affecter"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Affecter la tâche sélectionnée à cet agent"
                                                Click="AssignTaskButton_Click" />

                                        <Button x:Name="StartTaskButton"
                                                Content="Démarrer"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="L'agent entre dans la chambre. La tâche doit être affectée."
                                                Click="StartTaskButton_Click" />

                                        <Button x:Name="CompleteTaskButton"
                                                Content="Terminer"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="La chambre est faite : elle passe propre et attend le contrôle"
                                                Click="CompleteTaskButton_Click" />

                                        <Button x:Name="CancelTaskButton"
                                                Content="Annuler la tâche"
                                                Style="{StaticResource DangerButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Retirer la tâche de la feuille : motif obligatoire"
                                                Click="CancelTaskButton_Click" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource ActionsRowPanel}" Margin="0,10,0,0">
                                        <TextBlock Text="Observation"
                                                   Style="{StaticResource FilterRowLabelText}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="TaskNotesTextBox"
                                                 Width="320"
                                                 Margin="8,0,16,0"
                                                 MaxLength="300"
                                                 ToolTip="Observation du contrôle (obligatoire en cas de refus) ou motif d'annulation" />

                                        <Button x:Name="AcceptTaskButton"
                                                Content="Contrôler : accepter"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="La gouvernante accepte la chambre : elle passe contrôlée"
                                                Click="AcceptTaskButton_Click" />

                                        <Button x:Name="RejectTaskButton"
                                                Content="Contrôler : refuser"
                                                Style="{StaticResource DangerButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="La chambre est refusée : elle repasse sale et la tâche retourne au travail. Motif obligatoire."
                                                Click="RejectTaskButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <DataGrid x:Name="TasksDataGrid"
                                          SelectionChanged="TasksDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Chambre" Binding="{Binding RoomNumber}" Width="90" />
                                        <DataGridTextColumn Header="Nature" Binding="{Binding TaskTypeLabel}" Width="150" />
                                        <DataGridTextColumn Header="État" Binding="{Binding StatusLabel}" Width="150" />
                                        <DataGridTextColumn Header="Agent" Binding="{Binding AssignedTo}" Width="*" />
                                        <DataGridTextColumn Header="Durée (min)"
                                                            Binding="{Binding DurationLabel}"
                                                            Width="100"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                        <DataGridTextColumn Header="Contrôle"
                                                            Binding="{Binding InspectionLabel}"
                                                            Width="220"
                                                            ElementStyle="{StaticResource MutedCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=TasksDataGrid}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource ModuleGroupIcon.Controle}"
                                          Stroke="{StaticResource BorderStrongBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          Width="44"
                                          Height="40"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,10" />
                                    <TextBlock Text="Aucune tâche pour cette journée"
                                               Style="{StaticResource EmptyStateTitleText}" />
                                    <TextBlock Text="Générez la feuille du jour : elle se construit depuis les arrivées et les départs."
                                               Style="{StaticResource EmptyStateHintText}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================== MINIBAR ================================== -->
            <TabItem Header="Minibar">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============================== Carte de l'unite ============================== -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Carte du minibar"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Le prix appliqué est celui de la carte au moment de la saisie : il est figé sur la consommation, une révision de la carte ne réécrit jamais ce qu'un client a déjà payé."
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource ActionsRowPanel}">
                                        <TextBlock Text="Code" Style="{StaticResource FilterRowLabelText}" VerticalAlignment="Center" />
                                        <TextBox x:Name="ItemCodeTextBox"
                                                 Width="100"
                                                 Margin="8,0,16,0"
                                                 MaxLength="40"
                                                 ToolTip="Code du produit, unique dans l'unité" />

                                        <TextBlock Text="Libellé" Style="{StaticResource FilterRowLabelText}" VerticalAlignment="Center" />
                                        <TextBox x:Name="ItemLabelTextBox"
                                                 Width="180"
                                                 Margin="8,0,0,0"
                                                 MaxLength="160"
                                                 ToolTip="Libellé commercial du produit" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource ActionsRowPanel}" Margin="0,10,0,0">
                                        <TextBlock Text="Prix unitaire" Style="{StaticResource FilterRowLabelText}" VerticalAlignment="Center" />
                                        <TextBox x:Name="ItemPriceTextBox"
                                                 Width="120"
                                                 Margin="8,0,16,0"
                                                 Style="{StaticResource AmountTextBox}"
                                                 ToolTip="Prix unitaire, strictement positif" />

                                        <Button x:Name="CreateItemButton"
                                                Content="Ajouter"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Ajouter le produit à la carte de cette unité"
                                                Click="CreateItemButton_Click" />

                                        <Button x:Name="UpdateItemButton"
                                                Content="Modifier"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Appliquer le libellé et le prix saisis au produit sélectionné"
                                                Click="UpdateItemButton_Click" />

                                        <Button x:Name="ToggleItemButton"
                                                Content="Activer / retirer"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Retirer le produit de la carte, ou le remettre"
                                                Click="ToggleItemButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="ItemsDataGrid"
                                      Grid.Row="4"
                                      SelectionChanged="ItemsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                    <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                                    <DataGridTextColumn Header="Prix"
                                                        Binding="{Binding PriceLabel}"
                                                        Width="100"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding StatusLabel}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ============================== Consommations ============================== -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Consommations"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Enregistrer une consommation la porte immédiatement sur le folio du séjour, en un seul mouvement : le client ne peut pas être facturé sans trace, ni tracé sans être facturé."
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16,12">
                                <StackPanel Style="{StaticResource ActionsRowPanel}">
                                    <TextBlock Text="Chambre occupée"
                                               Style="{StaticResource FilterRowLabelText}"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="InHouseComboBox"
                                              Width="240"
                                              Margin="8,0,16,0"
                                              DisplayMemberPath="Label"
                                              ToolTip="Séjour en cours à facturer" />

                                    <TextBlock Text="Quantité"
                                               Style="{StaticResource FilterRowLabelText}"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="ConsumptionQuantityTextBox"
                                             Width="70"
                                             Text="1"
                                             Margin="8,0,16,0"
                                             Style="{StaticResource AmountTextBox}"
                                             ToolTip="Nombre d'unités consommées" />

                                    <Button x:Name="RecordConsumptionButton"
                                            Content="Enregistrer et porter au folio"
                                            Style="{StaticResource PrimaryButton}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Enregistrer la consommation du produit sélectionné et la facturer sur le folio"
                                            Click="RecordConsumptionButton_Click" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <DataGrid x:Name="ConsumptionsDataGrid" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding ConsumedOnLabel}" Width="100" />
                                        <DataGridTextColumn Header="Chambre" Binding="{Binding RoomNumber}" Width="90" />
                                        <DataGridTextColumn Header="Produit" Binding="{Binding ItemLabel}" Width="*" />
                                        <DataGridTextColumn Header="Qté"
                                                            Binding="{Binding Quantity}"
                                                            Width="60"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                        <DataGridTextColumn Header="P.U."
                                                            Binding="{Binding UnitPriceLabel}"
                                                            Width="100"
                                                            ElementStyle="{StaticResource AmountCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                        <DataGridTextColumn Header="Total"
                                                            Binding="{Binding TotalLabel}"
                                                            Width="110"
                                                            ElementStyle="{StaticResource TotalCellText}"
                                                            HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                        <DataGridTextColumn Header="Saisi par"
                                                            Binding="{Binding CreatedBy}"
                                                            Width="140"
                                                            ElementStyle="{StaticResource MutedCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=ConsumptionsDataGrid}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource ModuleGroupIcon.Finance}"
                                          Stroke="{StaticResource BorderStrongBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          Width="44"
                                          Height="40"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,10" />
                                    <TextBlock Text="Aucune consommation sur la période"
                                               Style="{StaticResource EmptyStateTitleText}" />
                                    <TextBlock Text="Les consommations relevées dans les chambres apparaîtront ici, avec leur montant porté au folio."
                                               Style="{StaticResource EmptyStateHintText}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

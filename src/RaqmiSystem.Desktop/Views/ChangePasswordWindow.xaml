<Window x:Class="RaqmiSystem.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changer mon mot de passe"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <!-- =========================================================================
         Changement de mot de passe en libre-service.

         La fenetre s'ouvre dans deux situations, et le dit :
           - a la demande, depuis le bouton de l'en-tete ;
           - automatiquement apres une connexion dont la reponse porte
             MustChangePassword (mot de passe temporaire remis par un
             administrateur). Le bandeau d'explication n'est visible que dans ce
             second cas.

         Les regles verifiees ici (longueur minimale lue dans PasswordPolicy,
         egalite des deux saisies, nouveau mot de passe different de l'actuel) sont
         un confort : le serveur applique les memes et fait autorite.
         ========================================================================= -->
    <Border Padding="28,24">
        <StackPanel>

            <TextBlock Text="Changer mon mot de passe"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource StructureBrush}" />
            <TextBlock x:Name="SubtitleTextBlock"
                       Text="Le mot de passe protège votre compte sur ce serveur."
                       Style="{StaticResource SubtitleText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <!-- Visible uniquement quand la connexion a signale MustChangePassword. -->
            <Border x:Name="MandatoryNoticeBorder"
                    Background="{StaticResource StatusSubmittedBackgroundBrush}"
                    BorderBrush="{StaticResource StatusSubmittedForegroundBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,11"
                    Margin="0,18,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Mot de passe temporaire"
                               Foreground="{StaticResource StatusSubmittedForegroundBrush}"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Le mot de passe avec lequel vous venez de vous connecter a été créé par un administrateur, qui a donc pu le lire. Choisissez-en un que vous êtes seul à connaître : tant que ce n'est pas fait, votre compte reste signalé comme à régulariser."
                               Foreground="{StaticResource StatusSubmittedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Mot de passe actuel"
                       Style="{StaticResource LabelText}"
                       Margin="0,20,0,0" />
            <PasswordBox x:Name="CurrentPasswordBox"
                         TabIndex="0"
                         ToolTip="Le mot de passe avec lequel vous vous êtes connecté" />

            <TextBlock Text="Nouveau mot de passe"
                       Style="{StaticResource LabelText}"
                       Margin="0,16,0,0" />
            <PasswordBox x:Name="NewPasswordBox"
                         TabIndex="1"
                         PasswordChanged="NewPasswordBox_PasswordChanged" />
            <TextBlock x:Name="LengthHintTextBlock"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <TextBlock Text="Confirmer le nouveau mot de passe"
                       Style="{StaticResource LabelText}"
                       Margin="0,16,0,0" />
            <PasswordBox x:Name="ConfirmPasswordBox"
                         TabIndex="2"
                         PasswordChanged="NewPasswordBox_PasswordChanged" />

            <ProgressBar x:Name="BusyProgressBar"
                         Height="3"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Margin="0,16,0,0" />

            <!-- Encart d'etat : meme grammaire visuelle que l'ecran de connexion
                 (Tag "Error" ou "Info" pose par le code-behind). -->
            <Border x:Name="StatusBorder"
                    CornerRadius="6"
                    BorderThickness="1"
                    Padding="12,9"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="Tag" Value="Error">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="StatusTextBlock"
                           FontSize="12.5"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}"
                                             Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="CancelButton"
                        Content="Annuler"
                        Style="{StaticResource GhostButton}"
                        IsCancel="True"
                        TabIndex="4"
                        Margin="0,0,10,0" />
                <Button x:Name="SubmitButton"
                        Content="Changer le mot de passe"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        TabIndex="3"
                        Click="SubmitButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

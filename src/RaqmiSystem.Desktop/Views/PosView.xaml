<UserControl x:Class="RaqmiSystem.Desktop.Views.PosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource AppFontFamily}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardBorder}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Établissement" Style="{StaticResource LabelText}" VerticalAlignment="Center"/><ComboBox x:Name="UnitCombo" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="UnitChanged"/><TextBlock Grid.Column="3" Text="Point de vente" Style="{StaticResource LabelText}" VerticalAlignment="Center"/><ComboBox x:Name="OutletCombo" Grid.Column="4" DisplayMemberPath="Name" SelectionChanged="OutletChanged"/><Button Grid.Column="6" Content="Actualiser" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/></Grid></Border>
  <TabControl Grid.Row="2">
   <TabItem Header="Vue d’ensemble"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><UniformGrid Columns="4"><Border Style="{StaticResource CardBorder}" Margin="4" Padding="18"><StackPanel><TextBlock Text="Chiffre d’affaires" Style="{StaticResource CaptionText}"/><TextBlock x:Name="RevenueText" Text="0 DA" Style="{StaticResource PageTitleText}"/></StackPanel></Border><Border Style="{StaticResource CardBorder}" Margin="4" Padding="18"><StackPanel><TextBlock Text="Tickets encaissés" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PaidCountText" Text="0" Style="{StaticResource PageTitleText}"/></StackPanel></Border><Border Style="{StaticResource CardBorder}" Margin="4" Padding="18"><StackPanel><TextBlock Text="Tickets ouverts" Style="{StaticResource CaptionText}"/><TextBlock x:Name="OpenCountText" Text="0" Style="{StaticResource PageTitleText}"/></StackPanel></Border><Border Style="{StaticResource CardBorder}" Margin="4" Padding="18"><StackPanel><TextBlock Text="Panier moyen" Style="{StaticResource CaptionText}"/><TextBlock x:Name="AverageText" Text="0 DA" Style="{StaticResource PageTitleText}"/></StackPanel></Border></UniformGrid><DataGrid Grid.Row="2" x:Name="OutletSalesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Point de vente" Binding="{Binding OutletName}" Width="*"/><DataGridTextColumn Header="Tickets" Binding="{Binding Tickets}" Width="120"/><DataGridTextColumn Header="CA" Binding="{Binding Revenue,StringFormat={}{0:N0} DA}" Width="180"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Caisse"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardBorder}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Double-cliquez sur un article" Style="{StaticResource SectionTitleText}"/><ListBox Grid.Row="2" x:Name="ProductList" MouseDoubleClick="ProductDoubleClick"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="7"><TextBlock Text="{Binding Price,StringFormat={}{0:N0} DA}" DockPanel.Dock="Right" FontWeight="SemiBold"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Style="{StaticResource CaptionText}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ticket courant" Style="{StaticResource SectionTitleText}"/><DataGrid Grid.Row="1" x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Article" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="55"/><DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat={}{0:N0} DA}" Width="105"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><DockPanel Margin="0,10"><TextBlock Text="TOTAL" FontWeight="Bold"/><TextBlock x:Name="CartTotalText" DockPanel.Dock="Right" Text="0 DA" FontSize="24" FontWeight="Bold"/></DockPanel><UniformGrid Columns="3"><Button Content="Espèces" Style="{StaticResource PrimaryButton}" Margin="3" Tag="Cash" Click="Pay_Click"/><Button Content="CIB" Style="{StaticResource SecondaryButton}" Margin="3" Tag="Cib" Click="Pay_Click"/><Button Content="Chambre" Style="{StaticResource SecondaryButton}" Margin="3" Tag="RoomCharge" Click="Pay_Click"/></UniformGrid><Button Content="Vider" Style="{StaticResource SecondaryButton}" Margin="3" Click="ClearCart_Click"/></StackPanel></Grid></Border></Grid></TabItem>
   <TabItem Header="Tickets"><DataGrid Margin="16" x:Name="TicketsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="N° ticket" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="Ouverture" Binding="{Binding OpenedAt,StringFormat={}{0:g}}" Width="170"/><DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Paiement" Binding="{Binding PaymentMethod}" Width="120"/><DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat={}{0:N0} DA}" Width="140"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Points de vente"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid x:Name="OutletsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OutletGridChanged"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="140"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18"><StackPanel><TextBlock Text="Configuration" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Code" Margin="0,12,0,4"/><TextBox x:Name="OutletCodeBox"/><TextBlock Text="Nom" Margin="0,10,0,4"/><TextBox x:Name="OutletNameBox"/><TextBlock Text="Type" Margin="0,10,0,4"/><ComboBox x:Name="OutletKindCombo"><ComboBoxItem Content="Restaurant"/><ComboBoxItem Content="Bar"/><ComboBoxItem Content="Cafétéria"/><ComboBoxItem Content="Room service"/><ComboBoxItem Content="Boutique"/><ComboBoxItem Content="Spa"/></ComboBox><CheckBox x:Name="OutletActiveCheck" Content="Actif" IsChecked="True" Margin="0,12"/><Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SaveOutlet_Click"/><Button Content="Nouveau" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="NewOutlet_Click"/></StackPanel></Border></Grid></TabItem>
   <TabItem Header="Catalogue"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ProductGridChanged"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Article" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Famille" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="Prix" Binding="{Binding Price,StringFormat={}{0:N0} DA}" Width="110"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18"><StackPanel><TextBlock Text="Article et tarif" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Code" Margin="0,12,0,4"/><TextBox x:Name="ProductCodeBox"/><TextBlock Text="Nom" Margin="0,10,0,4"/><TextBox x:Name="ProductNameBox"/><TextBlock Text="Famille" Margin="0,10,0,4"/><TextBox x:Name="ProductCategoryBox"/><TextBlock Text="Prix (DA)" Margin="0,10,0,4"/><TextBox x:Name="ProductPriceBox"/><CheckBox x:Name="ProductActiveCheck" Content="Actif" IsChecked="True" Margin="0,12"/><Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SaveProduct_Click"/><Button Content="Nouveau" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="NewProduct_Click"/></StackPanel></Border></Grid></TabItem>
   <TabItem Header="Salles &amp; tables"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid x:Name="TablesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="TableGridChanged"><DataGrid.Columns><DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="*"/><DataGridTextColumn Header="Table" Binding="{Binding Number}" Width="120"/><DataGridTextColumn Header="Places" Binding="{Binding Seats}" Width="90"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18"><StackPanel><TextBlock Text="Salle / table" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Zone ou salle" Margin="0,12,0,4"/><TextBox x:Name="TableZoneBox"/><TextBlock Text="Numéro" Margin="0,10,0,4"/><TextBox x:Name="TableNumberBox"/><TextBlock Text="Places" Margin="0,10,0,4"/><TextBox x:Name="TableSeatsBox" Text="4"/><CheckBox x:Name="TableActiveCheck" Content="Active" IsChecked="True" Margin="0,12"/><Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SaveTable_Click"/><Button Content="Nouvelle" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="NewTable_Click"/></StackPanel></Border></Grid></TabItem>
  </TabControl>
 </Grid>
</UserControl>

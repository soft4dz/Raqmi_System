<UserControl x:Class="RaqmiSystem.Desktop.Views.ClosingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RaqmiSystem.Desktop.Views">

    <!-- Cloture journaliere & night audit. Mise en page alignee sur l'onglet
         "Recettes journalieres" : carte de filtres, carte de formulaire, puis
         carte de consultation avec grille et etat vide superpose. -->

    <UserControl.Resources>
        <!-- Les horodatages remontent en UTC : ils sont convertis a l'heure du
             poste pour l'affichage, l'operateur raisonnant en heure locale. -->
        <views:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================= Bandeau de filtres ========================= -->
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Clôture journalière &amp; night audit"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Verrouillage officiel des journées d'exploitation, unité par unité."
                               Style="{StaticResource SubtitleText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Du" Style="{StaticResource LabelText}" />
                        <DatePicker x:Name="FromDatePicker" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Au" Style="{StaticResource LabelText}" />
                        <DatePicker x:Name="ToDatePicker" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Unité hôtelière" Style="{StaticResource LabelText}" />
                        <ComboBox x:Name="FilterUnitComboBox"
                                  DisplayMemberPath="Label"
                                  ToolTip="Restreindre la liste à une unité hôtelière" />
                    </StackPanel>

                    <Button x:Name="RefreshClosingButton"
                            Grid.Column="7"
                            Content="Actualiser"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Recharger les clôtures de la période sélectionnée"
                            VerticalAlignment="Bottom"
                            Click="RefreshClosingButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- ====================== Clôturer une journée ========================== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Clôturer une journée" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Une journée ne peut être clôturée que si aucune recette de cette journée n'est encore en brouillon ou soumise."
                               Style="{StaticResource SubtitleText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Date métier" Style="{StaticResource LabelText}" />
                        <DatePicker x:Name="CloseDatePicker"
                                    ToolTip="Journée d'exploitation à clôturer (la veille par défaut)"
                                    SelectedDateChanged="CloseDatePicker_SelectedDateChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unité hôtelière" Style="{StaticResource LabelText}" />
                        <!-- Meme presentation "CODE — Nom" que les autres listes d'unites
                             de cet ecran : le code est ce qui identifie l'unite. -->
                        <ComboBox x:Name="CloseUnitComboBox"
                                  ToolTip="Unité hôtelière dont la journée est clôturée (obligatoire)"
                                  SelectionChanged="CloseUnitComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} — {1}">
                                                <Binding Path="Code" Mode="OneWay" />
                                                <Binding Path="Name" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Notes" Style="{StaticResource LabelText}" />
                        <!-- Borne du domaine : DailyClosing normalise la note a 1000 caracteres
                             au plus, a la premiere cloture comme a la re-cloture. -->
                        <TextBox x:Name="CloseNotesTextBox"
                                 MaxLength="1000"
                                 Tag="Commentaire facultatif"
                                 ToolTip="Commentaire facultatif, 1000 caractères au maximum" />
                    </StackPanel>

                    <Button x:Name="CloseDayButton"
                            Grid.Column="6"
                            Content="Clôturer la journée"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Verrouiller définitivement la journée sélectionnée pour cette unité"
                            VerticalAlignment="Bottom"
                            Click="CloseDayButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- ========================= Liste des clôtures ========================= -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button x:Name="ReopenButton"
                            DockPanel.Dock="Right"
                            Content="Réouvrir…"
                            Style="{StaticResource DangerButton}"
                            ToolTip="Rouvrir la journée sélectionnée (motif obligatoire)"
                            IsEnabled="False"
                            Click="ReopenButton_Click" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Journées clôturées" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Sélectionnez une journée clôturée pour la rouvrir."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Panneau de saisie du motif : affiche a la demande, jamais une boite
                     de dialogue custom. La confirmation finale reste une MessageBox. -->
                <Border x:Name="ReopenPanelBorder"
                        Grid.Row="2"
                        Style="{StaticResource SubtleCardBorder}"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ReopenTargetTextBlock"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Motif de réouverture" Style="{StaticResource LabelText}" />
                                <!-- Borne du domaine : DailyClosing.Reopen refuse un motif
                                     de plus de 500 caracteres. -->
                                <TextBox x:Name="ReopenReasonTextBox"
                                         MaxLength="500"
                                         Tag="Obligatoire : justification du contrôle"
                                         ToolTip="Motif obligatoire, 500 caractères au maximum"
                                         TextChanged="ReopenReasonTextBox_TextChanged" />
                            </StackPanel>

                            <Button x:Name="ConfirmReopenButton"
                                    Grid.Column="2"
                                    Content="Confirmer la réouverture"
                                    Style="{StaticResource DangerButton}"
                                    ToolTip="Rouvrir la journée avec le motif saisi"
                                    IsEnabled="False"
                                    VerticalAlignment="Bottom"
                                    Click="ConfirmReopenButton_Click" />

                            <Button x:Name="CancelReopenButton"
                                    Grid.Column="4"
                                    Content="Annuler"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="Fermer la saisie du motif"
                                    VerticalAlignment="Bottom"
                                    Click="CancelReopenButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <DataGrid x:Name="ClosingDataGrid"
                              SelectionChanged="ClosingDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date métier"
                                                Binding="{Binding BusinessDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="110" />
                            <DataGridTextColumn Header="Unité"
                                                Binding="{Binding HotelUnitCode}"
                                                Width="90" />
                            <DataGridTextColumn Header="Désignation"
                                                Binding="{Binding HotelUnitName}"
                                                Width="170"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTemplateColumn Header="Statut" Width="120" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadge"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource StatusValidatedBackgroundBrush}">
                                            <TextBlock x:Name="StatusBadgeText"
                                                       Text="Clôturée"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StatusValidatedForegroundBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Reopened">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusSubmittedBackgroundBrush}" />
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusSubmittedForegroundBrush}" />
                                                <Setter TargetName="StatusBadgeText" Property="Text" Value="Rouverte" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Clôturée le"
                                                Binding="{Binding ClosedAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                Width="130" />
                            <DataGridTextColumn Header="Clôturée par"
                                                Binding="{Binding ClosedBy}"
                                                Width="130"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Rouverte le"
                                                Binding="{Binding ReopenedAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                Width="130" />
                            <DataGridTextColumn Header="Rouverte par"
                                                Binding="{Binding ReopenedBy}"
                                                Width="130"
                                                ElementStyle="{StaticResource MutedCellText}" />
                            <DataGridTextColumn Header="Motif de réouverture"
                                                Binding="{Binding ReopenReason}"
                                                Width="200" />
                            <DataGridTextColumn Header="Notes"
                                                Binding="{Binding Notes}"
                                                Width="*"
                                                ElementStyle="{StaticResource MutedCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=ClosingDataGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="M4,7 V4.5 A4,4 0 0 1 12,4.5 V7 M2.5,7 H13.5 V14 H2.5 Z M8,9.5 V11.5"
                              Stroke="{StaticResource BorderStrongBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="44"
                              Height="42"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock Text="Aucune clôture pour cette période"
                                   Style="{StaticResource EmptyStateTitleText}" />
                        <TextBlock Text="Élargissez la période, changez d'unité, ou clôturez une première journée ci-dessus."
                                   Style="{StaticResource EmptyStateHintText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="RaqmiSystem.Desktop.Views.ApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- ============================================================================
         Workflows & validations : circuits de validation configurables, instances
         en cours et decisions. Trois sections independantes, donc sous-onglets
         visibles sur le gabarit SectionTabControl (reference : TreasuryView).
         ============================================================================ -->

    <UserControl.Resources>
        <!-- Onglets internes du module : le style implicite du theme supprime les
             en-tetes (le panneau lateral est l'unique navigation de l'application),
             ce module a donc besoin de son propre gabarit d'onglets visibles
             (gabarit repris de TreasuryView). -->
        <Style x:Key="SectionTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="tabBackground"
                                    Background="Transparent"
                                    CornerRadius="6,6,0,0"
                                    Padding="18,9">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>

                            <Rectangle x:Name="tabIndicator"
                                       Grid.Row="1"
                                       Height="2.5"
                                       Fill="{StaticResource AccentBrush}"
                                       Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="tabBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SectionTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Margin="0,16,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Precision affichee sous un champ dont la saisie obeit a une regle metier. -->
        <Style x:Key="FieldHintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Pastille de statut d'une instance : fond doux + texte fonce de la meme
             teinte, pilotee par le libelle francais (source unique dans le code). -->
        <DataTemplate x:Key="InstanceStatusBadge">
            <Border x:Name="StatusBadge"
                    CornerRadius="10"
                    Padding="10,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{StaticResource StatusSubmittedBackgroundBrush}">
                <TextBlock x:Name="StatusBadgeText"
                           Text="{Binding StatusLabel}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource StatusSubmittedForegroundBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="Approuvée">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusValidatedBackgroundBrush}" />
                    <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusValidatedForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="Rejetée">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource StatusRejectedBackgroundBrush}" />
                    <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{StaticResource StatusRejectedForegroundBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== En-tete du module ============================== -->
        <DockPanel>
            <Button x:Name="RefreshAllButton"
                    DockPanel.Dock="Right"
                    Content="Tout actualiser"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Recharger les décisions en attente, les circuits et l'historique"
                    VerticalAlignment="Center"
                    Click="RefreshAllButton_Click" />

            <StackPanel>
                <TextBlock Text="Workflows &amp; validations"
                           Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Circuits de validation configurables et décisions d'approbation, étape par étape"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <TabControl x:Name="SectionsTabControl" Style="{StaticResource SectionTabControl}">

                <!-- ==================== 1. En attente de ma decision ==================== -->
                <TabItem Header="En attente de ma décision">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="Instances dont l'étape courante requiert un de vos rôles"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock x:Name="PendingCountTextBlock"
                                       DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}" />
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="PendingDataGrid"
                                      SelectionChanged="PendingDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sujet" Binding="{Binding SubjectLabel}" Width="160" />
                                    <DataGridTextColumn Header="Référence" Binding="{Binding SubjectReference}" Width="*" />
                                    <DataGridTextColumn Header="Circuit" Binding="{Binding CircuitLabel}" Width="200" />
                                    <DataGridTextColumn Header="Étape courante" Binding="{Binding CurrentStepDisplay}" Width="220" />
                                    <DataGridTextColumn Header="Rôle requis"
                                                        Binding="{Binding CurrentRoleLabel}"
                                                        Width="170"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Ouverte le"
                                                        Binding="{Binding OpenedAtDisplay}"
                                                        Width="150"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Etat vide : superpose a la grille tant qu'elle ne contient aucune ligne. -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PendingDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource ModuleGroupIcon.Controle}"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="46"
                                      Height="42"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10" />
                                <TextBlock Text="Aucune décision en attente"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Les instances dont l'étape courante requiert un de vos rôles apparaîtront ici."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Panneau de decision de la ligne selectionnee -->
                        <Border Grid.Row="4" Style="{StaticResource SubtleCardBorder}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="DecisionTitleTextBlock"
                                           Text="Décision — sélectionnez une instance"
                                           Style="{StaticResource SectionTitleText}"
                                           FontSize="14" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Commentaire" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="DecisionCommentTextBox"
                                                 Tag="Motif ou observation du décideur"
                                                 MaxLength="500" />
                                        <TextBlock Text="Facultatif pour approuver — obligatoire en cas de rejet (500 caractères au plus)."
                                                   Style="{StaticResource FieldHintText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <Button x:Name="ApproveButton"
                                                Content="Approuver l'étape"
                                                Style="{StaticResource PrimaryButton}"
                                                ToolTip="Approuver l'étape courante de l'instance sélectionnée"
                                                ToolTipService.ShowOnDisabled="True"
                                                Margin="0,0,10,0"
                                                Click="ApproveButton_Click" />
                                        <Button x:Name="RejectButton"
                                                Content="Rejeter"
                                                Style="{StaticResource DangerButton}"
                                                ToolTip="Rejeter l'instance sélectionnée (clôture définitive, commentaire obligatoire)"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="RejectButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================ 2. Circuits ============================ -->
                <TabItem Header="Circuits">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Fiche circuit : creation <-> modification sur la selection de grille. -->
                        <Border Style="{StaticResource SubtleCardBorder}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="CircuitFormTitleTextBlock"
                                           Text="Nouveau circuit"
                                           Style="{StaticResource SectionTitleText}"
                                           FontSize="14" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Code" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="CircuitCodeTextBox"
                                                 Tag="ex. CIRC-OP"
                                                 MaxLength="40" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Libellé" Style="{StaticResource LabelText}" />
                                        <TextBox x:Name="CircuitLabelTextBox"
                                                 Tag="ex. Validation des ordres de paiement"
                                                 MaxLength="200" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Sujet couvert" Style="{StaticResource LabelText}" />
                                        <ComboBox x:Name="SubjectTypeComboBox"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" />
                                        <TextBlock Text="Fixé à la création — un circuit ne change pas de sujet en cours de vie."
                                                   Style="{StaticResource FieldHintText}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Editeur d'etapes : l'ordre d'ajout est l'ordre de decision,
                                     les rangs sont attribues par le serveur (contigus depuis 1). -->
                                <TextBlock Grid.Row="4"
                                           Text="Étapes — décidées dans l'ordre, chacune par le rôle qu'elle exige"
                                           Style="{StaticResource LabelText}" />

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="StepLabelTextBox"
                                             Tag="Libellé de l'étape (ex. Visa du contrôle)"
                                             MaxLength="200" />

                                    <ComboBox x:Name="StepRoleComboBox"
                                              Grid.Column="2"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value" />

                                    <Button x:Name="AddStepButton"
                                            Grid.Column="4"
                                            Content="Ajouter l'étape"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="Ajouter cette étape à la fin du circuit"
                                            Click="AddStepButton_Click" />

                                    <Button x:Name="RemoveStepButton"
                                            Grid.Column="6"
                                            Content="Retirer l'étape"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Retirer l'étape sélectionnée dans la liste"
                                            Click="RemoveStepButton_Click" />
                                </Grid>

                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid MaxHeight="170">
                                        <DataGrid x:Name="StepsDataGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Rang" Binding="{Binding Rank}" Width="70" />
                                                <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                                                <DataGridTextColumn Header="Rôle requis" Binding="{Binding RoleLabel}" Width="200" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=StepsDataGrid}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path Data="{StaticResource ModuleGroupIcon.Conformite}"
                                                  Stroke="{StaticResource BorderStrongBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineJoin="Round"
                                                  Width="34"
                                                  Height="30"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,8" />
                                            <TextBlock Text="Aucune étape"
                                                       Style="{StaticResource EmptyStateTitleText}" />
                                            <TextBlock Text="Ajoutez au moins une étape : un circuit sans étape ne peut pas être activé."
                                                       Style="{StaticResource EmptyStateHintText}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button x:Name="NewCircuitButton"
                                                Content="Nouveau"
                                                Style="{StaticResource GhostButton}"
                                                ToolTip="Vider le formulaire pour créer un nouveau circuit"
                                                Margin="0,0,0,10"
                                                Click="NewCircuitButton_Click" />
                                        <Button x:Name="SaveCircuitButton"
                                                Content="Créer le circuit"
                                                Style="{StaticResource PrimaryButton}"
                                                ToolTip="Enregistrer le circuit et ses étapes"
                                                ToolTipService.ShowOnDisabled="True"
                                                Margin="0,0,0,10"
                                                Click="SaveCircuitButton_Click" />
                                        <Button x:Name="ActivateCircuitButton"
                                                Content="Activer"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Activer le circuit sélectionné : il gouvernera tous les sujets de son type"
                                                ToolTipService.ShowOnDisabled="True"
                                                Margin="0,0,0,10"
                                                Click="ActivateCircuitButton_Click" />
                                        <Button x:Name="DeactivateCircuitButton"
                                                Content="Désactiver"
                                                Style="{StaticResource DangerButton}"
                                                ToolTip="Désactiver le circuit sélectionné : les nouveaux sujets ne seront plus bloqués"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="DeactivateCircuitButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Liste des circuits -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Circuits configurés"
                                           Style="{StaticResource SectionTitleText}" />
                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <CheckBox x:Name="IncludeInactiveCircuitsCheckBox"
                                              Content="Inclure les circuits inactifs"
                                              ToolTip="Afficher aussi les circuits désactivés"
                                              VerticalAlignment="Center"
                                              Click="IncludeInactiveCircuitsCheckBox_Click" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="2">
                                <DataGrid x:Name="CircuitsDataGrid"
                                          SelectionChanged="CircuitsDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                                        <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                                        <DataGridTextColumn Header="Sujet" Binding="{Binding SubjectLabel}" Width="170" />
                                        <DataGridTextColumn Header="Étapes"
                                                            Binding="{Binding StepsDisplay}"
                                                            Width="260"
                                                            ElementStyle="{StaticResource MutedCellText}" />
                                        <DataGridTemplateColumn Header="Actif" Width="110" SortMemberPath="IsActive">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ActiveBadge"
                                                            CornerRadius="10"
                                                            Padding="10,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource StatusValidatedBackgroundBrush}">
                                                        <TextBlock x:Name="ActiveBadgeText"
                                                                   Text="Actif"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource StatusValidatedForegroundBrush}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter TargetName="ActiveBadge" Property="Background" Value="{StaticResource StatusDraftBackgroundBrush}" />
                                                            <Setter TargetName="ActiveBadgeText" Property="Foreground" Value="{StaticResource StatusDraftForegroundBrush}" />
                                                            <Setter TargetName="ActiveBadgeText" Property="Text" Value="Inactif" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=CircuitsDataGrid}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource ModuleGroupIcon.Conformite}"
                                          Stroke="{StaticResource BorderStrongBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          Width="46"
                                          Height="42"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,10" />
                                    <TextBlock Text="Aucun circuit configuré"
                                               Style="{StaticResource EmptyStateTitleText}" />
                                    <TextBlock Text="Créez un premier circuit ci-dessus puis activez-le pour gouverner son sujet."
                                               Style="{StaticResource EmptyStateHintText}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============================ 3. Historique ============================ -->
                <TabItem Header="Historique">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Filtres -->
                        <Border Style="{StaticResource SubtleCardBorder}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Sujet" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="HistorySubjectComboBox"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Référence du sujet" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="HistoryReferenceTextBox"
                                             Tag="ex. identifiant de l'ordre de paiement"
                                             MaxLength="100"
                                             KeyDown="HistoryReferenceTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Statut" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="HistoryStatusComboBox"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Du" Style="{StaticResource LabelText}" />
                                    <DatePicker x:Name="HistoryFromDatePicker" />
                                </StackPanel>

                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Au" Style="{StaticResource LabelText}" />
                                    <DatePicker x:Name="HistoryToDatePicker" />
                                </StackPanel>

                                <Button x:Name="SearchHistoryButton"
                                        Grid.Column="10"
                                        Content="Rechercher"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Recharger l'historique selon les filtres"
                                        VerticalAlignment="Bottom"
                                        Click="SearchHistoryButton_Click" />
                            </Grid>
                        </Border>

                        <!-- Instances -->
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="HistoryDataGrid"
                                      SelectionChanged="HistoryDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sujet" Binding="{Binding SubjectLabel}" Width="150" />
                                    <DataGridTextColumn Header="Référence" Binding="{Binding SubjectReference}" Width="*" />
                                    <DataGridTextColumn Header="Circuit" Binding="{Binding CircuitLabel}" Width="190" />
                                    <DataGridTemplateColumn Header="Statut"
                                                            Width="130"
                                                            SortMemberPath="StatusLabel"
                                                            CellTemplate="{StaticResource InstanceStatusBadge}" />
                                    <DataGridTextColumn Header="Avancement"
                                                        Binding="{Binding ProgressDisplay}"
                                                        Width="130"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Ouverte le"
                                                        Binding="{Binding OpenedAtDisplay}"
                                                        Width="145"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Clôturée le"
                                                        Binding="{Binding ClosedAtDisplay}"
                                                        Width="145"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=HistoryDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource ModuleGroupIcon.Documentaire}"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="46"
                                      Height="42"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10" />
                                <TextBlock Text="Aucune instance à afficher"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Élargissez les filtres, ou ouvrez une première instance depuis le module concerné."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Decisions de l'instance selectionnee -->
                        <Border Grid.Row="4" Style="{StaticResource SubtleCardBorder}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="DecisionsTitleTextBlock"
                                           Text="Décisions — sélectionnez une instance"
                                           Style="{StaticResource SectionTitleText}"
                                           FontSize="14" />

                                <Grid Grid.Row="2" MaxHeight="180">
                                    <DataGrid x:Name="DecisionsDataGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Rang" Binding="{Binding Rank}" Width="70" />
                                            <DataGridTextColumn Header="Étape" Binding="{Binding StepLabel}" Width="220" />
                                            <DataGridTextColumn Header="Décision" Binding="{Binding VerdictLabel}" Width="120" />
                                            <DataGridTextColumn Header="Décideur" Binding="{Binding DecidedBy}" Width="170" />
                                            <DataGridTextColumn Header="Le"
                                                                Binding="{Binding DecidedAtDisplay}"
                                                                Width="145"
                                                                ElementStyle="{StaticResource MutedCellText}" />
                                            <DataGridTextColumn Header="Commentaire" Binding="{Binding Comment}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=DecisionsDataGrid}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Path Data="{StaticResource ModuleGroupIcon.Controle}"
                                              Stroke="{StaticResource BorderStrongBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              Width="34"
                                              Height="30"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,8" />
                                        <TextBlock Text="Aucune décision"
                                                   Style="{StaticResource EmptyStateTitleText}" />
                                        <TextBlock Text="Sélectionnez une instance pour consulter ses décisions."
                                                   Style="{StaticResource EmptyStateHintText}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="RaqmiSystem.Desktop.Views.TariffsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- Tarifs & conventions : plans tarifaires par unite, periodes de tarif par
         type de chambre, conventions clients et testeur de resolution d'un tarif.
         Mise en page alignee sur les autres vues de module : cartes empilees dans
         un ScrollViewer, grilles a hauteur bornee avec etat vide superpose. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================== Bandeau de filtres ======================== -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tarifs &amp; conventions"
                                   Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="Plans tarifaires par unité, périodes de tarif par type de chambre et conventions clients."
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Unité hôtelière" Style="{StaticResource LabelText}" />
                            <ComboBox x:Name="FilterUnitComboBox"
                                      DisplayMemberPath="Label"
                                      ToolTip="Restreindre les plans tarifaires à une unité hôtelière" />
                        </StackPanel>

                        <CheckBox x:Name="IncludeInactiveTariffsCheckBox"
                                  Grid.Column="2"
                                  Content="Inclure inactifs"
                                  ToolTip="Afficher aussi les plans et conventions désactivés"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,8" />

                        <Button x:Name="RefreshTariffsButton"
                                Grid.Column="4"
                                Content="Actualiser"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Recharger les plans tarifaires et les conventions"
                                VerticalAlignment="Bottom"
                                Click="RefreshTariffsButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================== Plans tarifaires ========================== -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Plans tarifaires" Style="{StaticResource SectionTitleText}" />

                    <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PlanFormTitleTextBlock"
                                       Text="Nouveau plan tarifaire"
                                       Style="{StaticResource SectionTitleText}"
                                       FontSize="14"
                                       Margin="0,0,0,4" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Code" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="PlanCodeTextBox" MaxLength="40" Tag="ex. STD" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Libellé" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="PlanLabelTextBox" MaxLength="160" Tag="Libellé du plan" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Unité hôtelière" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="PlanUnitComboBox"
                                              ToolTip="Unité hôtelière du plan (obligatoire à la création)">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} — {1}">
                                                            <Binding Path="Code" Mode="OneWay" />
                                                            <Binding Path="Name" Mode="OneWay" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <CheckBox x:Name="PlanIsDefaultCheckBox"
                                          Grid.Column="6"
                                          Content="Plan par défaut"
                                          ToolTip="Faire de ce plan le plan par défaut de son unité dès la création"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,8" />

                                <Button x:Name="NewPlanButton"
                                        Grid.Column="8"
                                        Content="Nouveau"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="Vider le formulaire pour créer un nouveau plan"
                                        VerticalAlignment="Bottom"
                                        Click="NewPlanButton_Click" />

                                <Button x:Name="SavePlanButton"
                                        Grid.Column="10"
                                        Content="Créer"
                                        Style="{StaticResource PrimaryButton}"
                                        ToolTip="Enregistrer le plan tarifaire"
                                        ToolTipService.ShowOnDisabled="True"
                                        VerticalAlignment="Bottom"
                                        Click="SavePlanButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid MinHeight="170" MaxHeight="240">
                            <DataGrid x:Name="PlansDataGrid"
                                      SelectionChanged="PlansDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120" />
                                    <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                                    <DataGridTextColumn Header="Unité" Binding="{Binding HotelUnitCode}" Width="110" />
                                    <DataGridCheckBoxColumn Header="Par défaut" Binding="{Binding IsDefault}" Width="95" />
                                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="70" />
                                    <DataGridTextColumn Header="Créé par"
                                                        Binding="{Binding CreatedBy}"
                                                        Width="140"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PlansDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Pictogramme au trait (etiquette de prix), meme gabarit que
                                     les etats vides des autres ecrans. -->
                                <Path Data="M1.5,1.5 H8 L14.5,8 L8,14.5 L1.5,8 Z M4.1,5 A0.9,0.9 0 1 0 5.9,5 A0.9,0.9 0 1 0 4.1,5"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="44"
                                      Height="42"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10" />
                                <TextBlock Text="Aucun plan tarifaire"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Créez un premier plan ci-dessus ou cliquez sur Actualiser."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SetDefaultPlanButton"
                                    Content="Définir par défaut"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Faire du plan sélectionné le plan par défaut de son unité"
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="0,0,8,0"
                                    Click="SetDefaultPlanButton_Click" />
                            <Button x:Name="ActivatePlanButton"
                                    Content="Activer"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Réactiver le plan sélectionné"
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="0,0,8,0"
                                    Click="ActivatePlanButton_Click" />
                            <Button x:Name="DeactivatePlanButton"
                                    Content="Désactiver"
                                    Style="{StaticResource DangerButton}"
                                    ToolTip="Désactiver le plan sélectionné"
                                    ToolTipService.ShowOnDisabled="True"
                                    Click="DeactivatePlanButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================== Périodes de tarif ========================= -->
            <Border Grid.Row="4" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Périodes de tarif" Style="{StaticResource SectionTitleText}" />
                        <TextBlock x:Name="PeriodsPlanCaptionTextBlock"
                                   Text="Sélectionnez un plan tarifaire pour afficher et gérer ses périodes."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Type de chambre" Style="{StaticResource LabelText}" />
                            <TextBox x:Name="PeriodRoomTypeTextBox" MaxLength="40" Tag="ex. STD" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Du" Style="{StaticResource LabelText}" />
                            <DatePicker x:Name="PeriodFromDatePicker" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Au" Style="{StaticResource LabelText}" />
                            <DatePicker x:Name="PeriodToDatePicker" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Montant nuitée" Style="{StaticResource LabelText}" />
                            <TextBox x:Name="PeriodAmountTextBox" Style="{StaticResource AmountTextBox}" />
                        </StackPanel>

                        <Button x:Name="AddPeriodButton"
                                Grid.Column="8"
                                Content="Ajouter"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="Ajouter la période de tarif au plan sélectionné"
                                ToolTipService.ShowOnDisabled="True"
                                VerticalAlignment="Bottom"
                                Click="AddPeriodButton_Click" />

                        <Button x:Name="DeletePeriodButton"
                                Grid.Column="10"
                                Content="Supprimer"
                                Style="{StaticResource DangerButton}"
                                ToolTip="Supprimer la période sélectionnée"
                                ToolTipService.ShowOnDisabled="True"
                                VerticalAlignment="Bottom"
                                Click="DeletePeriodButton_Click" />
                    </Grid>

                    <Grid Grid.Row="4" MinHeight="150" MaxHeight="220">
                        <DataGrid x:Name="PeriodsDataGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type de chambre" Binding="{Binding RoomTypeCode}" Width="150" />
                                <DataGridTextColumn Header="Du"
                                                    Binding="{Binding FromDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Au"
                                                    Binding="{Binding ToDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Nuitée"
                                                    Binding="{Binding NightlyAmount, StringFormat={}{0:N2}}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource AmountCellText}"
                                                    HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                <DataGridTextColumn Header="Créé par"
                                                    Binding="{Binding CreatedBy}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource MutedCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=PeriodsDataGrid}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- Pictogramme au trait (calendrier), meme gabarit que les etats
                                 vides des autres ecrans. -->
                            <Path Data="M2,3.5 H14 V14 H2 Z M2,6.5 H14 M5,1.5 V4.5 M11,1.5 V4.5 M5,9.5 H7 M9,9.5 H11 M5,12 H7"
                                  Stroke="{StaticResource BorderStrongBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  Width="44"
                                  Height="42"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10" />
                            <TextBlock Text="Aucune période de tarif"
                                       Style="{StaticResource EmptyStateTitleText}" />
                            <TextBlock Text="Sélectionnez un plan puis ajoutez une première période ci-dessus."
                                       Style="{StaticResource EmptyStateHintText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================= Conventions clients ======================== -->
            <Border Grid.Row="6" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Conventions clients" Style="{StaticResource SectionTitleText}" />

                    <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ConventionFormTitleTextBlock"
                                       Text="Nouvelle convention"
                                       Style="{StaticResource SectionTitleText}"
                                       FontSize="14"
                                       Margin="0,0,0,4" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Code client" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="ConventionCustomerTextBox" MaxLength="40" Tag="ex. C0001" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Plan tarifaire" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="ConventionPlanComboBox"
                                              ToolTip="Plan tarifaire appliqué par la convention">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} — {1}">
                                                            <Binding Path="Code" Mode="OneWay" />
                                                            <Binding Path="Label" Mode="OneWay" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Remise %" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="ConventionDiscountTextBox"
                                             Style="{StaticResource AmountTextBox}"
                                             Tag="Facultatif"
                                             ToolTip="Remise facultative en pourcentage, appliquée au tarif résolu" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Du" Style="{StaticResource LabelText}" />
                                    <DatePicker x:Name="ConventionFromDatePicker" />
                                </StackPanel>

                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Au" Style="{StaticResource LabelText}" />
                                    <DatePicker x:Name="ConventionToDatePicker" />
                                </StackPanel>

                                <Button x:Name="NewConventionButton"
                                        Grid.Column="10"
                                        Content="Nouvelle"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="Vider le formulaire pour créer une nouvelle convention"
                                        VerticalAlignment="Bottom"
                                        Click="NewConventionButton_Click" />

                                <Button x:Name="SaveConventionButton"
                                        Grid.Column="12"
                                        Content="Créer"
                                        Style="{StaticResource PrimaryButton}"
                                        ToolTip="Enregistrer la convention client"
                                        ToolTipService.ShowOnDisabled="True"
                                        VerticalAlignment="Bottom"
                                        Click="SaveConventionButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid MinHeight="150" MaxHeight="220">
                            <DataGrid x:Name="ConventionsDataGrid"
                                      SelectionChanged="ConventionsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client" Binding="{Binding CustomerCode}" Width="110" />
                                    <DataGridTextColumn Header="Nom"
                                                        Binding="{Binding CustomerName}"
                                                        Width="*"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Plan" Binding="{Binding RatePlanCode}" Width="110" />
                                    <DataGridTextColumn Header="Remise %"
                                                        Binding="{Binding DiscountPercent, StringFormat={}{0:N2}}"
                                                        Width="95"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Du"
                                                        Binding="{Binding FromDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                        Width="105" />
                                    <DataGridTextColumn Header="Au"
                                                        Binding="{Binding ToDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                        Width="105" />
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=ConventionsDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Pictogramme au trait (document et pourcentage), meme gabarit
                                     que les etats vides des autres ecrans. -->
                                <Path Data="M3,1.5 H10 L13,4.5 V14.5 H3 Z M10.2,7.8 L5.8,12.2 M5.1,8.4 A0.8,0.8 0 1 0 6.7,8.4 A0.8,0.8 0 1 0 5.1,8.4 M9.3,11.6 A0.8,0.8 0 1 0 10.9,11.6 A0.8,0.8 0 1 0 9.3,11.6"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="42"
                                      Height="44"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10" />
                                <TextBlock Text="Aucune convention client"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Créez une première convention ci-dessus ou cliquez sur Actualiser."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ActivateConventionButton"
                                    Content="Activer"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Réactiver la convention sélectionnée"
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="0,0,8,0"
                                    Click="ActivateConventionButton_Click" />
                            <Button x:Name="DeactivateConventionButton"
                                    Content="Désactiver"
                                    Style="{StaticResource DangerButton}"
                                    ToolTip="Désactiver la convention sélectionnée"
                                    ToolTipService.ShowOnDisabled="True"
                                    Click="DeactivateConventionButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== Tester la résolution d'un tarif =============== -->
            <Border Grid.Row="8" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tester la résolution d'un tarif" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Ce que coûterait une nuit pour une unité, un type de chambre et une date, convention client comprise. Lecture seule : rien n'est créé."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Unité hôtelière" Style="{StaticResource LabelText}" />
                            <ComboBox x:Name="ResolveUnitComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} — {1}">
                                                    <Binding Path="Code" Mode="OneWay" />
                                                    <Binding Path="Name" Mode="OneWay" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Type de chambre" Style="{StaticResource LabelText}" />
                            <TextBox x:Name="ResolveRoomTypeTextBox" MaxLength="40" Tag="ex. STD" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Nuit du" Style="{StaticResource LabelText}" />
                            <DatePicker x:Name="ResolveNightDatePicker" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Code client" Style="{StaticResource LabelText}" />
                            <TextBox x:Name="ResolveCustomerTextBox"
                                     MaxLength="40"
                                     Tag="Facultatif"
                                     ToolTip="Applique la convention active de ce client, si elle existe" />
                        </StackPanel>

                        <Button x:Name="ResolveTariffButton"
                                Grid.Column="8"
                                Content="Résoudre"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Calculer le tarif de la nuit sélectionnée"
                                VerticalAlignment="Bottom"
                                Click="ResolveTariffButton_Click" />
                    </Grid>

                    <TextBlock x:Name="ResolveResultTextBlock"
                               Grid.Row="4"
                               Text=""
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<Window x:Class="RaqmiSystem.Desktop.Views.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document"
        SizeToContent="Height"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <!-- Apercu MINIMAL d'un document recu du serveur : ce qu'il est (nom, taille, empreinte), et
         trois gestes - enregistrer sous, ouvrir, imprimer. Aucun moteur de rendu embarque : le
         PDF est confie au shell Windows (lecteur par defaut du poste), qui sait l'afficher et
         l'imprimer mieux que ce client ne le ferait. Le document n'est pas modifiable ici : ce
         qui a ete rendu par le serveur est ce qui s'imprime. -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Style="{StaticResource SectionTitleText}" />

        <TextBlock Grid.Row="2"
                   Text="Document légal rendu et archivé par le serveur. Il s'imprime tel quel et se réimprime à l'identique par son numéro."
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionText}" />

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Fichier" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="FileNameText" Grid.Column="2" Style="{StaticResource BodyText}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Text="Type" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="ContentTypeText" Grid.Row="2" Grid.Column="2" Style="{StaticResource BodyText}" />

                <TextBlock Grid.Row="4" Text="Taille" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="SizeText" Grid.Row="4" Grid.Column="2" Style="{StaticResource BodyText}" />

                <TextBlock Grid.Row="6" Text="SHA-256" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="Sha256Text"
                         Grid.Row="6"
                         Grid.Column="2"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TextBlock x:Name="IntegrityText"
                   Grid.Row="6"
                   TextWrapping="Wrap"
                   Style="{StaticResource BodyText}" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveAsButton"
                    Content="Enregistrer sous…"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="140"
                    Margin="0,0,10,0"
                    Click="SaveAsButton_Click" />
            <Button x:Name="OpenButton"
                    Content="Ouvrir"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    Click="OpenButton_Click" />
            <Button x:Name="PrintButton"
                    Content="Imprimer"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    MinWidth="110"
                    Margin="0,0,10,0"
                    Click="PrintButton_Click" />
            <Button Content="Fermer"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>

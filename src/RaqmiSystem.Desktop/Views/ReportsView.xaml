<UserControl x:Class="RaqmiSystem.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="720"
             FontFamily="{StaticResource AppFontFamily}">

    <!-- ============================================================================
         Rapports automatiques : catalogue defini en code cote serveur (gauche),
         resultat en grille dynamique (droite) et journal des executions (bas).
         Les colonnes de la grille sont construites depuis la reponse du serveur :
         une seule grille rend n'importe quel rapport du catalogue.
         ============================================================================ -->

    <UserControl.Resources>
        <!-- Liste du catalogue : gabarit local sobre, uniquement des brushes du
             theme (aucune couleur en dur), selection marquee par la teinte accent
             translucide comme les lignes de grille. -->
        <Style x:Key="CatalogListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="CatalogListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                                Background="Transparent"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentSelectionBrush}" />
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== En-tete du module ============================== -->
        <DockPanel>
            <StackPanel>
                <TextBlock Text="Rapports automatiques"
                           Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Rapports structurés exécutés à la demande, journal des sorties et export CSV — les exports PDF et Excel ne sont pas couverts"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="RefreshButton"
                        Content="Actualiser"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Recharger le catalogue, les unités et le journal des exécutions"
                        Click="RefreshButton_Click" />
            </StackPanel>
        </DockPanel>

        <!-- ============================== Corps de l'ecran ============================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ====================== Catalogue et parametres (gauche) ====================== -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Catalogue des rapports"
                               Style="{StaticResource SectionTitleText}" />

                    <ListBox x:Name="ReportsListBox"
                             Grid.Row="2"
                             Style="{StaticResource CatalogListBox}"
                             ItemContainerStyle="{StaticResource CatalogListBoxItem}"
                             SelectionChanged="ReportsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Parametres du rapport choisi : les champs sont construits par le
                         code-behind depuis la definition renvoyee par le serveur. -->
                    <Border Grid.Row="4" Style="{StaticResource SubtleCardBorder}" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="ParametersTitleTextBlock"
                                       Text="Paramètres"
                                       Style="{StaticResource SectionTitleText}"
                                       FontSize="14"
                                       Margin="0,0,0,8" />

                            <TextBlock x:Name="NoReportSelectedTextBlock"
                                       Text="Choisissez un rapport dans le catalogue pour renseigner ses paramètres."
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />

                            <StackPanel x:Name="ParametersPanel" />

                            <Button x:Name="RunReportButton"
                                    Content="Exécuter le rapport"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="Exécuter le rapport sélectionné avec les paramètres saisis"
                                    ToolTipService.ShowOnDisabled="True"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0"
                                    Click="RunReportButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================= Resultat et journal (droite) ========================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ================================ Resultat ================================ -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <StackPanel>
                                <TextBlock x:Name="ResultTitleTextBlock"
                                           Text="Résultat"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="ResultInfoTextBlock"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="ExportCsvButton"
                                        Content="Exporter en CSV"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Exporter le résultat affiché en CSV (valeurs machine, UTF-8)"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="ExportCsvButton_Click" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="ResultDataGrid">
                                <DataGrid.RowStyle>
                                    <!-- La ligne de total renvoyee par le serveur est mise en
                                         evidence : graisse SemiBold et fond subtil du theme. -->
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <!-- Etat vide : superpose a la grille tant qu'aucun rapport n'a ete execute. -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=ResultDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource ModuleGroupIcon.Pilotage}"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="46"
                                      Height="42"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10" />
                                <TextBlock Text="Aucun résultat à afficher"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Choisissez un rapport dans le catalogue puis lancez l'exécution."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================= Journal des executions ========================= -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" MaxHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="Historique des exécutions"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock x:Name="ExecutionCountTextBlock"
                                       DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}" />
                        </DockPanel>

                        <Grid Grid.Row="2" MinHeight="120">
                            <DataGrid x:Name="ExecutionsDataGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date/heure"
                                                        Binding="{Binding ExecutedAtLabel}"
                                                        Width="140" />
                                    <DataGridTextColumn Header="Rapport"
                                                        Binding="{Binding ReportTitle}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Auteur"
                                                        Binding="{Binding ExecutedBy}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="Paramètres"
                                                        Binding="{Binding ParametersLabel}"
                                                        Width="240"
                                                        ElementStyle="{StaticResource MutedCellText}" />
                                    <DataGridTextColumn Header="Lignes"
                                                        Binding="{Binding RowCountLabel}"
                                                        Width="90"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                    <DataGridTextColumn Header="Durée (ms)"
                                                        Binding="{Binding DurationLabel}"
                                                        Width="100"
                                                        ElementStyle="{StaticResource AmountCellText}"
                                                        HeaderStyle="{StaticResource RightAlignedColumnHeader}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Etat vide du journal. -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=ExecutionsDataGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource ModuleGroupIcon.Controle}"
                                      Stroke="{StaticResource BorderStrongBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Width="40"
                                      Height="36"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,8" />
                                <TextBlock Text="Aucune exécution enregistrée"
                                           Style="{StaticResource EmptyStateTitleText}" />
                                <TextBlock Text="Chaque exécution de rapport sera tracée ici : rapport, auteur, paramètres et volume."
                                           Style="{StaticResource EmptyStateHintText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

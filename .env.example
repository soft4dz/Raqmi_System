ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL central server
RAQMI_POSTGRES__HOST=localhost
RAQMI_POSTGRES__PORT=5432
RAQMI_POSTGRES__DATABASE=raqmi_system

# The account the API itself connects as. For local development this can be
# a full-rights account (see docs/postgresql.md). For docker-compose.prod.yml
# this MUST be the least-privilege `raqmi_app` role created by
# deploy/postgres/create-app-role.sql - never the admin account below.
RAQMI_POSTGRES__USER=raqmi
RAQMI_POSTGRES__PASSWORD=change-me

# Used only by docker-compose.prod.yml, to bootstrap the postgres container
# and to run EF Core migrations / create-app-role.sql. Never read by the API
# itself (see docs/deployment.md, "Dedicated PostgreSQL application role").
# Not needed for plain local `dotnet run` against docker-compose.yml.
RAQMI_POSTGRES_ADMIN_USER=raqmi_admin
RAQMI_POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-value

# JWT signing key.
# Production must use a long random value stored outside Git.
RAQMI_JWT__ISSUER=RaqmiSystem
RAQMI_JWT__AUDIENCE=RaqmiSystem.Client
RAQMI_JWT__SIGNINGKEY=replace-with-a-random-secret-of-at-least-32-bytes
RAQMI_JWT__ACCESSTOKENMINUTES=60

# Optional first administrator used by the security seed command.
# Do not commit real credentials.
RAQMI_INITIAL_ADMIN_EMAIL=admin@example.local
RAQMI_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
